+/* Big-endian PowerPC AltiVec/VMX (G4, G5, e6500; no VSX): 8-bit 8-tap MC and avg (src/ppc/mc_altivec_tmpl.c). */
+
+#ifndef DAV1D_SRC_PPC_MC_ALTIVEC_H
+#define DAV1D_SRC_PPC_MC_ALTIVEC_H
+
+#include "src/cpu.h"
+#include "src/mc.h"
+
+#define decl_altivec_fns(name)                          \
+    decl_mc_fn(BF(dav1d_put_8tap_##name, altivec));     \
+    decl_mct_fn(BF(dav1d_prep_8tap_##name, altivec))
+
+decl_altivec_fns(regular);
+decl_altivec_fns(regular_sharp);
+decl_altivec_fns(regular_smooth);
+decl_altivec_fns(smooth);
+decl_altivec_fns(smooth_regular);
+decl_altivec_fns(smooth_sharp);
+decl_altivec_fns(sharp);
+decl_altivec_fns(sharp_regular);
+decl_altivec_fns(sharp_smooth);
+decl_avg_fn(BF(dav1d_avg, altivec));
+
+static ALWAYS_INLINE void mc_dsp_init_ppc_altivec(Dav1dMCDSPContext *const c) {
+#if BITDEPTH == 8
+    if (!(dav1d_get_cpu_flags() & DAV1D_PPC_CPU_FLAG_ALTIVEC)) return;
+
+#define init_altivec(type, name)                                \
+    c->mc [type] = BF(dav1d_put_8tap_##name, altivec);          \
+    c->mct[type] = BF(dav1d_prep_8tap_##name, altivec)
+
+    init_altivec(FILTER_2D_8TAP_REGULAR,        regular);
+    init_altivec(FILTER_2D_8TAP_REGULAR_SMOOTH, regular_smooth);
+    init_altivec(FILTER_2D_8TAP_REGULAR_SHARP,  regular_sharp);
+    init_altivec(FILTER_2D_8TAP_SHARP_REGULAR,  sharp_regular);
+    init_altivec(FILTER_2D_8TAP_SHARP_SMOOTH,   sharp_smooth);
+    init_altivec(FILTER_2D_8TAP_SHARP,          sharp);
+    init_altivec(FILTER_2D_8TAP_SMOOTH_REGULAR, smooth_regular);
+    init_altivec(FILTER_2D_8TAP_SMOOTH,         smooth);
+    init_altivec(FILTER_2D_8TAP_SMOOTH_SHARP,   smooth_sharp);
+#undef init_altivec
+    c->avg = BF(dav1d_avg, altivec);
+#endif
+}
