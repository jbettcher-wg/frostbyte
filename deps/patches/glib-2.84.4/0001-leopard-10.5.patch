@@ -77,6 +77,12 @@
 #include "gioerror.h"
 #include "glibintl.h"
 
+#ifndef O_CLOEXEC
+/* Mac OS X 10.5 has no O_CLOEXEC; this file only passes it to
+ * g_unix_open_pipe(), which accepts FD_CLOEXEC and applies it via fcntl(). */
+#define O_CLOEXEC FD_CLOEXEC
+#endif
+
 /* Linux defines loff_t as a way to simplify the offset types for calls like
  * splice() and copy_file_range(). BSD has copy_file_range() but doesn’t define
  * loff_t. Abstract that. */
diff -ruN pristine/glib-2.84.4/gio/gsocket.c src/glib-2.84.4/gio/gsocket.c
--- a/gio/gsocket.c	2025-08-08 10:43:22.000000000 -0600
+++ b/gio/gsocket.c	2026-11-08 16:14:22.499664514 -0600
@@ -4863,9 +4863,26 @@
         cmsg = CMSG_NXTHDR (_msg, cmsg); \
       } \
     g_assert (cmsg == NULL); \
+    /* Leopard (Mac OS X 10.5) ppc64: the SDK aligns cmsgs to 8 bytes (CMSG_SPACE(4) = 24, \
+     * CMSG_LEN(4) = 20) but xnu's SCM_RIGHTS code requires cmsg_len == msg_controllen, so the \
+     * trailing alignment padding makes sendmsg() fail with EINVAL. Drop that padding. */ \
+    G_SOCKET_TRIM_LAST_CMSG_PADDING (_message, _msg); \
   } \
 } G_STMT_END
 
+#ifdef __APPLE__
+#define G_SOCKET_TRIM_LAST_CMSG_PADDING(message, msg) \
+  G_STMT_START { \
+    if ((message)->num_control_messages > 0) \
+      { \
+        gsize _last = g_socket_control_message_get_size ((message)->control_messages[(message)->num_control_messages - 1]); \
+        (msg)->msg_controllen -= CMSG_SPACE (_last) - CMSG_LEN (_last); \
+      } \
+  } G_STMT_END
+#else
+#define G_SOCKET_TRIM_LAST_CMSG_PADDING(message, msg) G_STMT_START { } G_STMT_END
+#endif
+
 #define input_message_to_msghdr(message, msg) \
 G_STMT_START { \
   const GInputMessage  *_message = (message); \
@@ -6321,6 +6338,9 @@
       }
   }
 #elif G_CREDENTIALS_USE_APPLE_XUCRED
+#ifndef SOL_LOCAL
+#define SOL_LOCAL 0  /* Mac OS X 10.5 SDK lacks it; later <sys/un.h> defines 0 */
+#endif
   {
     struct xucred cred;
     socklen_t optlen = sizeof (cred);
