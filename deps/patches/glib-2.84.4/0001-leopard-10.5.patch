@@ -52,6 +52,9 @@
 #endif
 
 #include <stdlib.h>
+#ifdef __APPLE__
+#include <unistd.h>
+#endif
 #include <string.h>
 #include <signal.h>
 
@@ -681,6 +684,16 @@
   res = aligned_alloc (alignment, real_size);
 #elif defined(HAVE_MEMALIGN)
   res = memalign (alignment, real_size);
+#elif defined(__APPLE__)
+  /* Mac OS X 10.5 has no posix_memalign(). malloc() is 16-byte aligned and
+   * valloc() page-aligned; free() releases both. */
+  if (alignment <= 16)
+    res = malloc (real_size);
+  else if (alignment <= (gsize) getpagesize ())
+    res = valloc (real_size);
+  else
+    g_error ("%s: alignment %"G_GSIZE_FORMAT" exceeds the page size",
+             G_STRLOC, alignment);
 #else
 # error "This platform does not have an aligned memory allocator."
 #endif
