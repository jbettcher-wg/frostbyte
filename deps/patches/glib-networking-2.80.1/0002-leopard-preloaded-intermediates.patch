+/* Leopard/FrostByte: the server did not send (all of) its intermediates. Complete the presented
+ * chain from the preloaded intermediates and verify again against the session's own trust list,
+ * with the same hostname and TLS server key purpose. Returns the new status, or the original one if
+ * the chain could not be completed. (Stapled OCSP is not re-checked on this path.) */
+static unsigned int
+leopard_verify_with_preloaded (gnutls_session_t session, const char *hostname, unsigned int status)
+{
+  const gnutls_datum_t *raw;
+  unsigned int n_raw = 0, i, new_status = status;
+  gnutls_x509_crt_t *certs;
+  guint length = 0;
+  gnutls_certificate_credentials_t credentials = NULL;
+  gnutls_x509_trust_list_t trust_list = NULL;
+  gnutls_typed_vdata_st data[2];
+  unsigned int n_data = 0;
+
+  raw = gnutls_certificate_get_peers (session, &n_raw);
+  if (!raw || !n_raw ||
+      gnutls_credentials_get (session, GNUTLS_CRD_CERTIFICATE, (void **) &credentials) < 0 || !credentials)
+    return status;
+  gnutls_certificate_get_trust_list (credentials, &trust_list);
+  if (!trust_list)
+    return status;
+
+  certs = g_new0 (gnutls_x509_crt_t, n_raw);
+  for (i = 0; i < n_raw; i++)
+    {
+      if (gnutls_x509_crt_init (&certs[length]) < 0)
+        break;
+      if (gnutls_x509_crt_import (certs[length], &raw[i], GNUTLS_X509_FMT_DER) < 0)
+        {
+          gnutls_x509_crt_deinit (certs[length]);
+          break;
+        }
+      length++;
+    }
+
+  if (length == n_raw && g_tls_leopard_complete_chain (&certs, &length) > 0)
+    {
+      if (hostname)
+        {
+          data[n_data].type = GNUTLS_DT_DNS_HOSTNAME;
+          data[n_data].data = (void *) hostname;
+          data[n_data].size = 0;
+          n_data++;
+        }
+      data[n_data].type = GNUTLS_DT_KEY_PURPOSE_OID;
+      data[n_data].data = (void *) GNUTLS_KP_TLS_WWW_SERVER;
+      data[n_data].size = 0;
+      n_data++;
+      if (gnutls_x509_trust_list_verify_crt2 (trust_list, certs, length, data, n_data, 0, &new_status, NULL) < 0)
+        new_status = status;
+      if (g_getenv ("LEOPARD_TLS_DEBUG"))
+        g_printerr ("leopard-tls: %s: completed chain of %u, status 0x%x -> 0x%x\n",
+                    hostname ? hostname : "?", length, status, new_status);
+    }
+
+  for (i = 0; i < n_raw && i < length; i++)   /* only the ones we imported */
+    gnutls_x509_crt_deinit (certs[i]);
+  g_free (certs);
+  return new_status;
+}
