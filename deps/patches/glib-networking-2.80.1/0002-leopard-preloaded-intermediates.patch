+/*
+ * Intermediate preloading (Leopard/FrostByte, as Firefox does): many servers send only their leaf
+ * certificate and rely on browsers to know the intermediate. When GnuTLS cannot find an issuer,
+ * complete the presented chain from a bundled list of public intermediates (Mozilla CCADB:
+ * non-revoked intermediates chaining to Mozilla roots) and verify again. The roots are unchanged:
+ * the completed chain must still verify, signature by signature, to a trust anchor.
+ * File: $LEOPARD_TLS_INTERMEDIATES, else LEOPARD_TLS_INTERMEDIATES_FILE (set at build time).
+ */
+#define LEOPARD_STR_(x) #x
+#define LEOPARD_STR(x) LEOPARD_STR_(x)
+#if defined(LEOPARD_TLS_INTERMEDIATES_DIR)   /* -DLEOPARD_TLS_INTERMEDIATES_DIR=/opt/wpe/etc/ssl */
+#define LEOPARD_TLS_INTERMEDIATES_FILE LEOPARD_STR(LEOPARD_TLS_INTERMEDIATES_DIR) "/intermediates.pem"
+#else
+#define LEOPARD_TLS_INTERMEDIATES_FILE NULL
+#endif
+
+static gnutls_x509_crt_t *preloaded_intermediates;
+static unsigned int n_preloaded_intermediates;
+
+static gpointer
+load_preloaded_intermediates (gpointer data)
+{
+  const gchar *path = g_getenv ("LEOPARD_TLS_INTERMEDIATES");
+  gchar *contents = NULL;
+  gsize length = 0;
+  gnutls_datum_t datum;
+
+  (void) data;
+  if (!path)
+    path = LEOPARD_TLS_INTERMEDIATES_FILE;
+  if (!path || !g_file_get_contents (path, &contents, &length, NULL))
+    return NULL;
+  datum.data = (unsigned char *) contents;
+  datum.size = length;
+  if (gnutls_x509_crt_list_import2 (&preloaded_intermediates, &n_preloaded_intermediates, &datum,
+                                    GNUTLS_X509_FMT_PEM, 0) < 0)
+    {
+      preloaded_intermediates = NULL;
+      n_preloaded_intermediates = 0;
+    }
+  g_free (contents);
+  if (g_getenv ("LEOPARD_TLS_DEBUG"))
+    g_printerr ("leopard-tls: %u preloaded intermediates from %s\n", n_preloaded_intermediates, path);
+  return NULL;
+}
+
+/* Is candidate the issuer of cert? Subject DN must match; key identifiers too when both exist. */
+static gboolean
+preloaded_issues (gnutls_x509_crt_t cert, gnutls_x509_crt_t candidate)
+{
+  unsigned char akid[64], skid[64];
+  size_t akid_size = sizeof akid, skid_size = sizeof skid;
+  unsigned int critical;
+
+  if (!gnutls_x509_crt_check_issuer (cert, candidate))
+    return FALSE;
+  if (gnutls_x509_crt_get_authority_key_id (cert, akid, &akid_size, &critical) >= 0 &&
+      gnutls_x509_crt_get_subject_key_id (candidate, skid, &skid_size, &critical) >= 0)
+    return akid_size == skid_size && memcmp (akid, skid, akid_size) == 0;
+  return TRUE;
+}
+
+/* Appends up to four preloaded issuers to *certs (g_malloc'd, *length entries; reallocated).
+ * The appended certificates belong to the preloaded list: callers must not deinit them.
+ * Returns how many were added. */
+guint
+g_tls_leopard_complete_chain (gnutls_x509_crt_t **certs, guint *length)
+{
+  static GOnce once = G_ONCE_INIT;
+  guint added = 0;
+
+  g_once (&once, load_preloaded_intermediates, NULL);
+  if (!n_preloaded_intermediates || !*length)
+    return 0;
+
+  while (added < 4)
+    {
+      gnutls_x509_crt_t last = (*certs)[*length - 1];
+      gnutls_x509_crt_t found = NULL;
+      unsigned int i;
+
+      if (gnutls_x509_crt_check_issuer (last, last))
+        break;                                   /* self-issued: nothing above it */
+      for (i = 0; i < n_preloaded_intermediates && !found; i++)
+        if (preloaded_issues (last, preloaded_intermediates[i]))
+          found = preloaded_intermediates[i];
+      if (!found)
+        break;
+      *certs = g_renew (gnutls_x509_crt_t, *certs, *length + 1);
+      (*certs)[(*length)++] = found;
+      added++;
+      if (g_getenv ("LEOPARD_TLS_DEBUG"))
+        {
+          gnutls_datum_t dn = { NULL, 0 };
+          gnutls_x509_crt_get_dn3 (found, &dn, 0);
+          g_printerr ("leopard-tls: appended %s\n", dn.data ? (const char *) dn.data : "?");
+          gnutls_free (dn.data);
+        }
+    }
+  return added;
+}
