 	&& DECL_VINDEX (fn) && !DECL_MAYBE_IN_CHARGE_DESTRUCTOR_P (fn)
-	&& TREE_CODE (DECL_VINDEX (fn)) != INTEGER_CST)
+	&& TREE_CODE (DECL_VINDEX (fn)) != INTEGER_CST
+	/* In the Apple kext ABI a virtual destructor gets one vtable slot,
+	   not the Itanium ABI's complete/deleting pair.  The slot holds the
+	   deleting destructor, so it is the complete-object clone that is
+	   left out here; finish_struct_1 then aims its DECL_VINDEX at the
+	   surviving slot.  build_cdtor_clones still builds all three
+	   clones, so a direct call to any of them is unchanged.  */
+	&& !(DECL_COMPLETE_DESTRUCTOR_P (fn)
+	     && targetm.cxx.kext_vtable_abi_p (t)))
       {
 	tree new_virtual = make_node (TREE_LIST);
 
@@ -8002,6 +8010,35 @@
 	  else if (TREE_CODE (DECL_VINDEX (fndecl)) != INTEGER_CST)
 	    DECL_VINDEX (fndecl) = build_int_cst (NULL_TREE, vindex);
 	}
+
+      /* In the Apple kext ABI the complete-object destructor has no vtable
+	 slot of its own, so the loop above never reached it and it is still
+	 carrying check_for_override's non-INTEGER_CST marker.  Anything that
+	 builds a virtual call to it -- `p->~T()' on a polymorphic p -- would
+	 then index the vtable with that marker.  Point it at the one
+	 destructor slot, which holds the deleting destructor.  That is
+	 Apple's semantics, not an approximation of them: in this ABI a
+	 virtual complete-object destruction deletes, which is why
+	 -fapple-kext objects may not live on the stack or in static storage
+	 unless `operator delete' is empty (see darwin_handle_kext_attribute).
+	 A *direct*, non-virtual call still reaches the complete-object
+	 destructor and still does not delete, so the module's static
+	 destructor list is unaffected.  */
+      if (targetm.cxx.kext_vtable_abi_p (t))
+	{
+	  tree comp_dtor = NULL_TREE, del_dtor = NULL_TREE;
+	  for (fn = TYPE_FIELDS (t); fn; fn = DECL_CHAIN (fn))
+	    if (TREE_CODE (fn) == FUNCTION_DECL && DECL_DESTRUCTOR_P (fn))
+	      {
+		if (DECL_COMPLETE_DESTRUCTOR_P (fn))
+		  comp_dtor = fn;
+		else if (DECL_DELETING_DESTRUCTOR_P (fn))
+		  del_dtor = fn;
+	      }
+	  if (comp_dtor && del_dtor && DECL_VINDEX (del_dtor)
+	      && TREE_CODE (DECL_VINDEX (del_dtor)) == INTEGER_CST)
+	    DECL_VINDEX (comp_dtor) = DECL_VINDEX (del_dtor);
+	}
     }
 
   finish_struct_bits (t);
@@ -10574,9 +10611,32 @@
 		 an object under construction is undefined behavior and we
 		 don't want it to be considered a candidate for speculative
 		 devirtualization.  But do create the thunk for ABI
-		 compliance.  */
