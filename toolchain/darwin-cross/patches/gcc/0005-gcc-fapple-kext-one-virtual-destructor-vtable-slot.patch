 	    }
--- a/gcc/doc/tm.texi
+++ b/gcc/doc/tm.texi
@@ -11202,6 +11202,17 @@
 @code{false}.
 @end deftypefn
 
+@deftypefn {Target Hook} bool TARGET_CXX_KEXT_VTABLE_ABI_P (tree @var{type})
+This hook should return @code{true} if the virtual table of the C++ class
+@var{type} follows the Apple @code{kext} C++ ABI, as selected by
+@option{-fapple-kext}.  In that ABI a polymorphic class with a virtual
+destructor gets a single virtual table slot for it, holding the deleting
+destructor, instead of the Itanium C++ ABI's pair of complete-object and
+deleting destructor slots.  It is asked per class because the ABI applies
+only to a designated class hierarchy, not to every class in the translation
+unit.  The default is to return @code{false}.
+@end deftypefn
+
 @deftypefn {Target Hook} bool TARGET_CXX_KEY_METHOD_MAY_BE_INLINE (void)
 This hook returns true if the key method for a class (i.e., the method
 which, if defined in the current translation unit, causes the virtual
--- a/gcc/doc/tm.texi.in
+++ b/gcc/doc/tm.texi.in
@@ -7230,6 +7230,8 @@
 
 @hook TARGET_CXX_CDTOR_RETURNS_THIS
 
+@hook TARGET_CXX_KEXT_VTABLE_ABI_P
+
 @hook TARGET_CXX_KEY_METHOD_MAY_BE_INLINE
 
 @hook TARGET_CXX_DETERMINE_CLASS_DATA_VISIBILITY
--- a/gcc/target.def
+++ b/gcc/target.def
@@ -6602,6 +6602,22 @@
  bool, (void),
  hook_bool_void_false)
 
+/* Returns true if TYPE's virtual table follows the Apple kext C++ ABI, in
+   which a polymorphic class gets a single virtual destructor slot holding
+   the deleting destructor, rather than the Itanium ABI's pair.  */
+DEFHOOK
+(kext_vtable_abi_p,
+ "This hook should return @code{true} if the virtual table of the C++ class\n\
+@var{type} follows the Apple @code{kext} C++ ABI, as selected by\n\
+@option{-fapple-kext}.  In that ABI a polymorphic class with a virtual\n\
+destructor gets a single virtual table slot for it, holding the deleting\n\
+destructor, instead of the Itanium C++ ABI's pair of complete-object and\n\
+deleting destructor slots.  It is asked per class because the ABI applies\n\
+only to a designated class hierarchy, not to every class in the translation\n\
+unit.  The default is to return @code{false}.",
+ bool, (tree type),
+ hook_bool_tree_false)
+
 /* Returns true if the key method for a class can be an inline
    function, so long as it is not declared inline in the class
    itself.  Returning true is the behavior required by the Itanium C++ ABI.  */
