+		 10.5.8 ppc mach_kernel has none out of 204, and carries the
+		 real __ZN15OSMetaClassBaseD0Ev pointer in the slot of a
+		 class that is abstract.
+
+		 Construction vtables are still nulled: that half is about
+		 objects under construction rather than about layout, and it
+		 needs virtual bases, which this ABI does not have.  */
 	      if (DECL_DESTRUCTOR_P (fn_original)
-		  && (CLASSTYPE_PURE_VIRTUALS (DECL_CONTEXT (fn_original))
+		  && ((CLASSTYPE_PURE_VIRTUALS (DECL_CONTEXT (fn_original))
+		       && !targetm.cxx.kext_vtable_abi_p
+			     (DECL_CONTEXT (fn_original)))
 		      || orig_binfo != binfo))
