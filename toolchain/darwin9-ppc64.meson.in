# meson --cross-file for ppc64 Mac OS X 10.5 (@TARGET@). Generated by toolchain/wpe-env.sh from
# toolchain/darwin9-ppc64.meson.in; flags come from the environment.
[binaries]
c = ['@TOOLCHAIN@/bin/powerpc-apple-darwin9-gcc', '-m64', @CPUFLAGS@]
cpp = ['@TOOLCHAIN@/bin/powerpc-apple-darwin9-g++', '-m64', @CPUFLAGS@]
objc = ['@TOOLCHAIN@/bin/powerpc-apple-darwin9-gcc', '-m64', @CPUFLAGS@]
ar = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-ar'
strip = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-strip'
ranlib = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-ranlib'
nm = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-nm'
otool = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-otool'
install_name_tool = '@TOOLCHAIN@/bin/powerpc-apple-darwin9-install_name_tool'
pkg-config = 'pkg-config'

[host_machine]
system = 'darwin'
subsystem = 'macos'
kernel = 'xnu'
cpu_family = 'ppc64'
cpu = '@CPU@'
endian = 'big'

[properties]
needs_exe_wrapper = true
