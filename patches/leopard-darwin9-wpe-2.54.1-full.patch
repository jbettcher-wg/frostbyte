+    void sub32(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        m_assembler.subf(dest, b, a);
+        maskLow32(dest);
+    }
+
+    void sub32(TrustedImm32 imm, RegisterID dest) { sub32(dest, imm, dest); }
+
+    void sub32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        // Subtracting v is adding -v; negating first keeps this on the cheap
+        // addi path. INT32_MIN has no negation inside 32 bits, but the
+        // arithmetic here is done in 64 bits where -(int64_t)INT32_MIN is
+        // representable, and the mask afterwards discards the difference.
+        addImmediate64(src, -static_cast<int64_t>(imm.m_value), dest);
+        maskLow32(dest);
+    }
