+    // ---- bit counting ----
+
+    void countLeadingZeros32(RegisterID src, RegisterID dest) { m_assembler.cntlzw(dest, src); }
+    void countLeadingZeros64(RegisterID src, RegisterID dest) { m_assembler.cntlzd(dest, src); }
+
+    // cnttzw/cnttzd are ISA 3.0, so POWER8 gets the identity instead:
+    //
+    //     ctz(x) == popcount(~x & (x - 1))
+    //
+    // which is also correct for x == 0 -- x - 1 is all ones and ~x is all
+    // ones, so the mask is all ones and the count is the full width, exactly
+    // what cnttzw/cnttzd return for zero.
+    //
+    // These USED to RELEASE_ASSERT(hasISA30()) rather than fall back, and that
+    // was a POWER8 crash rather than a missing optimisation. The callers are
+    // not obscure: i32.ctz and i64.ctz in both wasm JITs, and YarrJIT, which
+    // means ordinary JavaScript regexps. A baseline-pool build would have
+    // aborted on the first one.
+    //
+    // The temp is needed for two reasons, not one: dest may alias src, and
+    // addi's RA field has to hold the source -- r0 there reads as the literal
+    // zero. src comes from the register allocator, which never hands out r0.
+    void countTrailingZeros32(RegisterID src, RegisterID dest)
+    {
+        if (Assembler::hasISA30()) {
+            m_assembler.cnttzw(dest, src);
+            return;
+        }
+        ASSERT(src != PPC64Registers::r0);
+        auto temp = temps<Data>();
+        m_assembler.addi(temp.data(), src, -1);
+        m_assembler.andc(temp.data(), temp.data(), src);
+#if !LEOPARD_PPC64_ISA206
+        // PowerPC 970: no popcount. The mask is a contiguous run of low ones
+        // (all 32 for a zero source), so its length is 32 - cntlzw(mask);
+        // cntlzw reads only the low word, and the result is 0..32.
+        m_assembler.cntlzw(dest, temp.data());
+        m_assembler.subfic(dest, dest, 32);
+#else
+        // popcntw counts EACH WORD separately, so the high word holds the
+        // count of the temp's high word and has to be masked off.
+        m_assembler.popcntw(dest, temp.data());
+        maskLow32(dest);
+#endif
+    }
+
+    void countTrailingZeros64(RegisterID src, RegisterID dest)
+    {
+        if (Assembler::hasISA30()) {
+            m_assembler.cnttzd(dest, src);
+            return;
+        }
+        ASSERT(src != PPC64Registers::r0);
+        auto temp = temps<Data>();
+        m_assembler.addi(temp.data(), src, -1);
+        m_assembler.andc(temp.data(), temp.data(), src);
+#if !LEOPARD_PPC64_ISA206
+        // PowerPC 970: 64 - cntlzd(mask), as in countTrailingZeros32.
+        m_assembler.cntlzd(dest, temp.data());
+        m_assembler.subfic(dest, dest, 64);
+#else
+        // popcntd counts the whole doubleword, so no mask.
+        m_assembler.popcntd(dest, temp.data());
+#endif
+    }
+
+    // ---- byte swaps ----
+    //
+    // There is no register-to-register byte-reverse before POWER10's brh/brw/
+    // brd, so these are done with rotate-and-mask inserts, which is what gcc
+    // and clang emit for __builtin_bswap on POWER9.
+
+    void byteSwap16(RegisterID reg)
+    {
+        auto temp = temps<Data>();
+        // result = (reg >> 8 & 0xff) | (reg << 8 & 0xff00), zero-extended.
+        m_assembler.rlwinm(temp.data(), reg, 8, 16, 23);  // byte 0 -> byte 1
+        m_assembler.rlwinm(reg, reg, 24, 24, 31);         // byte 1 -> byte 0
+        m_assembler.or_(reg, reg, temp.data());
+        m_assembler.clrldi(reg, reg, 48);
+    }
+
+    void byteSwap32(RegisterID reg)
+    {
+        auto temp = temps<Data>();
+        // rotate left 8 gives bytes 2,1,0,3 in the low word; inserting the
+        // rotate-left-24 value into byte positions 0 and 2 completes the
+        // reversal. This is the classic PowerPC four-instruction bswap.
+        m_assembler.rlwinm(temp.data(), reg, 8, 0, 31);   // rotate left 8
+        m_assembler.rlwimi(temp.data(), reg, 24, 0, 7);   // insert byte
+        m_assembler.rlwimi(temp.data(), reg, 24, 16, 23); // insert byte
+        m_assembler.mr(reg, temp.data());
+        maskLow32(reg);
+    }
+
+    void byteSwap64(RegisterID reg)
+    {
+        // Reverse each 32-bit half, then swap the halves.
+        auto temp = temps<Data, Memory>();
+        m_assembler.srdi(temp.memory(), reg, 32); // high word
+        byteSwap32(reg);                          // low word reversed (uses data temp)
+        byteSwap32(temp.memory());                // high word reversed
+        m_assembler.sldi(reg, reg, 32);
+        m_assembler.or_(reg, reg, temp.memory());
+    }
+
+    // ---- byte-reversed memory access ----
+    //
+    // WebAssembly linear memory is little-endian on every host; this target
+    // is big-endian. lhbrx/lwbrx/ldbrx and their stores are X-form with
+    // EA = (RA|0) + RB, so the whole address goes into one register and RA is
+    // r0, the literal zero. All three loads zero-extend, which is also the
+    // port's 32-bit invariant.
+    template<typename AddressType>
+    RegisterID byteReversedAddress(AddressType address, RegisterID scratch)
+    {
+        auto resolution = resolveAddress(address, scratch, false);
+        return foldOffsetIntoAddressRegister(resolution, scratch);
+    }
+
+    // The X-form operand pair (RA, RB) for a byte-reversed access. A zero-offset
+    // address uses its base as RA directly ((RA|0) is only the literal zero for r0,
+    // which is never a base register), so base + (index << scale) costs one sldi
+    // instead of sldi + add. Anything else falls back to one folded register in RB.
+    struct XFormAddress {
+        RegisterID ra;
+        RegisterID rb;
+    };
+
+    template<typename AddressType>
+    XFormAddress byteReversedXForm(AddressType address, RegisterID scratch)
+    {
+        return { PPC64Registers::r0, byteReversedAddress(address, scratch) };
+    }
+
+    XFormAddress byteReversedXForm(Address address, RegisterID scratch)
+    {
+        if (!address.offset && address.base != PPC64Registers::r0)
+            return { PPC64Registers::r0, address.base };
+        return { PPC64Registers::r0, byteReversedAddress(address, scratch) };
+    }
+
+    XFormAddress byteReversedXForm(BaseIndex address, RegisterID scratch)
+    {
+        if (!address.offset && address.base != PPC64Registers::r0 && scratch != address.base && scratch != address.index) {
+            if (address.scale == TimesOne)
+                return { address.base, address.index };
+            m_assembler.sldi(scratch, address.index, static_cast<uint32_t>(address.scale));
+            return { address.base, scratch };
+        }
+        return { PPC64Registers::r0, byteReversedAddress(address, scratch) };
+    }
+
+    template<typename AddressType>
+    void load16ByteReversed(AddressType address, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        auto x = byteReversedXForm(address, temp.memory());
+        m_assembler.lhbrx(dest, x.ra, x.rb);
+    }
+
+    template<typename AddressType>
+    void load16SignedExtendTo32ByteReversed(AddressType address, RegisterID dest)
+    {
+        load16ByteReversed(address, dest);
