+    //
+    // The `sync` sits OUTSIDE the reservation window deliberately -- gcc's
+    // and the kernel's placement, not clang's. The window from larx to stcx.
+    // holds one compare and one branch and nothing else, because while it is
+    // open any store from any other thread anywhere in the 128-byte
+    // reservation granule fails the stcx. and costs the caller another lap,
+    // with the sync paid again.
+    //
+    // See powerpc64le-handbook jsc-ppc64le-atomics-cas.md.
+    // ==================================================================
+
+#if !LEOPARD_PPC64_ISA206
+    // ---- PowerPC 970: no lbarx/lharx/stbcx./sthcx., no popcount ----
+    //
+    // Byte and halfword reservations are built on the aligned word holding
+    // them, the way gcc compiles __atomic_* on the 970. loadAndReserve takes
+    // the reservation with lwarx and extracts the field; storeConditional
+    // re-reads the reserved word (a plain load leaves the reservation
+    // standing), merges the new field in and stwcx.'s the whole word. Any
+    // store to the word since the lwarx -- the only way the re-read can
+    // differ from what lwarx saw -- has already cost the reservation, so the
+    // stwcx. fails and the caller's loop retries, exactly as with stbcx.
+    //
+    // These run where the macro scratch registers are either the callers'
+    // live operands (emitAtomicRMW, the CAS helpers) or off limits (Air's
+    // loadLink/storeCond), so they use r0 plus GPRs parked in the red zone,
+    // below the e6500 transfer slots (-8..-32) and within the 288 bytes the
+    // Darwin ppc64 ABI keeps from signal delivery. Parking is a store to the
+    // stack, never to the reservation granule of a typed-array or wasm
+    // memory word, so the reservation survives it.
+    static constexpr int classicSpillSlot0 = -64;
+    static constexpr int classicSpillSlot1 = -72;
+
+    static RegisterID classicHelper(RegisterID a, RegisterID b, RegisterID c = InvalidGPRReg)
+    {
+        for (RegisterID r : { PPC64Registers::r28, PPC64Registers::r27, PPC64Registers::r26 }) {
+            if (r != a && r != b && r != c)
+                return r;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return InvalidGPRReg;
+    }
+
+    // shift = the right-shift that brings the field at `address` to the low
+    // end of its big-endian word: 24 - 8 * (address & 3), or 16 - 8 * (address & 2).
+    template<unsigned bitSize>
+    void classicFieldShift(RegisterID shift, RegisterID address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16);
+        m_assembler.rlwinm(shift, address, 3, 27, bitSize == 8 ? 28 : 27);
+        m_assembler.xori(shift, shift, bitSize == 8 ? 24 : 16);
+    }
+
+    template<unsigned bitSize>
+    void classicLoadAndReserve(RegisterID dest, RegisterID address)
+    {
+        RegisterID shift = classicHelper(dest, address);
+        m_assembler.std(shift, PPC64Registers::r1, classicSpillSlot0);
+        classicFieldShift<bitSize>(shift, address);
+        m_assembler.rldicr(PPC64Registers::r0, address, 0, 61);
+        m_assembler.lwarx(dest, PPC64Registers::r0, PPC64Registers::r0);
+        m_assembler.srw(dest, dest, shift);
+        m_assembler.clrldi(dest, dest, 64 - bitSize);
+        m_assembler.ld(shift, PPC64Registers::r1, classicSpillSlot0);
+    }
+
+    template<unsigned bitSize>
+    void classicStoreConditional(RegisterID source, RegisterID address)
+    {
+        RegisterID word = classicHelper(source, address);
+        RegisterID shift = classicHelper(source, address, word);
+        m_assembler.std(word, PPC64Registers::r1, classicSpillSlot0);
+        m_assembler.std(shift, PPC64Registers::r1, classicSpillSlot1);
+        m_assembler.rldicr(PPC64Registers::r0, address, 0, 61);
+        m_assembler.lwzx(word, PPC64Registers::r0, PPC64Registers::r0);
+        classicFieldShift<bitSize>(shift, address);
+        if constexpr (bitSize == 8)
+            m_assembler.li(PPC64Registers::r0, 0xff);
+        else {
+            m_assembler.li(PPC64Registers::r0, -1);
+            m_assembler.clrldi(PPC64Registers::r0, PPC64Registers::r0, 48);
+        }
+        m_assembler.slw(PPC64Registers::r0, PPC64Registers::r0, shift);
+        m_assembler.andc(word, word, PPC64Registers::r0);
+        m_assembler.clrldi(PPC64Registers::r0, source, 64 - bitSize);
+        m_assembler.slw(PPC64Registers::r0, PPC64Registers::r0, shift);
+        m_assembler.or_(word, word, PPC64Registers::r0);
+        m_assembler.rldicr(PPC64Registers::r0, address, 0, 61);
+        m_assembler.stwcx_(word, PPC64Registers::r0, PPC64Registers::r0);
+        // Loads leave CR0 (the stwcx. result) alone.
+        m_assembler.ld(word, PPC64Registers::r1, classicSpillSlot0);
+        m_assembler.ld(shift, PPC64Registers::r1, classicSpillSlot1);
+    }
+
+    void classicLoadImmediate64(RegisterID dest, uint64_t value)
+    {
+        m_assembler.lis(dest, static_cast<int16_t>(value >> 48));
+        m_assembler.ori(dest, dest, (value >> 32) & 0xffff);
+        m_assembler.sldi(dest, dest, 32);
+        m_assembler.oris(dest, dest, (value >> 16) & 0xffff);
+        m_assembler.ori(dest, dest, value & 0xffff);
+    }
+
+    // SWAR popcount (no popcntw/popcntd on the 970). Like the reservations it
+    // needs no macro scratch register: two parked helpers.
+    void classicCountPopulation(RegisterID src, RegisterID dst, bool is32)
+    {
+        RegisterID h = classicHelper(src, dst);
+        RegisterID k = classicHelper(src, dst, h);
+        m_assembler.std(h, PPC64Registers::r1, classicSpillSlot0);
+        m_assembler.std(k, PPC64Registers::r1, classicSpillSlot1);
+        if (is32)
+            m_assembler.clrldi(dst, src, 32);
+        else if (dst != src)
+            m_assembler.mr(dst, src);
+        m_assembler.srdi(h, dst, 1);
+        classicLoadImmediate64(k, 0x5555555555555555ULL);
+        m_assembler.and_(h, h, k);
+        m_assembler.subf(dst, h, dst);
+        classicLoadImmediate64(k, 0x3333333333333333ULL);
+        m_assembler.and_(h, dst, k);
+        m_assembler.srdi(dst, dst, 2);
+        m_assembler.and_(dst, dst, k);
+        m_assembler.add(dst, dst, h);
+        m_assembler.srdi(h, dst, 4);
+        m_assembler.add(dst, dst, h);
+        classicLoadImmediate64(k, 0x0f0f0f0f0f0f0f0fULL);
+        m_assembler.and_(dst, dst, k);
+        classicLoadImmediate64(k, 0x0101010101010101ULL);
+        m_assembler.mulld(dst, dst, k);
+        m_assembler.srdi(dst, dst, 56);
+        m_assembler.ld(h, PPC64Registers::r1, classicSpillSlot0);
+        m_assembler.ld(k, PPC64Registers::r1, classicSpillSlot1);
+    }
+#endif
+
+    template<unsigned bitSize>
+    void loadAndReserve(RegisterID dest, RegisterID address)
+    {
+#if !LEOPARD_PPC64_ISA206
+        if constexpr (bitSize == 8 || bitSize == 16) {
+            classicLoadAndReserve<bitSize>(dest, address);
+            return;
+        }
+#endif
+        // r0 in an RA field reads as the literal zero, so these are plain
+        // register-indirect accesses: EA = 0 + address.
+        if constexpr (bitSize == 8)
+            m_assembler.lbarx(dest, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 16)
+            m_assembler.lharx(dest, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 32)
+            m_assembler.lwarx(dest, PPC64Registers::r0, address);
+        else
+            m_assembler.ldarx(dest, PPC64Registers::r0, address);
+    }
+
+    template<unsigned bitSize>
+    void storeConditional(RegisterID source, RegisterID address)
+    {
+        // The widths must pair with the larx above. A reservation taken by
+        // lbarx and closed by stwcx. is the architecturally undefined case
+        // even at the same address, which is why one bitSize dispatches both
+        // halves and they can never be mixed.
+#if !LEOPARD_PPC64_ISA206
+        if constexpr (bitSize == 8 || bitSize == 16) {
+            classicStoreConditional<bitSize>(source, address);
+            return;
+        }
+#endif
+        if constexpr (bitSize == 8)
+            m_assembler.stbcx_(source, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 16)
+            m_assembler.sthcx_(source, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 32)
+            m_assembler.stwcx_(source, PPC64Registers::r0, address);
+        else
+            m_assembler.stdcx_(source, PPC64Registers::r0, address);
+    }
+
+    // stcx. reports success in CR0[EQ], not in a register. ARM64's
+    // storeCondRel* hands the caller a status GPR to test; this hands back a
+    // Jump taken when the reservation was LOST, which is the same control
+    // flow with three fewer instructions per lap -- no mfcr/rlwinm/xori to
+    // materialise a status that is immediately branched on anyway.
+    //
+    // Pair it with loadAndReserve/storeConditional of the SAME bitSize, and
+    // keep the window between them as short as the architecture note above
+    // requires.
+    Jump branchStoreConditionalFailed() { return makeBranch({ CRBit::EQ, false }); }
+
+    // popcntw/popcntd are POWER7, so the FPRegisterID temp the shared
+    // signature carries (ARM64 routes through a vector popcount) is unused
+    // here. The 32-bit form needs no mask: popcntw's result is 0..32.
+#if !LEOPARD_PPC64_ISA206
+    void countPopulation32(RegisterID src, RegisterID dst) { classicCountPopulation(src, dst, true); }
+    void countPopulation64(RegisterID src, RegisterID dst) { classicCountPopulation(src, dst, false); }
+#else
+    void countPopulation32(RegisterID src, RegisterID dst) { m_assembler.popcntw(dst, src); }
+    void countPopulation64(RegisterID src, RegisterID dst) { m_assembler.popcntd(dst, src); }
+#endif
+    void countPopulation32(RegisterID src, RegisterID dst, FPRegisterID) { countPopulation32(src, dst); }
+    void countPopulation64(RegisterID src, RegisterID dst, FPRegisterID) { countPopulation64(src, dst); }
+
+    // dest = minuend - mulLeft * mulRight. maddld is ISA 3.0 and would need a
+    // negated addend, so this is the POWER8-legal pair. mulld's low doubleword
+    // is correct whatever the operands' signs.
+    void multiplySub64(RegisterID mulLeft, RegisterID mulRight, RegisterID minuend, RegisterID dest)
+    {
+        auto temp = temps<Data>();
+        m_assembler.mulld(temp.data(), mulLeft, mulRight);
+        m_assembler.subf(dest, temp.data(), minuend);
+    }
+
+    // The atomic read-modify-writes BBQ needs, in x86's `lock xadd`/`xchg`
+    // shape: the operation is applied to memory and the register is left
+    // holding the OLD value.
+    //
+    // The address must have no displacement, which is not a restriction
+    // imposed here -- larx and stcx. have no D-form, so the effective address
+    // has to be final before any reservation exists, and the existing
+    // storeCondImpl asserts the same thing. BBQ satisfies it by construction:
+    // "For Atomic access, we need SimpleAddress (uoffset = 0)", folding the
+    // offset into the pointer register before building the Address
+    // (WasmBBQJIT64.cpp).
+    //
+    // Ordering is this port's leading-sync convention, matching
+    // emitAtomicStrongCAS: sync ahead of the loop, lwsync after it. Nothing is
+    // emitted between the larx and the stcx. but the arithmetic itself.
+    template<unsigned bitSize, bool isAdd>
+    void emitAtomicRMW(RegisterID reg, Address address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        RELEASE_ASSERT(!address.offset);
+        auto temp = temps<Data, Memory>();
+        // The operand has to outlive a failed stcx., because reg is where the
+        // loaded value goes and is therefore destroyed on every iteration.
+        RegisterID operand = temp.data();
+        move(reg, operand);
+
+        memoryFence();
+        auto reload = label();
+        loadAndReserve<bitSize>(reg, address.base);
+        RegisterID toStore = operand;
+        if constexpr (isAdd) {
+            // A 64-bit add is right for every width: stcx. of 8, 16 or 32 bits
+            // writes only the low bits, and the loaded value was zero-extended
+            // by lbarx/lharx/lwarx, so the sum's low bits are the wrapped
+            // result the width wants.
+            m_assembler.add(temp.memory(), reg, operand);
+            toStore = temp.memory();
+        }
+        storeConditional<bitSize>(toStore, address.base);
+        makeBranch({ CRBit::EQ, false }).linkTo(reload, this);
+        loadFence();
+    }
+
+    void atomicXchgAdd8(RegisterID reg, Address address) { emitAtomicRMW<8, true>(reg, address); }
+    void atomicXchgAdd16(RegisterID reg, Address address) { emitAtomicRMW<16, true>(reg, address); }
+    void atomicXchgAdd32(RegisterID reg, Address address) { emitAtomicRMW<32, true>(reg, address); }
+    void atomicXchgAdd64(RegisterID reg, Address address) { emitAtomicRMW<64, true>(reg, address); }
+    void atomicXchg8(RegisterID reg, Address address) { emitAtomicRMW<8, false>(reg, address); }
+    void atomicXchg16(RegisterID reg, Address address) { emitAtomicRMW<16, false>(reg, address); }
+    void atomicXchg32(RegisterID reg, Address address) { emitAtomicRMW<32, false>(reg, address); }
+    void atomicXchg64(RegisterID reg, Address address) { emitAtomicRMW<64, false>(reg, address); }
+
+    // ==================================================================
+    // The load-linked / store-conditional pair B3 lowers atomics onto for any
+    // target without a single-instruction CAS. ARM64 reaches these the same way
+    // whenever it has no LSE: B3LowerToAir's atomic lowering builds the retry
+    // loop itself and asks the MacroAssembler only for the two halves.
+    //
+    // THE STATUS POLARITY IS INVERTED RELATIVE TO THE HARDWARE, and that is the
+    // contract, not a mistake. ARM64's stxr writes 0 to its status register on
+    // SUCCESS, and the loop B3 builds ends in
+    //   BranchTest32 Zero, boolResult -> doneBlock, reloopBlock
+    // so zero means done. PPC's stcx. is the other way round: it sets CR0[EQ] on
+    // success. CRTest { CRBit::EQ, false } is what reconciles them --
+    // emitSetFromCR0 appends an `xori dest, dest, 1` when branchIfSet is false --
+    // so these write 0 on success and 1 on failure, like ARM64.
+    //
+    // The barriers are split across the pair because B3 splits them: the fenced
+    // variants are selected together by loadLinkOpcode/storeCondOpcode on
+    // atomic->hasFence(), so LoadLinkAcq + StoreCondRel reassemble this port's
+    // existing seq_cst RMW shape -- leading `sync` before the larx, trailing
+    // `lwsync` after the stcx. -- which is the leading-sync convention
+    // jsc-ppc64le-atomics-cas.md 3.2 says must not be mixed within a program.
+    // Putting the release half BEFORE the stcx. instead would leave the pair with
+    // no trailing barrier at all and no acquire edge.
+    //
+    // One cost worth naming: B3 puts the load inside the retry loop, so the
+    // leading `sync` is paid on every lap. gcc hoists it out of the loop
+    // (3.1 of the same document). Correct, and more expensive than the
+    // hand-written CAS above, which keeps its sync outside the window.
+    //
+    // Air hands these a SimpleAddr, which is an Address with no displacement.
+    // That is asserted rather than folded: larx and stcx. have no D-form, so a
+    // displacement would need a staging register, and Air generates under
+    // DisallowMacroScratchRegisterUsage.
+    // ==================================================================
+
+    template<unsigned bitSize>
+    void loadLinkImpl(Address address, RegisterID dest, bool acquire)
+    {
+        RELEASE_ASSERT(!address.offset);
+        if (acquire)
+            memoryFence();
+        loadAndReserve<bitSize>(dest, address.base);
+    }
+
+    template<unsigned bitSize>
+    void storeCondImpl(RegisterID src, Address address, RegisterID result, bool release)
+    {
+        RELEASE_ASSERT(!address.offset);
+        storeConditional<bitSize>(src, address.base);
+        emitSetFromCR0({ CRBit::EQ, false }, result);
+        if (release)
+            loadFence();
+    }
+
+    void loadLink8(Address address, RegisterID dest) { loadLinkImpl<8>(address, dest, false); }
+    void loadLinkAcq8(Address address, RegisterID dest) { loadLinkImpl<8>(address, dest, true); }
+    void storeCond8(RegisterID src, Address address, RegisterID result) { storeCondImpl<8>(src, address, result, false); }
+    void storeCondRel8(RegisterID src, Address address, RegisterID result) { storeCondImpl<8>(src, address, result, true); }
+
+    void loadLink16(Address address, RegisterID dest) { loadLinkImpl<16>(address, dest, false); }
+    void loadLinkAcq16(Address address, RegisterID dest) { loadLinkImpl<16>(address, dest, true); }
+    void storeCond16(RegisterID src, Address address, RegisterID result) { storeCondImpl<16>(src, address, result, false); }
+    void storeCondRel16(RegisterID src, Address address, RegisterID result) { storeCondImpl<16>(src, address, result, true); }
+
+    void loadLink32(Address address, RegisterID dest) { loadLinkImpl<32>(address, dest, false); }
+    void loadLinkAcq32(Address address, RegisterID dest) { loadLinkImpl<32>(address, dest, true); }
+    void storeCond32(RegisterID src, Address address, RegisterID result) { storeCondImpl<32>(src, address, result, false); }
+    void storeCondRel32(RegisterID src, Address address, RegisterID result) { storeCondImpl<32>(src, address, result, true); }
+
+    void loadLink64(Address address, RegisterID dest) { loadLinkImpl<64>(address, dest, false); }
+    void loadLinkAcq64(Address address, RegisterID dest) { loadLinkImpl<64>(address, dest, true); }
+    void storeCond64(RegisterID src, Address address, RegisterID result) { storeCondImpl<64>(src, address, result, false); }
+    void storeCondRel64(RegisterID src, Address address, RegisterID result) { storeCondImpl<64>(src, address, result, true); }
+
+    template<unsigned bitSize>
+    JumpList branchAtomicWeakCASImpl(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        auto temp = temps<Data, Memory>();
+
+        // The effective address is finished BEFORE the barrier and before the
+        // reservation exists. larx and stcx. have no D-form, so a
+        // displacement has to be folded in here, and once the reservation is
+        // held nothing may compute, load or store.
+        auto resolution = resolveAddress(address, temp.memory());
+        RegisterID effectiveAddress = resolution.base;
+        if (resolution.offset) {
+            addImmediate64(resolution.base, static_cast<int64_t>(resolution.offset), temp.memory());
+            effectiveAddress = temp.memory();
+        }
+
+        // THE SIGN-EXTENSION SEAM, and it is load-bearing. lbarx and lharx
+        // zero-extend, but the expected value arrived from the DFG's
+        // loadFromIntTypedArray, which uses load8SignedExtendTo32 for an
+        // Int8Array: the expected value of the byte 0xff is 0xffffffff.
+        // Without this mask the compare below never succeeds, the store is
+        // skipped, and the DFG's loop reloads the same -1 and tries again --
+        // forever. That failure is not a crash and not a wrong answer, it is
+        // a HANG on the first Atomics.sub of a negative Int8Array element,
+        // at the DFG tier only. This is the compiler's own `rlwinm 4,4,0,0xff`
+        // from the same sequence. The register is documented clobberable and
+        // the DFG keeps its result in a separate copy, so the mask is free.
+        // At 32 and 64 bits nothing is masked: cmplw reads only bits 32:63,
+        // and cmpld reads the whole register.
+        if constexpr (bitSize < 32)
+            m_assembler.clrldi(expectedAndClobbered, expectedAndClobbered, 64 - bitSize);
+
+        memoryFence();
+        loadAndReserve<bitSize>(temp.data(), effectiveAddress);
+        if constexpr (bitSize == 64)
+            m_assembler.cmpld(CRField::CR0, temp.data(), expectedAndClobbered);
+        else
+            m_assembler.cmplw(CRField::CR0, temp.data(), expectedAndClobbered);
+        // A one-word guard -- the same primitive makeBranch is built from --
+        // skipping the store-conditional when CR0.EQ is clear. On that path
+        // CR0.EQ stays 0, which is already the answer the status branch
+        // wants, and the reservation left standing is harmless: the next larx
+        // anywhere replaces it. The stcx. is reachable by this guard falling
+        // through and from nowhere else, which is the rule that keeps a
+        // stcx. from ever meeting a reservation it did not take.
+#if !LEOPARD_PPC64_ISA206
+        if constexpr (bitSize < 32) {
+            // PowerPC 970: the byte/halfword store-conditional is a sequence
+            // (classicStoreConditional), not one word, so a real branch skips
+            // all of it. CR0.EQ is clear on that path, as with the guard.
+            Jump mismatch = makeBranch({ CRBit::EQ, false });
+            storeConditional<bitSize>(newValue, effectiveAddress);
+            mismatch.link(this);
+            loadFence();
+            return JumpList(makeBranch({ CRBit::EQ, cond == Success }));
+        }
+#endif
+        m_assembler.insn(Assembler::conditionalGuardInsn(Assembler::BOFalse, crBitIndex(CRField::CR0, CRBit::EQ)));
+        storeConditional<bitSize>(newValue, effectiveAddress);
+        loadFence();
+
+        // CR0.EQ now means "the store happened", on either path: the compare
+        // cleared it on a mismatch and the stcx. recorded it on an attempt,
+        // and no barrier writes a condition register.
+        return JumpList(makeBranch({ CRBit::EQ, cond == Success }));
+    }
+
+    JumpList branchAtomicWeakCAS8(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        return branchAtomicWeakCASImpl<8>(cond, expectedAndClobbered, newValue, address);
+    }
+
+    JumpList branchAtomicWeakCAS16(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        return branchAtomicWeakCASImpl<16>(cond, expectedAndClobbered, newValue, address);
+    }
+
+    JumpList branchAtomicWeakCAS32(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        return branchAtomicWeakCASImpl<32>(cond, expectedAndClobbered, newValue, address);
+    }
+
+    // Unreachable from the DFG, which asserts on any other element size and
+    // sends BigInt64 atomics down the C++ path. It is here because it is the
+    // same template and because Air's AtomicStrongCAS64/LoadLink64 will want
+    // it. testmasm is its only caller today.
+    JumpList branchAtomicWeakCAS64(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        return branchAtomicWeakCASImpl<64>(cond, expectedAndClobbered, newValue, address);
+    }
+
+    // ==================================================================
+    // Strong compare-and-swap.
+    //
+    // The sibling of the weak form above, and the whole difference is one
+    // inner loop. A STRONG CAS fails only on a genuine value mismatch. It
+    // may not report failure because the reservation was lost, and on an
+    // LL/SC machine a lost reservation is the only other way a stcx. can
+    // fail, so the stcx. result -- and only the stcx. result -- is retried.
+    // The compare is INSIDE that retry because after a failed stcx. the
+    // location may hold anything: a CAS that re-stores without re-comparing
+    // is not a CAS, it is a store that waited.
+    //
+    //         sync                       leading barrier, ONCE
+    //     1:  l{b,h,w,d}arx  rD,0,ea
+    //         cmpl{w,d}      cr0,rD,expected
+    //         bne            cr0,2f      genuine mismatch: leave, CR0.EQ = 0
+    //         st{b,h,w,d}cx. new,0,ea    CR0.EQ = stored
+    //         bne            cr0,1b      reservation lost: reload, RE-COMPARE
+    //     2:  lwsync                     trailing barrier, BOTH paths
+    //         mr             expected,rD the value seen
+    //
+    // The leading `sync` is outside the loop, which is where gcc puts it and
+    // is not an optimisation to be second-guessed: a sync orders everything
+    // before it against everything after it, including a re-executed larx,
+    // so repeating it per lap would be correct and useless. It is also still
+    // outside the reservation window, so the executed window on the storing
+    // path holds one compare and one guard branch and nothing else, exactly
+    // as the weak form's does. Everything section 3 of
+    // jsc-ppc64le-atomics-cas.md says about the leading-sync convention
+    // applies here unchanged, including why `lwsync` in its place would be
+    // a bug that only many threads find: lwsync has no StoreLoad edge, and
+    // StoreLoad is precisely what sequential consistency adds to
+    // acquire/release. Do not reach for the ARM64 shape either. ldaxr/stlxr
+    // give a CAS loop SC semantics on the instructions themselves, which is
+    // why MacroAssemblerARM64's atomics have no barriers near them;
+    // transplanting that here compiles, passes every single-threaded test,
+    // and is wrong.
+    //
+    // WHERE THE LOOP CLOSES IS A CORRECTNESS PROPERTY, not a style choice.
+    // The retry edge is on the stcx. only. Closing it over the mismatch as
+    // well would make the sign-extension seam below -- which costs the weak
+    // form a wrong answer that the DFG's outer loop turns into a hang --
+    // hang INSIDE this primitive, where there is no outer loop to absorb it
+    // and no tier below to fall back to. As written, a mismatch always
+    // leaves, so the worst a missing mask can do here is report Failure for
+    // a CAS that should have succeeded.
+    //
+    // The clrldi is that mask, and it is load-bearing for the same reason it
+    // is in the weak form: lbarx and lharx zero-extend while the callers'
+    // sub-word loads sign-extend, so the expected value of the byte 0xff
+    // arrives as 0xffffffff and would never compare equal to 0x000000ff.
+    // All four larx/stcx. widths are ISA 2.07 -- POWER8, this port's floor
+    // (docs/power8-baseline-power9-paths.md) -- so there is no hasISA30()
+    // gate here and both generations execute identical code.
+    //
+    // Status arrives in CR0.EQ for the compare and for the stcx. alike, and
+    // no barrier and no `mr` writes a condition register, so by the join it
+    // means "the store happened" on either path. Two finishers consume it:
+    // makeBranch for the branch form, and emitSetFromCR0 -- mfocrf plus
+    // rlwinm, gcc's own `mfcr 3,128; rlwinm 3,3,3,1` -- for the form that
+    // owes its caller a 0/1 in a GPR. ISA 3.0's `setb` would shorten the
+    // second by one instruction and is deliberately not used: it would be
+    // the only ISA-3.0 dependency in this family, for an optimisation, on a
+    // path that would then differ between POWER8 and POWER9.
+    //
+    // See powerpc64le-handbook jsc-ppc64le-atomics-cas.md sections 4 and 5.
+    // ==================================================================
+
+    // Leaves the CAS status in CR0.EQ (1 = the store happened) and the value
+    // it saw in expectedAndResult. Every public strong form below is this
+    // plus a finisher.
+    template<unsigned bitSize, typename AddressType>
+    void emitAtomicStrongCAS(RegisterID expectedAndResult, RegisterID newValue, AddressType address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        auto temp = temps<Data, Memory>();
+
+        // As in the weak form: the effective address is finished before the
+        // barrier and before any reservation exists, because larx and stcx.
+        // have no D-form and because nothing may compute, load or store
+        // between a larx and its stcx. Note that it is also finished before
+        // the LOOP, so a retry re-executes the larx and nothing else.
+        auto resolution = resolveAddress(address, temp.memory());
+        RegisterID effectiveAddress = resolution.base;
+        if (resolution.offset) {
+            addImmediate64(resolution.base, static_cast<int64_t>(resolution.offset), temp.memory());
+            effectiveAddress = temp.memory();
+        }
+
+        if constexpr (bitSize < 32)
+            m_assembler.clrldi(expectedAndResult, expectedAndResult, 64 - bitSize);
+
+        memoryFence();
+
+        auto reload = label();
+        loadAndReserve<bitSize>(temp.data(), effectiveAddress);
+        if constexpr (bitSize == 64)
+            m_assembler.cmpld(CRField::CR0, temp.data(), expectedAndResult);
+        else
+            m_assembler.cmplw(CRField::CR0, temp.data(), expectedAndResult);
+        // A genuine mismatch leaves the loop with CR0.EQ clear, which is
+        // already the answer both finishers want. The guard word of this
+        // branch is the only instruction between the larx and the stcx. on
+        // the storing path; its `b` word is skipped there.
+        auto mismatch = makeBranch({ CRBit::EQ, false });
+        storeConditional<bitSize>(newValue, effectiveAddress);
+        // The one retry edge: the store-conditional failed, so the
+        // reservation was lost and nothing was written. Reload and compare
+        // again against the same expected value, which is still the
+        // caller's -- expectedAndResult is not written until the join.
+        makeBranch({ CRBit::EQ, false }).linkTo(reload, this);
+
+        // The storing path falls through to here; the mismatching path
+        // branches here. CR0.EQ distinguishes them and survives both of the
+        // instructions below.
+        mismatch.link(this);
+        loadFence();
+        move(temp.data(), expectedAndResult);
+    }
+
+    template<unsigned bitSize, typename AddressType>
+    JumpList branchAtomicStrongCASImpl(StatusCondition cond, RegisterID expectedAndResult, RegisterID newValue, AddressType address)
+    {
+        emitAtomicStrongCAS<bitSize>(expectedAndResult, newValue, address);
+        return JumpList(makeBranch({ CRBit::EQ, cond == Success }));
+    }
