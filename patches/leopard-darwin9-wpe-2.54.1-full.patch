+
+// The controls below hand-emit a byte reservation. The PowerPC 970 (Leopard g5/generic profiles,
+// LEOPARD_PPC64_ISA206=0) has no lbarx/stbcx., so there they use the MacroAssembler's word-reservation
+// emulation, which has the same zero-extension seam.
+#if CPU(PPC64)
+#if LEOPARD_PPC64_ISA206
+#define TESTMASM_LBARX(jit, dest, base) (jit).m_assembler.lbarx(dest, PPC64Registers::r0, base)
+#define TESTMASM_STBCX(jit, src, base) (jit).m_assembler.stbcx_(src, PPC64Registers::r0, base)
+#else
+#define TESTMASM_LBARX(jit, dest, base) (jit).loadAndReserve<8>(dest, base)
+#define TESTMASM_STBCX(jit, src, base) (jit).storeConditional<8>(src, base)
+#endif
+#endif
+
+// The sign-extension seam, with the must-hang negative control.
+//
+// jsc-ppc64-atomics-cas.md section 5.3: Atomics.sub on an Int8Array element
+// holding -1 reaches the stub with expected = 0xffffffff, because the DFG
+// reloads with load8SignedExtendTo32, while lbarx returns 0x000000ff. The
+// clrldi is what makes those compare equal. Without it the compare never
+// succeeds, the store never happens, and the DFG's loop reloads the same -1
+// and goes round again: not a crash and not a wrong answer, a hang.
+//
+// Section 8 asks for that hang as the negative control. A test cannot hang
+// and still be a test, so the hang is made finite rather than made harmless:
+// both arms run the DFG's own loop shape -- sign-extending reload, compute,
+// weak CAS, jump back -- under a fixed attempt budget. The first arm calls
+// the shipping stub and must converge on its first attempt. The second emits
+// the identical sequence with the clrldi left out, by hand, because the
+// shipping stub cannot be asked to be wrong, and must burn the whole budget
+// without ever storing. Exhausting the budget is what the hang looks like
+// from inside a test; if that arm ever returns 1, the mask has stopped being
+// load-bearing and the case above has stopped measuring it.
+static void testPPC64AtomicWeakCASSignExtendSeam()
+{
+    constexpr int32_t budget = 16;
+
+    // Atomics.sub(int8Array, 0, 1), through the shipping stub.
+    auto masked = compile([] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto expected = GPRInfo::argumentGPR2;
+        const auto newValue = GPRInfo::argumentGPR3;
+        const auto counter = GPRInfo::nonArgGPR0;
+
+        jit.move(CCallHelpers::TrustedImm32(budget), counter);
+        auto loop = jit.label();
+        jit.load8SignedExtendTo32(CCallHelpers::BaseIndex(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, CCallHelpers::TimesOne), expected);
+        jit.move(expected, newValue);
+        jit.sub32(CCallHelpers::TrustedImm32(1), newValue);
+        auto stored = jit.branchAtomicWeakCAS8(CCallHelpers::Success, expected, newValue,
+            CCallHelpers::BaseIndex(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, CCallHelpers::TimesOne));
+        jit.sub32(CCallHelpers::TrustedImm32(1), counter);
+        jit.branchTest32(CCallHelpers::NonZero, counter).linkTo(loop, &jit);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // The same loop around branchAtomicWeakCAS8's body with the clrldi
+    // removed. The element is index 0 so the address is argumentGPR0 itself
+    // and the reservation window holds, as the stub's does, one compare and
+    // one guard.
+    auto unmasked = compile([] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto expected = GPRInfo::argumentGPR2;
+        const auto newValue = GPRInfo::argumentGPR3;
+        const auto loaded = GPRInfo::argumentGPR1;
+        const auto counter = GPRInfo::nonArgGPR0;
+
+        jit.move(CCallHelpers::TrustedImm32(budget), counter);
+        auto loop = jit.label();
+        jit.load8SignedExtendTo32(CCallHelpers::Address(GPRInfo::argumentGPR0), expected);
+        jit.move(expected, newValue);
+        jit.sub32(CCallHelpers::TrustedImm32(1), newValue);
+
+        jit.memoryFence();
+        TESTMASM_LBARX(jit, loaded, GPRInfo::argumentGPR0);
+        jit.m_assembler.cmplw(CRField::CR0, loaded, expected);
+#if LEOPARD_PPC64_ISA206
+        jit.m_assembler.insn(PPC64Assembler::conditionalGuardInsn(PPC64Assembler::BOFalse, crBitIndex(CRField::CR0, CRBit::EQ)));
+        TESTMASM_STBCX(jit, newValue, GPRInfo::argumentGPR0);
+#else
+        {   // the 970's byte store-conditional is a sequence: branch around all of it
+            auto mismatch = jit.makeBranch({ CRBit::EQ, false });
+            TESTMASM_STBCX(jit, newValue, GPRInfo::argumentGPR0);
+            mismatch.link(&jit);
+        }
+#endif
+        jit.loadFence();
+        auto stored = jit.makeBranch({ CRBit::EQ, true });
+
+        jit.sub32(CCallHelpers::TrustedImm32(1), counter);
+        jit.branchTest32(CCallHelpers::NonZero, counter).linkTo(loop, &jit);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // -1. The masked arm converges; the unmasked arm never stores.
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(masked, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xfeu);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x5au);
+    }
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmasked, static_cast<void*>(data), static_cast<uint64_t>(0)), 0u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xffu);
+    }
+    // A positive element, where the seam does not exist: both arms store.
+    // This is what keeps the control honest -- it fails for the sign, not
+    // because the hand-emitted sequence is broken in some other way.
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(masked, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmasked, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+}
+
+// ---- Strong compare-and-swap -------------------------------------------
+//
+// branchAtomicStrongCAS{8,16,32,64} and atomicStrongCAS{8,16,32,64} differ
+// from the weak forms by exactly one thing, an inner loop that retries the
+// store-conditional, and that difference is INVISIBLE to a single-threaded
+// test: nothing loses a reservation when nothing else is running, so every
+// case below except the last would pass unchanged if the strong forms
+// simply forwarded to the weak ones. The last case is the one that is not
+// blind to it, and it carries the weak form as its control.
+//
+// What the single-threaded cases do prove, and the weak form does not
+// provide, is the other half of the strong contract: expectedAndResult
+// comes back holding the value the CAS SAW. On a mismatch the weak form
+// leaves the (masked) expected value there; the strong form leaves what was
+// in memory, which is a number that could not be produced without the load
+// having happened.
+//
+// The stub returns 1 when the status jump was taken and 0 otherwise, and
+// writes the value seen to a caller-supplied slot on both paths.
+template<unsigned bitSize>
+static MacroAssemblerCodeRef<JSEntryPtrTag> compilePPC64AtomicStrongCAS(CCallHelpers::StatusCondition cond, uint64_t* seen)
+{
+    return compile([cond, seen] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+
+        constexpr auto scale = bitSize == 8 ? CCallHelpers::TimesOne
+            : bitSize == 16 ? CCallHelpers::TimesTwo
+            : bitSize == 32 ? CCallHelpers::TimesFour
+            : CCallHelpers::TimesEight;
+        CCallHelpers::BaseIndex address(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, scale);
+
+        CCallHelpers::JumpList taken;
+        if constexpr (bitSize == 8)
+            taken = jit.branchAtomicStrongCAS8(cond, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else if constexpr (bitSize == 16)
+            taken = jit.branchAtomicStrongCAS16(cond, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else if constexpr (bitSize == 32)
+            taken = jit.branchAtomicStrongCAS32(cond, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else
+            taken = jit.branchAtomicStrongCAS64(cond, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        taken.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+
+        // Both paths converge here with argumentGPR2 holding the value the
+        // CAS saw. returnValueGPR is r3 == argumentGPR0 on this target, so
+        // the status move above cannot have disturbed it.
+        jit.move(CCallHelpers::TrustedImmPtr(seen), GPRInfo::nonArgGPR0);
+        jit.store64(GPRInfo::argumentGPR2, CCallHelpers::Address(GPRInfo::nonArgGPR0));
+
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+}
+
+static void testPPC64AtomicStrongCAS8()
+{
+    uint64_t seen = 0;
+    auto cas = compilePPC64AtomicStrongCAS<8>(CCallHelpers::Success, &seen);
+
+    // Matching: stores, takes Success, leaves the neighbours in the same
+    // 128-byte reservation granule alone, and hands back what it saw.
+    {
+        uint8_t data[] = { 0x11, 0x42, 0x33 };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42), static_cast<uint64_t>(0x99)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x11u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x99u);
+        CHECK_EQ(static_cast<unsigned>(data[2]), 0x33u);
+        CHECK_EQ(seen, static_cast<uint64_t>(0x42));
+    }
+    // Mismatching: no store, Failure, and the value seen is the one that
+    // was in memory -- not the expected value the caller passed in.
+    {
+        uint8_t data[] = { 0x11, 0x42, 0x33 };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x43), static_cast<uint64_t>(0x99)), 0u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x42u);
+        CHECK_EQ(seen, static_cast<uint64_t>(0x42));
+    }
+    // The Int8Array seam: lbarx zero-extends, the caller's load sign-extends,
+    // so the byte 0xff arrives as 0xffffffff and must still compare equal.
+    // testPPC64AtomicStrongCASSignExtendSeam is the control for this case.
+    {
+        uint8_t data[] = { 0x11, 0xff, 0x33 };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0xffffffff), static_cast<uint64_t>(0xfe)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0xfeu);
+        // Zero-extended, because that is what lbarx returned.
+        CHECK_EQ(seen, static_cast<uint64_t>(0xff));
+    }
+    // Garbage above the byte: the mask is a width mask, not a sign fix.
+    {
+        uint8_t data[] = { 0x11, 0xff, 0x33 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x12345678ffull), static_cast<uint64_t>(0xfe)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0xfeu);
+    }
+}
