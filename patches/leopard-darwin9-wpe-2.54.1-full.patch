+// Memory-to-memory moves at every width, Address to BaseIndex and back, with
+// the bytes either side of the destination checked for spill.
+void testPPC64VectorTransfer()
+{
+    alignas(16) uint8_t src[32], dst[64];
+    for (unsigned i = 0; i < 32; ++i)
+        src[i] = static_cast<uint8_t>(0x30 + i);
+    for (unsigned width : { 1u, 2u, 4u, 8u, 16u }) {
+        for (bool toBaseIndex : { false, true }) {
+            for (unsigned i = 0; i < 64; ++i)
+                dst[i] = 0xcc;
+            auto test = compile([=] (CCallHelpers& jit) {
+                emitFunctionPrologue(jit);
+                auto from = CCallHelpers::Address(GPRInfo::argumentGPR0, 5);
+                jit.move(CCallHelpers::TrustedImm32(16), GPRInfo::argumentGPR2);
+                auto toIndexed = CCallHelpers::BaseIndex(GPRInfo::argumentGPR1, GPRInfo::argumentGPR2, CCallHelpers::TimesOne, 7);
+                auto toPlain = CCallHelpers::Address(GPRInfo::argumentGPR1, 23);
+                switch (width) {
+                case 1: toBaseIndex ? jit.transfer8(from, toIndexed) : jit.transfer8(from, toPlain); break;
+                case 2: toBaseIndex ? jit.transfer16(from, toIndexed) : jit.transfer16(from, toPlain); break;
+                case 4: toBaseIndex ? jit.transfer32(from, toIndexed) : jit.transfer32(from, toPlain); break;
+                case 8: toBaseIndex ? jit.transfer64(from, toIndexed) : jit.transfer64(from, toPlain); break;
+                default: toBaseIndex ? jit.transferVector(from, toIndexed) : jit.transferVector(from, toPlain); break;
+                }
+                emitFunctionEpilogue(jit);
+                jit.ret();
+            });
+            invoke<void>(test, &src[0], &dst[0]);
+            for (unsigned i = 0; i < 64; ++i) {
+                bool written = i >= 23 && i < 23 + width;
+                CHECK_EQ(dst[i], written ? src[5 + (i - 23)] : 0xcc);
+            }
+        }
+    }
+}
