+// q15mulr_sat_s. Lane 0 is the only input pair that saturates, lanes 2 and 3
+// are a rounding pair that differ by one in the sum before the shift.
+void testPPC64VectorQ15MulrSat()
+{
+    alignas(16) const int16_t a[8] = { -32768, 0x4000, 0x0001, 0x0001, -3, 12345, 0x7fff, -1 };
+    alignas(16) const int16_t b[8] = { -32768, 0x4000, 0x4000, 0x3fff, 5, -6789, 0x7fff, -1 };
+    alignas(16) uint8_t out[16];
+    for (bool relaxed : { false, true }) {
+        ppc64RunVectorBinary(a, b, out, [=](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+            if (relaxed)
+                jit.vectorRelaxedQ15Mulr(x, y, d);
+            else
+                jit.vectorMulSat(x, y, d);
+        });
+        for (unsigned i = 0; i < 8; ++i) {
+            int32_t r = (static_cast<int32_t>(a[i]) * b[i] + 0x4000) >> 15;
+            r = std::clamp(r, -32768, 32767);
+            ppc64CheckLane<int16_t>(out, i, static_cast<int16_t>(r));
+        }
+        ppc64CheckLane<int16_t>(out, 0, 32767);   // the saturating case, named
+        ppc64CheckLane<int16_t>(out, 2, 1);        // (0x4000 + 0x4000) >> 15
+        ppc64CheckLane<int16_t>(out, 3, 0);        // (0x3fff + 0x4000) >> 15
+    }
+}
