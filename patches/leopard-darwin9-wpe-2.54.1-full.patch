+#if CPU(PPC64_E6500)
+// The e6500 has no fsqrt in hardware (the kernel emulates it), no
+// friz/frin/frip/frim, no fcfidu/fcfids/fctiduz/fctiwuz and no direct moves,
+// so MacroAssemblerPPC64 builds all of those from classic PowerPC sequences.
+// Upstream testmasm has no test for most of them. This one runs each
+// sequence against libm/libgcc, bit for bit (signed zeros included, any NaN
+// matching any NaN), over edge cases and random inputs, with the source and
+// destination both the same register and different ones.
+static Vector<double> e6500DoubleInputs()
+{
+    constexpr double inf = std::numeric_limits<double>::infinity();
+    constexpr double maxDouble = std::numeric_limits<double>::max();
+    Vector<double> values = {
+        0.0, -0.0, 0.3, -0.3, 0.5, -0.5, 0.7, -0.7, 1.0, -1.0, 1.5, -1.5, 2.5, -2.5, 3.5, -3.5,
+        0.49999999999999994, -0.49999999999999994, 2.0, 4.0, 9.0, 123456.789, -123456.789,
+        4503599627370495.5, -4503599627370495.5, 4503599627370496.0, -4503599627370496.0,
+        4503599627370497.0, -4503599627370497.0, 9007199254740993.0, 1e300, -1e300, 1e-300,
+        0x1p-960, 0x1p-961, 0x1p-1022, -0x1p-1022, 0x1p-1074, -0x1p-1074, maxDouble, -maxDouble,
+        inf, -inf, std::numeric_limits<double>::quiet_NaN(),
+        2147483647.0, 2147483647.5, 2147483648.0, -2147483648.0, -2147483648.5, -2147483649.0,
+        4294967295.0, 4294967295.5, 4294967296.0, -1.0, -0.999,
+        0x1p63, -0x1p63, 0x1p63 + 2048.0, 0x1p64, 0x1p64 - 2048.0, -0x1p63 - 2048.0,
+    };
+    uint64_t seed = 0x9E3779B97F4A7C15ULL;
+    auto next = [&] {
+        seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+        return seed ^ (seed >> 29);
+    };
+    for (unsigned i = 0; i < 20000; ++i)
+        values.append(std::bit_cast<double>(next()));
+    for (unsigned i = 0; i < 20000; ++i) {
+        double mantissa = 1.0 + static_cast<double>(next() >> 11) / 9007199254740992.0;
+        int exponent = static_cast<int>(next() % 141) - 70;
+        double value = std::ldexp(mantissa, exponent);
+        values.append((next() & 1) ? -value : value);
+    }
+    for (unsigned k = 1; k < 2000; ++k) {
+        double square = static_cast<double>(k) * k;
+        values.append(square);
+        values.append(std::bit_cast<double>(std::bit_cast<uint64_t>(square) + 1));
+        values.append(std::bit_cast<double>(std::bit_cast<uint64_t>(square) - 1));
+        values.append(k + 0.5);
+        values.append(-(k + 0.5));
+    }
+    return values;
+}
