+    template<unsigned bitSize, typename AddressType>
+    void atomicStrongCASImpl(StatusCondition cond, RegisterID expectedAndResult, RegisterID newValue, AddressType address, RegisterID result)
+    {
+        emitAtomicStrongCAS<bitSize>(expectedAndResult, newValue, address);
+        emitSetFromCR0({ CRBit::EQ, cond == Success }, result);
+    }
