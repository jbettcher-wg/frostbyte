+        // Little-endian memory order. i8 takes the low byte 0x08; i16 the low
+        // halfword 0x0708; i32 the low word 0x05060708; i64 the whole value.
+        const uint8_t e8[16]  = { 8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8 };
+        const uint8_t e16[16] = { 8,7,8,7,8,7,8,7,8,7,8,7,8,7,8,7 };
+        const uint8_t e32[16] = { 8,7,6,5,8,7,6,5,8,7,6,5,8,7,6,5 };
+        const uint8_t e64[16] = { 8,7,6,5,4,3,2,1,8,7,6,5,4,3,2,1 };
+        check(SIMDLane::i8x16, e8);
+        check(SIMDLane::i16x8, e16);
+        check(SIMDLane::i32x4, e32);
+        check(SIMDLane::i64x2, e64);
+
