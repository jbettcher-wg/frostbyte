+// into its own rows of the shared-memory buffer. WEBKIT_CPU_RASTER_THREADS=N overrides the thread
+// count (1 = the original serial path).
+static unsigned cpuRasterThreads()
+{
+    static unsigned threads = [] {
+        unsigned n = std::min<unsigned>(16, std::max(1, WTF::numberOfProcessorCores()));
+        if (const char* env = getenv("WEBKIT_CPU_RASTER_THREADS")) {
+            if (auto value = parseInteger<unsigned>(StringView::fromLatin1(env)); value && *value >= 1 && *value <= 64)
+                n = *value;
+        }
+        return n;
+    }();
+    return threads;
+}
+
+static WorkerPool& cpuRasterPool()
+{
+    static NeverDestroyed<Ref<WorkerPool>> pool = WorkerPool::create("CPURaster"_s, cpuRasterThreads() - 1);
+    return pool.get();
+}
+
+// Plays the picture back into pixmap in horizontal bands, one per thread (the caller takes band 0).
+static void rasterizePictureInBands(const sk_sp<SkPicture>& picture, const SkPixmap& pixmap, const SkSurfaceProps& props, unsigned bands)
+{
+    const int height = pixmap.height();
+    const int bandHeight = (height + static_cast<int>(bands) - 1) / static_cast<int>(bands);
+    auto rasterizeBand = [&picture, &pixmap, &props, bandHeight, height](unsigned band) {
+        int top = static_cast<int>(band) * bandHeight;
+        int rows = std::min(bandHeight, height - top);
+        if (rows <= 0)
+            return;
+        auto info = pixmap.info().makeWH(pixmap.width(), rows);
+        // Same surface properties as the real canvas, so text is anti-aliased identically.
+        auto canvas = SkCanvas::MakeRasterDirect(info, const_cast<void*>(pixmap.addr(0, top)), pixmap.rowBytes(), &props);
