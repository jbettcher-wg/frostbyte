+    // Logical (zero-filling) right shift. The 32-bit form relies on the
+    // invariant: srw shifts the whole 64-bit register, so bits 32:63 must
+    // already be zero for the low word to be shifted in isolation. They are,
+    // by construction.
+    void urshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        RegisterID count = maskedShiftCount(shiftAmount, 31, shiftCountScratch(src, dest));
+        m_assembler.srw(dest, src, count);
+        maskLow32(dest);
+    }
+
+    void urshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.srw(dest, src, maskedShiftCount(shiftAmount, 31, scratch));
+        maskLow32(dest);
+    }
+
+    void urshift32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 0x1f;
+        if (!shift) {
+            move(src, dest);
+            return;
+        }
+        m_assembler.srwi(dest, src, shift);
+        maskLow32(dest);
+    }
+
+    void urshift32(TrustedImm32 imm, RegisterID shiftAmount, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(imm, temp.memory());
+        urshift32(temp.memory(), shiftAmount, dest);
+    }
+
+    void urshift32(RegisterID shiftAmount, RegisterID dest) { urshift32(dest, shiftAmount, dest); }
+    void urshift32(TrustedImm32 imm, RegisterID dest) { urshift32(dest, imm, dest); }
+
+    void urshift64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        RegisterID count = maskedShiftCount(shiftAmount, 63, shiftCountScratch(src, dest));
+        m_assembler.srd(dest, src, count);
+    }
+
+    void urshift64(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.srd(dest, src, maskedShiftCount(shiftAmount, 63, scratch));
+    }
+
+    void urshift64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 0x3f;
+        if (!shift) {
+            move(src, dest);
+            return;
+        }
+        m_assembler.srdi(dest, src, shift);
+    }
+
+    void urshift64(RegisterID shiftAmount, RegisterID dest) { urshift64(dest, shiftAmount, dest); }
+    void urshift64(TrustedImm32 imm, RegisterID dest) { urshift64(dest, imm, dest); }
+
+    // d = n + (m >>> amount), 32-bit.
+    void addUnsignedRightShift32(RegisterID n, RegisterID m, TrustedImm32 amount, RegisterID d)
+    {
+        auto temp = temps<Memory>();
+        urshift32(m, amount, temp.memory());
+        add32(n, temp.memory(), d);
+    }
+
+    // Rotates are native on PowerPC, in both widths.
+    void rotateRight32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 31;
+        m_assembler.rotlwi(dest, src, (32 - shift) & 31);
+        maskLow32(dest);
+    }
+
+    void rotateRight32(TrustedImm32 imm, RegisterID srcDst) { rotateRight32(srcDst, imm, srcDst); }
+
+    void rotateRight32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        // Rotating right by n is rotating left by 32 - n. subfic computes
+        // 32 - shiftAmount in one instruction.
+        rotateRight32(src, shiftAmount, dest, shiftCountScratch(src, dest));
+    }
+
+    void rotateRight32(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.subfic(scratch, shiftAmount, 32);
+        m_assembler.andi_(scratch, scratch, 31);
+        m_assembler.rlwnm(dest, src, scratch, 0, 31);
+        maskLow32(dest);
+    }
+
+    void rotateRight64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 63;
+        m_assembler.rotldi(dest, src, (64 - shift) & 63);
+    }
+
+    void rotateRight64(TrustedImm32 imm, RegisterID srcDst) { rotateRight64(srcDst, imm, srcDst); }
+
+    void rotateRight64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        rotateRight64(src, shiftAmount, dest, shiftCountScratch(src, dest));
+    }
+
+    void rotateRight64(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.subfic(scratch, shiftAmount, 64);
+        m_assembler.andi_(scratch, scratch, 63);
+        m_assembler.rldcl(dest, src, scratch, 0);
+    }
+
+    // Rotate LEFT is the native direction on this target -- rlwnm and rldcl
+    // rotate left -- which is why rotateRight above spends a subfic and a
+    // scratch register to turn n into width - n, and why these need neither.
+    // rlwnm reads the low five bits of the shift register and rldcl the low
+    // six, so the count needs no masking either.
+    void rotateLeft32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.rotlwi(dest, src, static_cast<uint32_t>(imm.m_value) & 31);
+        maskLow32(dest);
+    }
+
+    void rotateLeft32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.rlwnm(dest, src, shiftAmount, 0, 31);
+        maskLow32(dest);
+    }
+
+    void rotateLeft64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.rotldi(dest, src, static_cast<uint32_t>(imm.m_value) & 63);
+    }
+
+    void rotateLeft64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.rldcl(dest, src, shiftAmount, 0);
+    }
+
+    // The address-dependency trick B3 uses for consume ordering: XOR a register
+    // with itself is zero, and carries a data dependency on it. ARM64 spells it
+    // eor<32>(dest, src, src); PPC's xor is width-agnostic and the result is
+    // zero either way, so one instruction serves both widths.
+    void depend32(RegisterID src, RegisterID dest) { m_assembler.xor_(dest, src, src); }
+    void depend64(RegisterID src, RegisterID dest) { m_assembler.xor_(dest, src, src); }
+
+    // Lea64 of a base+index. x86-64 needs this form for its addressing modes;
+    // this target needs it because AirLowerStackArgs' extended-offset path
+    // BUILDS one -- POWER's X-form is base+index with no displacement, so a
+    // stack offset too large for D-form is materialised into
+    // extendedOffsetAddrRegister() (r0) and ridden as the INDEX while sp stays
+    // the base. r0 may be an index and never a base, which is why that path
+    // cannot hand back an Arg::addr the way the ARM64 arm does. A 736-byte
+    // frame already exceeds D-form reach for the SP-relative form, so
+    // testStackSlot reaches it with one 1-byte slot.
+    //
+    // Everything stages in dest, which is what makes this safe regardless of
+    // the scratch policy. Arg::isValidScale accepts only scale 1 on this
+    // target, so the scaled branch below is unreachable from Air; it is kept
+    // for any direct caller.
+    void leaIndex64(BaseIndex address, RegisterID dest)
+    {
+        if (address.scale == TimesOne)
+            m_assembler.add(dest, address.base, address.index);
+        else {
+            // Shifting into dest first would clobber base before it is read, and
+            // there is no third register to borrow. Nothing Air builds has both a
+            // scale and dest == base; if that changes this needs a Scratch operand.
+            RELEASE_ASSERT(dest != address.base);
+            m_assembler.sldi(dest, address.index, static_cast<uint32_t>(address.scale));
+            m_assembler.add(dest, address.base, dest);
+        }
+        if (address.offset)
+            addImmediate64(dest, static_cast<int64_t>(address.offset), dest);
+    }
+
+    // ---- loads ----
+    //
+    // Every load comes in three flavours (Address / BaseIndex / raw pointer)
+    // and they all funnel into loadImpl, which picks the D-form (base +
+    // displacement) or X-form (base + index) encoding. POWER8 and later
+    // handle unaligned loads and stores in hardware for all of these widths,
+    // so there is no aligned/unaligned distinction to make -- which is why
+    // load16Unaligned and load32WithUnalignedHalfWords are just the ordinary
+    // loads.
+
+    enum class LoadKind { U8, S8, U16, S16, U32, S32, U64 };
+
+    // POWER's X-form indexed loads and stores are base + index, with no
+    // displacement field and no scaling, which is exactly the shape Air asks
+    // for on this target: Arg::isValidScale accepts only 1 here, and
+    // Arg::isValidIndexForm allows a displacement only for Lea, which
+    // computes an address rather than accessing memory.
+    //
+    // Taking the form still matters for the add it saves. It is no longer a
+    // hard requirement, though: AirGenerate.cpp and
+    // AirAllocateRegistersAndStackAndGenerateCode.cpp both re-enable the macro
+    // scratch under isPPC64() -- r29 and r30 are isReserved, so the allocator
+    // cannot have handed either to a live Tmp -- which is what lets the
+    // Address forms fold an out-of-form displacement through
+    // memoryTempRegister instead of refusing it.
+    //
+    // RA is the base and RB the index, never the other way round: r0 in the RA
+    // field of any load or store encodes the literal zero rather than the
+    // register, which is measured in the handbook and is the whole reason
+    // extendedOffsetAddrRegister() can be r0 at all.
+    //
+    // isXFormBaseIndex is true for exactly the BaseIndex shapes the X-form
+    // encodes directly, which is also exactly the set Air is allowed to build
+    // on this target.
+    static bool isXFormBaseIndex(BaseIndex address)
+    {
+        return address.scale == TimesOne && !address.offset;
+    }
+
+    void emitLoadDForm(LoadKind kind, RegisterID base, int32_t offset, RegisterID dest)
+    {
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbz(dest, base, offset); return;
+        case LoadKind::S8:  m_assembler.lbz(dest, base, offset); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhz(dest, base, offset); return;
+        case LoadKind::S16: m_assembler.lha(dest, base, offset); return;
+        case LoadKind::U32: m_assembler.lwz(dest, base, offset); return;
+        case LoadKind::S32: m_assembler.lwa(dest, base, offset); return;
+        case LoadKind::U64: m_assembler.ld(dest, base, offset); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void emitLoadXForm(LoadKind kind, RegisterID base, RegisterID index, RegisterID dest)
+    {
+        ASSERT(base != PPC64Registers::r0);
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbzx(dest, base, index); return;
+        case LoadKind::S8:  m_assembler.lbzx(dest, base, index); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhzx(dest, base, index); return;
+        case LoadKind::S16: m_assembler.lhax(dest, base, index); return;
+        case LoadKind::U32: m_assembler.lwzx(dest, base, index); return;
+        case LoadKind::S32: m_assembler.lwax(dest, base, index); return;
+        case LoadKind::U64: m_assembler.ldx(dest, base, index); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    static bool loadKindNeedsDSForm(LoadKind kind) { return kind == LoadKind::U64 || kind == LoadKind::S32; }
+
+    void loadImpl(LoadKind kind, Address address, RegisterID dest)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, loadKindNeedsDSForm(kind));
+        emitLoadDForm(kind, resolution.base, resolution.offset, dest);
+    }
+
+    void loadImpl(LoadKind kind, BaseIndex address, RegisterID dest)
+    {
+        if (isXFormBaseIndex(address)) {
+            emitLoadXForm(kind, address.base, address.index, dest);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), loadKindNeedsDSForm(kind));
+        emitLoadDForm(kind, resolution.base, resolution.offset, dest);
+    }
+
+    // Split an absolute address into a base whose low 16 bits are zero and a signed
+    // 16-bit displacement, so the ladder loses its final ori. DS-form accesses need a
+    // displacement that is a multiple of 4; otherwise fall back to displacement 0.
+    static int32_t absoluteDisplacement(const void* pointer, bool requiresDSForm)
+    {
+        int32_t lo = int16_t(reinterpret_cast<uintptr_t>(pointer) & 0xffff);
+        if (requiresDSForm && (lo & 3))
+            return 0;
+        return lo;
+    }
+
+    void loadImpl(LoadKind kind, const void* pointer, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        int32_t lo = absoluteDisplacement(pointer, loadKindNeedsDSForm(kind));
+        loadImmediate(TrustedImm64(reinterpret_cast<intptr_t>(pointer) - lo), temp.memory());
+        emitLoadDForm(kind, temp.memory(), lo, dest);
+    }
+
+    // Cache prefetch hint for base + offset (dcbt). Never faults; base must not be r0.
+    void prefetchRead(RegisterID base, RegisterID offset) { m_assembler.dcbt(base, offset); }
+
+    void load8(Address address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+    void load8(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+    void load8(const void* address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+
+    // "SignedExtendTo32" means the byte is sign-extended into the low word
+    // and the register still satisfies the 32-bit zero-extension invariant,
+    // i.e. bits 32:63 are clear. extsb sign-extends all the way to 64, so the
+    // upper half has to be cleared again afterwards. Missing that would leave
+    // a value that compares correctly with cmpw but boxes into a corrupt
+    // JSValue.
+    void load8SignedExtendTo32(Address address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); maskLow32(dest); }
+    void load8SignedExtendTo32(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); maskLow32(dest); }
+    void load8SignedExtendTo32(const void* address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); maskLow32(dest); }
+
+    void load8SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+    void load8SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+    void load8SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+
+    void load16(Address address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+    void load16(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+    void load16(const void* address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+
+    // As on x86_64 (BaseIndex TimesTwo) and ARM64 (ldrh ..., UXTX #1), the base register
+    // of a 16-bit ExtendedAddress is an INDEX into a uint16_t table at `offset`, so it is
+    // scaled by 2. YARR's case-insensitive backreferences index latin1CanonicalizationTable
+    // this way. dest may be the index register.
+    void load16(ExtendedAddress address, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        RELEASE_ASSERT(dest != temp.memory() && address.base != temp.memory());
+        m_assembler.loadImmediate64(temp.memory(), static_cast<int64_t>(address.offset));
+        m_assembler.sldi(dest, address.base, 1);
+        m_assembler.lhzx(dest, temp.memory(), dest);
+    }
+
+    // POWER8+ does unaligned accesses in hardware; there is nothing to do
+    // differently here.
+    void load16Unaligned(Address address, RegisterID dest) { load16(address, dest); }
+    void load16Unaligned(BaseIndex address, RegisterID dest) { load16(address, dest); }
+
+    void load16SignedExtendTo32(Address address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); maskLow32(dest); }
+    void load16SignedExtendTo32(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); maskLow32(dest); }
+    void load16SignedExtendTo32(const void* address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); maskLow32(dest); }
+
+    void load16SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }
+    void load16SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }
+    void load16SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }
+
+    void load32SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }
+    void load32SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }
+    void load32SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }
+
+    // lwz zero-extends, so load32 satisfies the 32-bit invariant for free.
+    void load32(Address address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }
+    void load32(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }
+    void load32(const void* address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }
+    void load32WithUnalignedHalfWords(BaseIndex address, RegisterID dest) { load32(address, dest); }
+
+    void load64(Address address, RegisterID dest) { loadImpl(LoadKind::U64, address, dest); }
+    void load64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U64, address, dest); }
+    void load64(const void* address, RegisterID dest) { loadImpl(LoadKind::U64, address, dest); }
+    // ---- register pairs ----
+    //
+    // PowerPC has no load-pair instruction (lmw/stmw are 32-bit only and
+    // slow), so these are two accesses. That makes the aliasing question
+    // real, in a way it is not for ARM64's atomic ldp: if the first
+    // destination is also the base register, loading into it first destroys
+    // the address the second load needs. The order is chosen to avoid that.
+    void loadPair64(RegisterID base, TrustedImm32 offset, RegisterID dest1, RegisterID dest2)
+    {
+        Address first(base, offset.m_value);
+        Address second(base, offset.m_value + 8);
+        if (dest1 == base) {
+            load64(second, dest2);
+            load64(first, dest1);
+            return;
+        }
+        load64(first, dest1);
+        load64(second, dest2);
+    }
+
+    void loadPair64(RegisterID base, RegisterID dest1, RegisterID dest2) { loadPair64(base, TrustedImm32(0), dest1, dest2); }
+    void loadPair64(Address address, RegisterID dest1, RegisterID dest2) { loadPair64(address.base, TrustedImm32(address.offset), dest1, dest2); }
+
+    void loadPair32(RegisterID base, TrustedImm32 offset, RegisterID dest1, RegisterID dest2)
+    {
+        Address first(base, offset.m_value);
+        Address second(base, offset.m_value + 4);
+        if (dest1 == base) {
+            load32(second, dest2);
+            load32(first, dest1);
+            return;
+        }
+        load32(first, dest1);
+        load32(second, dest2);
+    }
+
+    void loadPair32(RegisterID base, RegisterID dest1, RegisterID dest2) { loadPair32(base, TrustedImm32(0), dest1, dest2); }
+    void loadPair32(Address address, RegisterID dest1, RegisterID dest2) { loadPair32(address.base, TrustedImm32(address.offset), dest1, dest2); }
+    // ---- stores ----
+
+    enum class StoreKind { S8, S16, S32, S64 };
+
+    void emitStoreDForm(StoreKind kind, RegisterID src, RegisterID base, int32_t offset)
+    {
+        switch (kind) {
+        case StoreKind::S8:  m_assembler.stb(src, base, offset); return;
+        case StoreKind::S16: m_assembler.sth(src, base, offset); return;
+        case StoreKind::S32: m_assembler.stw(src, base, offset); return;
+        case StoreKind::S64: m_assembler.std(src, base, offset); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void emitStoreXForm(StoreKind kind, RegisterID src, RegisterID base, RegisterID index)
+    {
+        ASSERT(base != PPC64Registers::r0);
+        switch (kind) {
+        case StoreKind::S8:  m_assembler.stbx(src, base, index); return;
+        case StoreKind::S16: m_assembler.sthx(src, base, index); return;
+        case StoreKind::S32: m_assembler.stwx(src, base, index); return;
+        case StoreKind::S64: m_assembler.stdx(src, base, index); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    static bool storeKindNeedsDSForm(StoreKind kind) { return kind == StoreKind::S64; }
+
+    void storeImpl(StoreKind kind, RegisterID src, Address address)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, storeKindNeedsDSForm(kind));
+        emitStoreDForm(kind, src, resolution.base, resolution.offset);
+    }
+
+    void storeImpl(StoreKind kind, RegisterID src, BaseIndex address)
+    {
+        if (isXFormBaseIndex(address)) {
+            emitStoreXForm(kind, src, address.base, address.index);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), storeKindNeedsDSForm(kind));
+        emitStoreDForm(kind, src, resolution.base, resolution.offset);
+    }
+
+    void storeImpl(StoreKind kind, RegisterID src, const void* pointer)
+    {
+        auto temp = temps<Memory>();
+        int32_t lo = absoluteDisplacement(pointer, storeKindNeedsDSForm(kind));
+        loadImmediate(TrustedImm64(reinterpret_cast<intptr_t>(pointer) - lo), temp.memory());
+        emitStoreDForm(kind, src, temp.memory(), lo);
+    }
+
+    // Storing an immediate always goes through the data temp. The memory temp
+    // is reserved for the address, so the two never collide -- that pairing is
+    // the whole reason there are two of them.
+    template<typename ImmType, typename AddressType>
+    void storeImmImpl(StoreKind kind, ImmType imm, AddressType address)
+    {
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        storeImpl(kind, temp.data(), address);
+    }
+
