+/*
+ * Copyright (C) 2026 Leopard/ppc64 port. Same license as the rest of WebCore.
+ */
+
+#include "config.h"
+#include "BytecodeCacheFile.h"
+
+#include <cerrno>
+#include <algorithm>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace WebCore::BytecodeCacheFile {
+
+namespace {
+
+// "FBJSBC" + format version 1. Native byte order: a cache directory is never shared between
+// machines, and the JSC build id in the file name already pins the architecture.
+constexpr uint64_t trailerMagic = 0x46424a5342430001ull;
+
+struct Trailer {
+    uint64_t magic;
+    uint64_t payloadSize;
+    uint64_t checksum;
+    uint64_t check; // ties the three fields together, so a torn trailer is caught on its own
+};
+static_assert(sizeof(Trailer) == 32);
+
+constexpr uint64_t multiplier = 0x9e3779b97f4a7c15ull;
+
+uint64_t rotate(uint64_t value, unsigned bits)
+{
+    return (value << bits) | (value >> (64 - bits));
+}
+
+uint64_t mix(uint64_t value)
+{
+    value ^= value >> 33;
+    value *= 0xff51afd7ed558ccdull;
+    value ^= value >> 33;
+    value *= 0xc4ceb9fe1a85ec53ull;
+    value ^= value >> 33;
+    return value;
+}
+
+uint64_t trailerCheck(uint64_t magic, uint64_t payloadSize, uint64_t checksum)
+{
+    return mix(magic ^ mix(payloadSize + multiplier) ^ rotate(checksum, 29));
+}
+
+bool readFully(int fd, uint64_t offset, uint8_t* buffer, size_t size)
+{
+    while (size) {
+        ssize_t result = pread(fd, buffer, size, static_cast<off_t>(offset));
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        buffer += result;
+        offset += static_cast<uint64_t>(result);
+        size -= static_cast<size_t>(result);
+    }
+    return true;
+}
+
+bool writeFully(int fd, const uint8_t* data, size_t size)
+{
+    while (size) {
+        ssize_t result = write(fd, data, size);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        data += result;
+        size -= static_cast<size_t>(result);
+    }
+    return true;
+}
+
+Identity identityOf(const struct stat& status)
+{
+    return { static_cast<uint64_t>(status.st_dev), static_cast<uint64_t>(status.st_ino) };
+}
+
+} // namespace
+
+void Checksum::block(const uint8_t* data)
+{
+    for (unsigned lane = 0; lane < 4; ++lane) {
+        uint64_t word;
+        memcpy(&word, data + lane * 8, 8);
+        m_lanes[lane] = rotate((m_lanes[lane] ^ word) * multiplier, 31);
+    }
+}
+
+void Checksum::update(std::span<const uint8_t> data)
+{
+    const uint8_t* bytes = data.data();
+    size_t size = data.size();
+    m_length += size;
+    if (m_tailSize) {
+        size_t take = std::min(size, sizeof(m_tail) - m_tailSize);
+        memcpy(m_tail + m_tailSize, bytes, take);
+        m_tailSize += take;
+        bytes += take;
+        size -= take;
+        if (m_tailSize < sizeof(m_tail))
+            return;
+        block(m_tail);
+        m_tailSize = 0;
+    }
+    for (; size >= sizeof(m_tail); bytes += sizeof(m_tail), size -= sizeof(m_tail))
+        block(bytes);
+    memcpy(m_tail, bytes, size);
+    m_tailSize = size;
+}
+
+uint64_t Checksum::finish() const
+{
+    Checksum copy = *this;
+    if (copy.m_tailSize) {
+        memset(copy.m_tail + copy.m_tailSize, 0, sizeof(copy.m_tail) - copy.m_tailSize);
+        copy.block(copy.m_tail);
+    }
+    uint64_t result = mix(m_length);
+    for (unsigned lane = 0; lane < 4; ++lane)
+        result = mix(result ^ rotate(copy.m_lanes[lane], 7 + lane * 16));
+    return result;
+}
+
+std::optional<Identity> identityOfPath(const char* path)
+{
+    struct stat status;
+    if (stat(path, &status))
+        return std::nullopt;
+    return identityOf(status);
+}
+
+bool unlinkIfSame(const char* path, const Identity& identity)
+{
+    if (identityOfPath(path) != identity)
+        return false;
+    return !unlink(path);
+}
+
+Validation openValidated(const char* path, ValidatedFile& file)
+{
+    file = { };
+    int fd = ::open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return errno == ENOENT ? Validation::Missing : Validation::Invalid;
+
+    auto valid = [&]() -> bool {
+        struct stat status;
+        if (fstat(fd, &status) || !S_ISREG(status.st_mode))
+            return false;
+        file.identity = identityOf(status);
+        if (status.st_size < static_cast<off_t>(sizeof(Trailer)))
+            return false;
+        uint64_t payloadSize = static_cast<uint64_t>(status.st_size) - sizeof(Trailer);
+        Trailer trailer;
+        if (!readFully(fd, payloadSize, reinterpret_cast<uint8_t*>(&trailer), sizeof(trailer)))
+            return false;
+        if (trailer.magic != trailerMagic || trailer.payloadSize != payloadSize || !payloadSize
+            || trailer.check != trailerCheck(trailer.magic, trailer.payloadSize, trailer.checksum))
+            return false;
+
+        constexpr size_t chunkSize = 256 * 1024;
+        static std::unique_ptr<uint8_t[]> buffer { new uint8_t[chunkSize] }; // main thread only
+        Checksum checksum;
+        for (uint64_t offset = 0; offset < payloadSize; ) {
+            size_t size = static_cast<size_t>(std::min<uint64_t>(chunkSize, payloadSize - offset));
+            if (!readFully(fd, offset, buffer.get(), size))
+                return false;
+            checksum.update({ buffer.get(), size });
+            offset += size;
+        }
+        if (checksum.finish() != trailer.checksum)
+            return false;
+        file.payloadSize = payloadSize;
+        return true;
+    };
+
+    if (valid()) {
+        file.fd = fd;
+        return Validation::Valid;
+    }
+    ::close(fd);
+    if (file.identity.inode)
+        unlinkIfSame(path, file.identity);
+    file = { };
+    return Validation::Invalid;
+}
+
+Writer::Writer(std::string finalPath)
+    : m_finalPath(std::move(finalPath))
+{
+}
+
+Writer::~Writer()
+{
+    close();
+    if (!m_renamed && !m_temporaryPath.empty())
+        unlink(m_temporaryPath.c_str());
+}
+
+bool Writer::open()
+{
+    m_temporaryPath = m_finalPath + "." + std::to_string(getpid()) + ".tmp";
+    m_fd = ::open(m_temporaryPath.c_str(), O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, S_IRUSR | S_IWUSR);
+    return m_fd >= 0;
+}
+
+bool Writer::append(std::span<const uint8_t> data)
+{
+    if (m_fd < 0 || m_failed)
+        return false;
+    if (!writeFully(m_fd, data.data(), data.size())) {
+        m_failed = true;
+        return false;
+    }
+    m_checksum.update(data);
+    m_payloadSize += data.size();
+    return true;
+}
+
+Writer::Result Writer::commit(const std::optional<Identity>& expected)
+{
+    if (m_fd < 0 || m_failed || !m_payloadSize)
+        return Result::Failed;
+    Trailer trailer { trailerMagic, m_payloadSize, m_checksum.finish(), 0 };
+    trailer.check = trailerCheck(trailer.magic, trailer.payloadSize, trailer.checksum);
+    if (!writeFully(m_fd, reinterpret_cast<const uint8_t*>(&trailer), sizeof(trailer)))
+        return Result::Failed;
+    // Not atomic with the rename, but losing that race only means one of two complete
+    // versions wins.
+    if (identityOfPath(m_finalPath.c_str()) != expected)
+        return Result::Changed;
+    if (rename(m_temporaryPath.c_str(), m_finalPath.c_str()))
+        return Result::Failed;
+    m_renamed = true;
+    return Result::Committed;
+}
+
+Identity Writer::identity() const
+{
+    struct stat status;
+    if (m_fd < 0 || fstat(m_fd, &status))
+        return { };
+    return identityOf(status);
+}
+
+void Writer::close()
+{
+    if (m_fd >= 0)
+        ::close(m_fd);
+    m_fd = -1;
+}
+
+} // namespace WebCore::BytecodeCacheFile
