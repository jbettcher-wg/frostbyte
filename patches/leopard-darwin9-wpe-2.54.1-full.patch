+
+    template<typename AddressType>
+    void load64ByteReversed(AddressType address, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+#if !LEOPARD_PPC64_ISA206
+        // PowerPC 970: no ldbrx. Two lwbrx: the word at +4 reversed is the
+        // high half, the word at +0 reversed the low half. Only r0 and the
+        // memory temp are used, because loadDoubleByteReversed hands its data
+        // temp in as dest. addr is never r0 (base registers never are), and
+        // dest may alias it: it is read before dest is written.
+        RegisterID addr = byteReversedAddress(address, temp.memory());
+        m_assembler.addi(PPC64Registers::r0, addr, 4);
+        m_assembler.lwbrx(PPC64Registers::r0, PPC64Registers::r0, PPC64Registers::r0);
+        m_assembler.lwbrx(dest, PPC64Registers::r0, addr);
+        m_assembler.rldimi(dest, PPC64Registers::r0, 32, 0);
+#else
+        auto x = byteReversedXForm(address, temp.memory());
+        m_assembler.ldbrx(dest, x.ra, x.rb);
+#endif
+    }
+
+    template<typename AddressType>
+    void store16ByteReversed(RegisterID src, AddressType address)
+    {
+        auto temp = temps<Memory>();
+        auto x = byteReversedXForm(address, temp.memory());
+        m_assembler.sthbrx(src, x.ra, x.rb);
+    }
+
+    template<typename AddressType>
+    void store32ByteReversed(RegisterID src, AddressType address)
+    {
+        auto temp = temps<Memory>();
+        auto x = byteReversedXForm(address, temp.memory());
+        m_assembler.stwbrx(src, x.ra, x.rb);
+    }
+
+    template<typename AddressType>
+    void store64ByteReversed(RegisterID src, AddressType address)
+    {
+        auto temp = temps<Memory>();
+#if !LEOPARD_PPC64_ISA206
