--- a/Source/WebCore/bindings/js/BytecodeCacheFile.h	1969-12-31 17:00:00.000000000 -0700
+++ b/Source/WebCore/bindings/js/BytecodeCacheFile.h	2026-11-11 00:02:27.311580511 -0600
@@ -0,0 +1,101 @@
+/*
+ * Copyright (C) 2026 Leopard/ppc64 port. Same license as the rest of WebCore.
+ */
+
+#pragma once
+
+// On-disk format and file handling for CachedScriptSourceProvider's JSC bytecode cache.
+// Plain POSIX and the standard library only (no WTF), so tests/bytecode-cache-harness can build
+// it on the host and kill writers at random points.
+//
+// A cache file is never modified once it has its final name:
+//   [JSC payload: payloadSize bytes][Trailer: 32 bytes]
+// - Writer: the whole new file goes to "<name>.<pid>.tmp", then the trailer (payload size and
+//   checksum), then rename(2) over <name>. A writer that dies at any point leaves only a .tmp
+//   file (the embedder removes those at startup); readers see the old file or the new one.
+// - Readers validate the trailer, the file size and the payload checksum before mapping the
+//   payload, so a damaged file (a panic before the data reached the disk, a foreign file) is
+//   deleted and rebuilt, never decoded. No fsync: a file the kernel lost after a panic fails
+//   the checksum, which costs one cache miss.
+// - Since files never change in place, a reader's MAP_PRIVATE mapping is a true snapshot. (The
+//   previous in-place appends showed other processes' patched offsets inside live mappings.)
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+
+namespace WebCore::BytecodeCacheFile {
+
+struct Identity {
+    uint64_t device { 0 };
+    uint64_t inode { 0 };
+    friend bool operator==(const Identity&, const Identity&) = default;
+};
+
+// Streaming 64-bit checksum (four multiply-xor lanes); the result does not depend on how the
+// data is split into update() calls. Detects damage, not tampering: the directory is private.
+class Checksum {
+public:
+    void update(std::span<const uint8_t>);
+    uint64_t finish() const;
+
+private:
+    void block(const uint8_t*);
+
+    uint64_t m_lanes[4] { 0x243f6a8885a308d3ull, 0x13198a2e03707344ull, 0xa4093822299f31d0ull, 0x082efa98ec4e6c89ull };
+    uint8_t m_tail[32] { };
+    size_t m_tailSize { 0 };
+    uint64_t m_length { 0 };
+};
+
+enum class Validation : uint8_t { Missing, Invalid, Valid };
+
+struct ValidatedFile {
+    int fd { -1 };
+    uint64_t payloadSize { 0 };
+    Identity identity;
+};
+
+// Opens and fully validates path. Valid: file.fd is open (the caller maps payloadSize bytes and
+// closes it). Invalid: the file has already been unlinked (if path still names it).
+Validation openValidated(const char* path, ValidatedFile&);
+
+// The identity of the file path names now, or nullopt if there is none.
+std::optional<Identity> identityOfPath(const char* path);
+
+// Unlinks path only if it still names the file with this identity (not a newer one that
+// another process renamed into place).
+bool unlinkIfSame(const char* path, const Identity&);
+
+class Writer {
+public:
+    explicit Writer(std::string finalPath);
+    ~Writer(); // removes the temporary file unless commit() renamed it
+
+    bool open();
+    bool append(std::span<const uint8_t>);
+
+    enum class Result : uint8_t { Committed, Changed, Failed };
+    // Writes the trailer and renames the file over the final path, if the final path still
+    // names `expected` (nullopt: no file). Changed: another process replaced it meanwhile.
+    Result commit(const std::optional<Identity>& expected);
+
+    // After Committed: the new file, open read-write, and its payload size and identity.
+    int fd() const { return m_fd; }
+    uint64_t payloadSize() const { return m_payloadSize; }
+    Identity identity() const;
+    void close();
+
+private:
+    std::string m_finalPath;
+    std::string m_temporaryPath;
+    int m_fd { -1 };
+    uint64_t m_payloadSize { 0 };
+    Checksum m_checksum;
+    bool m_failed { false };
+    bool m_renamed { false };
+};
+
+} // namespace WebCore::BytecodeCacheFile
diff -ruN --no-dereference -x __pycache__ a/Source/WebCore/bindings/js/CachedScriptSourceProvider.cpp b/Source/WebCore/bindings/js/CachedScriptSourceProvider.cpp
--- a/Source/WebCore/bindings/js/CachedScriptSourceProvider.cpp	1969-12-31 17:00:00.000000000 -0700
+++ b/Source/WebCore/bindings/js/CachedScriptSourceProvider.cpp	2026-11-11 00:14:17.559496570 -0600
@@ -0,0 +1,346 @@
+/*
+ * Copyright (C) 2026 Leopard/ppc64 port. Same license as the rest of WebCore.
+ */
+
+#include "config.h"
+#include "CachedScriptSourceProvider.h"
+
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/HeapCellInlines.h>
+#include <JavaScriptCore/JSCBytecodeCacheVersion.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <JavaScriptCore/VM.h>
+#include <wtf/FileHandle.h>
+#include <wtf/FileSystem.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/Vector.h>
+#include <wtf/Scope.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/HexNumber.h>
+#include <wtf/MmapSpan.h>
+#include <wtf/StdLibExtras.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace WebCore {
+
+// The same idea as the jsc shell's ShellSourceProvider (--diskCachePath), keyed per
+// JavaScriptCore build, script host and source hash:
+// - Load: the file is validated (trailer, size, checksum; BytecodeCacheFile.h) and its payload
+//   mapped privately. JSC then rejects it on decode if the JavaScriptCore build id, the source
+//   hash/length or the full source text differ, so a stale, foreign or damaged file is deleted
+//   and rebuilt, never trusted.
+// - Save, from a script's second sighting on (the first visit only leaves a marker file,
+//   because encoding costs that visit up to ~30 %): top-level code is added when it is
+//   generated, each lazily compiled function when it is compiled. Pending updates are
+//   committed at increasing intervals while the script stays loaded and when the provider goes
+//   away (see scheduleBytecodeCommit()). A commit writes the whole new file under a temporary
+//   name and renames it over the old one, and only if the file is still the one this provider
+//   mapped. Files never change in place, so a process killed mid-commit (a tab closed mid-load)
+//   or two processes committing the same script at once can't leave a torn file, and other
+//   processes' mappings stay snapshots. (The previous in-place appends relied on flock(), which
+//   WTF::FileHandle does not check: concurrent commits interleaved and left offsets pointing at
+//   another writer's data, which every later visit decoded. docs/cache-robustness.md.)
+// The directory must be private to the user: decoded bytecode is trusted once it passes
+// the checks above. Files larger than 128 MB are not written. Nothing evicts old files;
+// whoever sets the variable owns the directory (FrostByte clears it on a size limit and removes
+// leftover "*.tmp" files at startup).
+// Measured on a T4240 with Discord's 12.5 MB bundle in the jsc shell: top-level load
+// 2.5 s -> 0.65 s, module compilation 4.8 s -> 3.3 s on the second visit.
+
+static constexpr size_t maximumBytecodeCacheFileSize = 128 * MB;
+
+// WEBKIT_JSC_BYTECODE_CACHE_LOG=1 prints each cache decision to stderr.
+static bool bytecodeCacheLogging()
+{
+    static const bool enabled = [] {
+        const char* value = getenv("WEBKIT_JSC_BYTECODE_CACHE_LOG");
+        return value && *value && *value != '0';
+    }();
+    return enabled;
+}
+
+#define BYTECODE_CACHE_LOG(fmt, ...) do { \
+    if (bytecodeCacheLogging()) [[unlikely]] \
+        fprintf(stderr, "bytecode-cache: " fmt "\n", __VA_ARGS__); \
+} while (0)
+
+const String& CachedScriptSourceProvider::bytecodeCacheDirectory()
+{
+    static NeverDestroyed<String> directory = [] {
+        const char* value = getenv("WEBKIT_JSC_BYTECODE_CACHE_DIR");
+        if (!value || !*value)
+            return String();
+        // The JavaScriptCore build identity (LC_UUID on Darwin, GNU build-id on ELF). JSC
+        // also checks it on decode; without one a rebuilt WebKit could not tell its own
+        // files from an older build's, so caching stays off.
+        if (!JSC::computeJSCBytecodeCacheVersion())
+            return String();
+        String path = String::fromUTF8(value);
+        if (!FileSystem::makeAllDirectories(path))
+            return String();
+        return path;
+    }();
+    return directory.get();
+}
+
+String CachedScriptSourceProvider::bytecodeCachePath() const
+{
+    // <JSC build version>-<host hash>-<source hash>.jsbc. The host and the source are what
+    // JSC's SourceCodeKey compares (plus the full text, checked on decode), not the full
+    // URL: bundles such as YouTube's carry a per-request token in their URL, which would
+    // make every load a first sighting. A new WebKit build never opens an older build's
+    // files (they are left for the embedder's eviction).
+    String host = sourceOrigin().url().host().toString();
+    return FileSystem::pathByAppendingComponent(bytecodeCacheDirectory(), makeString(hex(JSC::computeJSCBytecodeCacheVersion(), 8), '-', hex(host.isEmpty() ? 0u : host.hash(), 8), '-', hex(hash(), 8), ".jsbc"_s));
+}
+
+// Maps the payload of a validated cache file (the trailer stays outside the mapping).
+static std::optional<FileSystem::MappedFileData> mapCacheFilePayload(int fd, uint64_t payloadSize)
+{
+    size_t size;
+    if (!WTF::convertSafely(payloadSize, size) || !size)
+        return std::nullopt;
+    auto mapping = MmapSpan<uint8_t>::mmap(nullptr, size, PROT_READ, MAP_FILE | MAP_PRIVATE, fd);
+    if (!mapping.span().data())
+        return std::nullopt;
+    return FileSystem::MappedFileData { WTF::move(mapping) };
+}
+
+RefPtr<JSC::CachedBytecode> CachedScriptSourceProvider::cachedBytecode() const
+{
+    if (!m_bytecodeCacheEnabled)
+        return nullptr;
+    if (!m_cachedBytecode && !m_triedLoadingBytecode) {
+        m_triedLoadingBytecode = true;
+        String path = bytecodeCachePath();
+        if (path.isNull())
+            return nullptr;
+        CString fileSystemPath = FileSystem::fileSystemRepresentation(path);
+        BytecodeCacheFile::ValidatedFile file;
+        switch (BytecodeCacheFile::openValidated(fileSystemPath.data(), file)) {
+        case BytecodeCacheFile::Validation::Missing: {
+            // No cache file yet. Encoding every function as it is compiled costs the first
+            // visit up to ~30 % (YouTube's 9.7 MB bundle: 3.5 s -> 4.4 s), so a script is only
+            // cached from its second sighting: the first visit leaves an empty marker file.
+            String marker = makeString(path, ".seen"_s);
+            if (FileSystem::fileExists(marker)) {
+                m_writeBytecodeThisVisit = true;
+                BYTECODE_CACHE_LOG("second sighting, writing: %s", sourceURL().utf8().data());
+            } else {
+                FileSystem::openFile(marker, FileSystem::FileOpenMode::ReadWrite, FileSystem::FileAccessPermission::User);
+                BYTECODE_CACHE_LOG("first sighting: %s", sourceURL().utf8().data());
+            }
+            return nullptr;
+        }
+        case BytecodeCacheFile::Validation::Invalid:
+            // Damaged or not ours (already deleted): build a new one this visit.
+            m_writeBytecodeThisVisit = true;
+            BYTECODE_CACHE_LOG("invalid file discarded: %s", sourceURL().utf8().data());
+            return nullptr;
+        case BytecodeCacheFile::Validation::Valid:
+            break;
+        }
+        m_writeBytecodeThisVisit = true;
+        auto mappedFileData = mapCacheFilePayload(file.fd, file.payloadSize);
+        ::close(file.fd);
+        if (!mappedFileData)
+            return nullptr;
+        m_cacheFileIdentity = file.identity;
+        m_cachedBytecode = JSC::CachedBytecode::create(WTF::move(*mappedFileData));
+        BYTECODE_CACHE_LOG("loaded %zu bytes: %s", m_cachedBytecode->size(), sourceURL().utf8().data());
+    }
+    return m_cachedBytecode.copyRef();
+}
+
+void CachedScriptSourceProvider::stopCachingBytecode() const
+{
+    m_cachedBytecode = nullptr;
+    m_cacheFileIdentity = std::nullopt;
+}
+
+void CachedScriptSourceProvider::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    if (!m_bytecodeCacheEnabled || !m_writeBytecodeThisVisit)
+        return;
+    auto update = generator();
+    if (!update) {
+        BYTECODE_CACHE_LOG("top-level encode failed: %s", sourceURL().utf8().data());
+        return;
+    }
+    // JSC only regenerates top-level code it could not decode, so a loaded file that gets
+    // here was rejected (another build or source, different flags). Appending would keep
+    // the rejected entry at offset 0: start a new file. Only our file is deleted; a newer one
+    // that another process renamed into place stays (and this provider's commit then backs off).
+    if (m_cachedBytecode && m_cachedBytecode->size()) {
+        BYTECODE_CACHE_LOG("cached file rejected, replacing: %s", sourceURL().utf8().data());
+        String path = bytecodeCachePath();
+        if (path.isNull()) {
+            stopCachingBytecode();
+            return;
+        }
+        if (m_cacheFileIdentity)
+            BytecodeCacheFile::unlinkIfSame(FileSystem::fileSystemRepresentation(path).data(), *m_cacheFileIdentity);
+        stopCachingBytecode();
+    }
+    // Only now: function updates need the leaf executables this top-level entry records.
+    if (!m_cachedBytecode)
+        m_cachedBytecode = JSC::CachedBytecode::create();
+    m_cachedBytecode->addGlobalUpdate(*update);
+    scheduleBytecodeCommit();
+}
+
+void CachedScriptSourceProvider::updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    if (!m_bytecodeCacheEnabled || !m_cachedBytecode || !m_cachedBytecode->leafExecutables().contains(executable))
+        return;
+    JSC::BytecodeCacheError error;
+    RefPtr<JSC::CachedBytecode> cachedBytecode = JSC::encodeFunctionCodeBlock(executable->vm(), codeBlock, error);
+    if (!cachedBytecode || error.isValid())
+        return;
+    // False if the leaf entry was stale (see CachedBytecode::addFunctionUpdate()).
+    if (!m_cachedBytecode->addFunctionUpdate(executable, kind, *cachedBytecode)) {
+        BYTECODE_CACHE_LOG("stale leaf executable entry, function not cached: %s", sourceURL().utf8().data());
+        return;
+    }
+    scheduleBytecodeCommit();
+}
+
+// A script that stays loaded (a long-lived page's main bundle) may never see its provider
+// destroyed before the process exits, so pending updates are written 20 s after the first
+// one, then (if more arrive) 40 s, 80 s, ... after each write, up to every 5 minutes, and
+// at destruction. Each write carries what was compiled since the previous one (see
+// the end of commitCachedBytecode()), so code first run late in a visit is cached too:
+// a single write per visit missed everything Discord compiles between 20 s and 60 s, and
+// warm visits spent ~70 % of their lazy compile time parsing it again.
+void CachedScriptSourceProvider::scheduleBytecodeCommit() const
+{
+    if (m_bytecodeCommitScheduled)
+        return;
+    m_bytecodeCommitScheduled = true;
+    RunLoop::mainSingleton().dispatchAfter(m_bytecodeCommitDelay, [protectedThis = Ref { *this }] {
+        protectedThis->m_bytecodeCommitScheduled = false;
+        protectedThis->m_bytecodeCommitDelay = std::min(protectedThis->m_bytecodeCommitDelay * 2, 300_s);
+        protectedThis->commitCachedBytecode();
+    });
+}
+
+void CachedScriptSourceProvider::commitCachedBytecode() const
+{
+    if (!m_bytecodeCacheEnabled || !m_cachedBytecode || !m_cachedBytecode->hasUpdates())
+        return;
+
+    // Any failure stops caching this script for the rest of the visit.
+    auto stopCaching = makeScopeExit([&] {
+        stopCachingBytecode();
+    });
+
+    if (m_cachedBytecode->sizeForUpdate() > maximumBytecodeCacheFileSize) {
+        BYTECODE_CACHE_LOG("not written, %zu bytes is over the size cap: %s", m_cachedBytecode->sizeForUpdate(), sourceURL().utf8().data());
+        return;
+    }
+
+    String path = bytecodeCachePath();
+    if (path.isNull())
+        return;
+    CString fileSystemPath = FileSystem::fileSystemRepresentation(path);
+    if (BytecodeCacheFile::identityOfPath(fileSystemPath.data()) != m_cacheFileIdentity) {
+        // Another process replaced or removed the file since we mapped it (or wrote one first).
+        BYTECODE_CACHE_LOG("not written, file changed underneath: %s", sourceURL().utf8().data());
+        return;
+    }
+
+    // The new file is the mapped payload, then each update's payload, with JSC's patches (code
+    // block offsets and metadata of executables that got code) applied on the way out.
+    // commitUpdates() reports payloads in file order at the running end offset; every patch
+    // targets bytes before the payload it precedes.
+    struct Patch {
+        uint64_t offset;
+        Vector<uint8_t> data;
+    };
+    struct Segment {
+        std::span<const uint8_t> bytes;
+    };
+    Vector<Segment> segments;
+    Vector<Patch> patches;
+    uint64_t end = m_cachedBytecode->size();
+    if (end)
+        segments.append({ m_cachedBytecode->span() });
+    bool patchesInRange = true;
+    m_cachedBytecode->commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (static_cast<uint64_t>(offset) == end) {
+            segments.append({ data }); // owned by m_cachedBytecode's pending updates
+            end += data.size();
+            return;
+        }
+        if (offset < 0 || static_cast<uint64_t>(offset) + data.size() > end)
+            patchesInRange = false;
+        patches.append({ static_cast<uint64_t>(offset), Vector<uint8_t>(data) });
+    });
+    if (!patchesInRange || end != m_cachedBytecode->sizeForUpdate()) {
+        BYTECODE_CACHE_LOG("not written, inconsistent update layout: %s", sourceURL().utf8().data());
+        return;
+    }
+    // Stable: for two patches of one field (a function compiled twice), the later one wins.
+    std::ranges::stable_sort(patches, { }, &Patch::offset);
+
+    BytecodeCacheFile::Writer writer(fileSystemPath.data());
+    if (!writer.open()) {
+        BYTECODE_CACHE_LOG("not written, cannot create the temporary file: %s", sourceURL().utf8().data());
+        return;
+    }
+    constexpr size_t chunkSize = 1 * MB;
+    Vector<uint8_t> chunk;
+    size_t firstPatch = 0;
+    uint64_t position = 0;
+    bool wroteEverything = true;
+    for (auto& segment : segments) {
+        for (size_t done = 0; done < segment.bytes.size() && wroteEverything; ) {
+            auto piece = segment.bytes.subspan(done, std::min(chunkSize, segment.bytes.size() - done));
+            uint64_t pieceStart = position;
+            uint64_t pieceEnd = position + piece.size();
+            while (firstPatch < patches.size() && patches[firstPatch].offset + patches[firstPatch].data.size() <= pieceStart)
+                ++firstPatch;
+            bool patched = false;
+            for (size_t i = firstPatch; i < patches.size() && patches[i].offset < pieceEnd; ++i) {
+                auto& patch = patches[i];
+                uint64_t from = std::max(pieceStart, patch.offset);
+                uint64_t to = std::min(pieceEnd, patch.offset + patch.data.size());
