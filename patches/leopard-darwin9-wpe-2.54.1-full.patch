+// Software prefetch for the forward streaming scans below (string search, find).
+// PowerPC cores up to the e6500 have no L1 stream prefetcher worth the name: a
+// 16-byte-per-step AltiVec scan over 4 KB strings measured 0.59 ns/byte from L2
+// and 1.8 ns/byte from DRAM on the e6500, and 0.45 / 0.59 with a `dcbt` 256 bytes
+// ahead (tests/jsc-perf/probes/pfprobe.c). `dcbt` is in every PowerPC, never
+// faults, and is nearly free where a hardware prefetcher already covers it (G5).
+// Build option: -DWTF_SOFTWARE_STREAM_PREFETCH=0 turns it off.
+#if !defined(WTF_SOFTWARE_STREAM_PREFETCH)
+#if CPU(PPC64) || CPU(PPC)
+#define WTF_SOFTWARE_STREAM_PREFETCH 1
+#else
+#define WTF_SOFTWARE_STREAM_PREFETCH 0
+#endif
+#endif
+
 namespace WTF::SIMD {
 
+static constexpr size_t streamPrefetchDistance = 256;
+
+ALWAYS_INLINE void prefetchStream(const void* pointer)
+{
+#if WTF_SOFTWARE_STREAM_PREFETCH
+    // Integer arithmetic: the target may lie past the end of the buffer, which dcbt ignores.
+    __builtin_prefetch(reinterpret_cast<const void*>(reinterpret_cast<uintptr_t>(pointer) + streamPrefetchDistance));
+#else
+    UNUSED_PARAM(pointer);
+#endif
