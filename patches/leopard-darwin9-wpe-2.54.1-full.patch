+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r12]) == PROBE_CPU_R12_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r13]) == PROBE_CPU_R13_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r14]) == PROBE_CPU_R14_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r15]) == PROBE_CPU_R15_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r16]) == PROBE_CPU_R16_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r17]) == PROBE_CPU_R17_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r18]) == PROBE_CPU_R18_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r19]) == PROBE_CPU_R19_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r20]) == PROBE_CPU_R20_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r21]) == PROBE_CPU_R21_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r22]) == PROBE_CPU_R22_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r23]) == PROBE_CPU_R23_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r24]) == PROBE_CPU_R24_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r25]) == PROBE_CPU_R25_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r26]) == PROBE_CPU_R26_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r27]) == PROBE_CPU_R27_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r28]) == PROBE_CPU_R28_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r29]) == PROBE_CPU_R29_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r30]) == PROBE_CPU_R30_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.gprs[PPC64Registers::r31]) == PROBE_CPU_R31_OFFSET);
+
+static_assert(PROBE_OFFSETOF(cpu.sprs[PPC64Registers::pc]) == PROBE_CPU_PC_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.sprs[PPC64Registers::lr]) == PROBE_CPU_LR_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.sprs[PPC64Registers::ctr]) == PROBE_CPU_CTR_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.sprs[PPC64Registers::cr]) == PROBE_CPU_CR_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.sprs[PPC64Registers::xer]) == PROBE_CPU_XER_OFFSET);
+
+static_assert(PROBE_OFFSETOF(cpu.fprs.fprs[PPC64Registers::f0]) == PROBE_CPU_F0_OFFSET);
+static_assert(PROBE_OFFSETOF(cpu.fprs.fprs[PPC64Registers::f31]) == PROBE_CPU_F31_OFFSET);
+
+static_assert(sizeof(Probe::State) == PROBE_SIZE);
+
+#undef PROBE_OFFSETOF
+
+#define PROBE_ALIGNED_STACK_SIZE (PROBE_SIZE + PROBE_SAVED_RETURN_PC_SIZE)
+static_assert(!(PROBE_ALIGNED_STACK_SIZE & 0xf));
+
+// ELFv2's linkage area: the 32 bytes at 0(r1) that belong to any function
+// this frame calls (back chain, CR save, LR save at 16, TOC save at 24).
+#if OS(DARWIN)
+// Darwin ppc64: 48-byte linkage area plus the 64-byte parameter save area.
+#define LINKAGE_AREA_SIZE 112
+#else
+#define LINKAGE_AREA_SIZE 32
+#endif
+
+// What MacroAssembler::probe() spills at the probe site so that the
+// trampoline has scratch registers and can recover what the call destroyed.
+// r0 and r12 are in here because the trampoline needs two free registers
+// before it has saved anything, and on this port BOTH are live values at a
+// probe site: r12 is t9 / GPRInfo::handlerGPR, and r0 is a legitimate holder
+// of a value even though it cannot be used as a base register.
+struct IncomingProbeRecord {
+    UCPURegister lr;
+    UCPURegister ctr;
+    UCPURegister r0;
+    UCPURegister r12;
+    UCPURegister r25;
+    UCPURegister r26;
+    UCPURegister r27;
+    UCPURegister padding;
+};
+
+#define IN_LR_OFFSET  (0 * GPREG_SIZE)
+#define IN_CTR_OFFSET (1 * GPREG_SIZE)
+#define IN_R0_OFFSET  (2 * GPREG_SIZE)
+#define IN_R12_OFFSET (3 * GPREG_SIZE)
+#define IN_R25_OFFSET (4 * GPREG_SIZE)
+#define IN_R26_OFFSET (5 * GPREG_SIZE)
+#define IN_R27_OFFSET (6 * GPREG_SIZE)
+#define IN_SIZE       (8 * GPREG_SIZE)
+
+static_assert(offsetof(IncomingProbeRecord, lr) == IN_LR_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, ctr) == IN_CTR_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, r0) == IN_R0_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, r12) == IN_R12_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, r25) == IN_R25_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, r26) == IN_R26_OFFSET);
+static_assert(offsetof(IncomingProbeRecord, r27) == IN_R27_OFFSET);
+static_assert(sizeof(IncomingProbeRecord) == IN_SIZE);
+static_assert(!(IN_SIZE & 0xf));
+
+// The values that have to survive the last few instructions of the return
+// ramp, staged just below the stack pointer the probe asked to resume with.
+// Everything else is already back in its register by then.
+#define OUT_CR_OFFSET  (0 * GPREG_SIZE)
+#define OUT_XER_OFFSET (1 * GPREG_SIZE)
+#define OUT_PC_OFFSET  (2 * GPREG_SIZE)
+#define OUT_LR_OFFSET  (3 * GPREG_SIZE)
+#define OUT_R0_OFFSET  (4 * GPREG_SIZE)
+#define OUT_R27_OFFSET (5 * GPREG_SIZE)
+#define OUT_SIZE       (6 * GPREG_SIZE)
+static_assert(!(OUT_SIZE & 0xf));
+
+#define PROBE_FRAME_SIZE (LINKAGE_AREA_SIZE + PROBE_ALIGNED_STACK_SIZE + OUT_SIZE)
+static_assert(!(PROBE_FRAME_SIZE & 0xf));
+
+#if OS(DARWIN)
+// The Darwin ppc64 translation of the ELFv2 trampoline in the #else arm,
+// generated from it instruction for instruction: named registers, the
+// 112-byte linkage-plus-parameter area a Darwin callee may write into
+// (LINKAGE_AREA_SIZE), r2 kept in the TOC slot at 40(r1) across the calls
+// because the LLInt uses it as its PIC base, and no ELF directives. r13 is
+// an ordinary nonvolatile register here, not a thread pointer; it is still
+// saved and not restored, which is harmless because generated code never
+// uses it.
+__asm__(
+    ".text" "\n"
+    ".align 2" "\n"
+    ".globl " SYMBOL_STRING(ctiMasmProbeTrampoline) "\n"
+    HIDE_SYMBOL(ctiMasmProbeTrampoline) "\n"
+    SYMBOL_STRING(ctiMasmProbeTrampoline) ":" "\n"
+
+    // On entry:
+    //   r1  -> IncomingProbeRecord
+    //   r25 =  probe function
+    //   r26 =  probe arg
+    //   r27 =  scratch (held the address of this trampoline)
+    //   r0, r12 = free (spilled to the record by the probe site)
+    //   LR  =  the address to resume at, i.e. the pc after the probe
+    //   r2  =  the process TOC
+
+    "mflr  r0" "\n"                       // the resume pc
+    "mr    r12, r1" "\n"                   // r12 = &IncomingProbeRecord
+    "addi  r1, r1, -" STRINGIZE_VALUE_OF(PROBE_FRAME_SIZE) "\n"
+    "std   r12, 0(r1)" "\n"                // back chain
+    "addi  r27, r1,  " STRINGIZE_VALUE_OF(LINKAGE_AREA_SIZE) "\n" // r27 = Probe::State*
+
+    "std   r25,  " STRINGIZE_VALUE_OF(PROBE_PROBE_FUNCTION_OFFSET) "(r27)" "\n"
+    "std   r26,  " STRINGIZE_VALUE_OF(PROBE_ARG_OFFSET) "(r27)" "\n"
+
+    // The resume pc, in the state (which the probe may change) and in a
+    // saved copy (which it may not).
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_PC_OFFSET) "(r27)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_SAVED_RETURN_PC_OFFSET) "(r27)" "\n"
+
+    // CR and XER, still exactly as they were at the probe site.
+    "mfcr  r0" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_CR_OFFSET) "(r27)" "\n"
+    "mfxer r0" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_XER_OFFSET) "(r27)" "\n"
+
+    // What the probe site had to spill.
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_LR_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_LR_OFFSET) "(r27)" "\n"
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_CTR_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_CTR_OFFSET) "(r27)" "\n"
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_R0_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R0_OFFSET) "(r27)" "\n"
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_R25_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R25_OFFSET) "(r27)" "\n"
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_R26_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R26_OFFSET) "(r27)" "\n"
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_R27_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R27_OFFSET) "(r27)" "\n"
+
+    // sp as it was before the probe site pushed the IncomingProbeRecord.
+    "addi  r0, r12,  " STRINGIZE_VALUE_OF(IN_SIZE) "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R1_OFFSET) "(r27)" "\n"
+
+    // r12 last, because it is the pointer to the record everything above
+    // came out of.
+    "ld    r0,  " STRINGIZE_VALUE_OF(IN_R12_OFFSET) "(r12)" "\n"
+    "std   r0,  " STRINGIZE_VALUE_OF(PROBE_CPU_R12_OFFSET) "(r27)" "\n"
+
+    // The rest straight out of the register file.
+    "std   r2,  " STRINGIZE_VALUE_OF(PROBE_CPU_R2_OFFSET) "(r27)" "\n"
+    "std   r3,  " STRINGIZE_VALUE_OF(PROBE_CPU_R3_OFFSET) "(r27)" "\n"
+    "std   r4,  " STRINGIZE_VALUE_OF(PROBE_CPU_R4_OFFSET) "(r27)" "\n"
+    "std   r5,  " STRINGIZE_VALUE_OF(PROBE_CPU_R5_OFFSET) "(r27)" "\n"
+    "std   r6,  " STRINGIZE_VALUE_OF(PROBE_CPU_R6_OFFSET) "(r27)" "\n"
+    "std   r7,  " STRINGIZE_VALUE_OF(PROBE_CPU_R7_OFFSET) "(r27)" "\n"
+    "std   r8,  " STRINGIZE_VALUE_OF(PROBE_CPU_R8_OFFSET) "(r27)" "\n"
+    "std   r9,  " STRINGIZE_VALUE_OF(PROBE_CPU_R9_OFFSET) "(r27)" "\n"
+    "std   r10,  " STRINGIZE_VALUE_OF(PROBE_CPU_R10_OFFSET) "(r27)" "\n"
+    "std   r11,  " STRINGIZE_VALUE_OF(PROBE_CPU_R11_OFFSET) "(r27)" "\n"
+    "std   r13,  " STRINGIZE_VALUE_OF(PROBE_CPU_R13_OFFSET) "(r27)" "\n"
+    "std   r14,  " STRINGIZE_VALUE_OF(PROBE_CPU_R14_OFFSET) "(r27)" "\n"
+    "std   r15,  " STRINGIZE_VALUE_OF(PROBE_CPU_R15_OFFSET) "(r27)" "\n"
+    "std   r16,  " STRINGIZE_VALUE_OF(PROBE_CPU_R16_OFFSET) "(r27)" "\n"
+    "std   r17,  " STRINGIZE_VALUE_OF(PROBE_CPU_R17_OFFSET) "(r27)" "\n"
+    "std   r18,  " STRINGIZE_VALUE_OF(PROBE_CPU_R18_OFFSET) "(r27)" "\n"
+    "std   r19,  " STRINGIZE_VALUE_OF(PROBE_CPU_R19_OFFSET) "(r27)" "\n"
+    "std   r20,  " STRINGIZE_VALUE_OF(PROBE_CPU_R20_OFFSET) "(r27)" "\n"
+    "std   r21,  " STRINGIZE_VALUE_OF(PROBE_CPU_R21_OFFSET) "(r27)" "\n"
+    "std   r22,  " STRINGIZE_VALUE_OF(PROBE_CPU_R22_OFFSET) "(r27)" "\n"
+    "std   r23,  " STRINGIZE_VALUE_OF(PROBE_CPU_R23_OFFSET) "(r27)" "\n"
+    "std   r24,  " STRINGIZE_VALUE_OF(PROBE_CPU_R24_OFFSET) "(r27)" "\n"
+    "std   r28,  " STRINGIZE_VALUE_OF(PROBE_CPU_R28_OFFSET) "(r27)" "\n"
+    "std   r29,  " STRINGIZE_VALUE_OF(PROBE_CPU_R29_OFFSET) "(r27)" "\n"
+    "std   r30,  " STRINGIZE_VALUE_OF(PROBE_CPU_R30_OFFSET) "(r27)" "\n"
+    "std   r31,  " STRINGIZE_VALUE_OF(PROBE_CPU_R31_OFFSET) "(r27)" "\n"
+
+    "stfd  f0,  " STRINGIZE_VALUE_OF(PROBE_CPU_F0_OFFSET) "(r27)" "\n"
+    "stfd  f1,  " STRINGIZE_VALUE_OF(PROBE_CPU_F1_OFFSET) "(r27)" "\n"
+    "stfd  f2,  " STRINGIZE_VALUE_OF(PROBE_CPU_F2_OFFSET) "(r27)" "\n"
+    "stfd  f3,  " STRINGIZE_VALUE_OF(PROBE_CPU_F3_OFFSET) "(r27)" "\n"
+    "stfd  f4,  " STRINGIZE_VALUE_OF(PROBE_CPU_F4_OFFSET) "(r27)" "\n"
+    "stfd  f5,  " STRINGIZE_VALUE_OF(PROBE_CPU_F5_OFFSET) "(r27)" "\n"
+    "stfd  f6,  " STRINGIZE_VALUE_OF(PROBE_CPU_F6_OFFSET) "(r27)" "\n"
+    "stfd  f7,  " STRINGIZE_VALUE_OF(PROBE_CPU_F7_OFFSET) "(r27)" "\n"
+    "stfd  f8,  " STRINGIZE_VALUE_OF(PROBE_CPU_F8_OFFSET) "(r27)" "\n"
+    "stfd  f9,  " STRINGIZE_VALUE_OF(PROBE_CPU_F9_OFFSET) "(r27)" "\n"
+    "stfd  f10,  " STRINGIZE_VALUE_OF(PROBE_CPU_F10_OFFSET) "(r27)" "\n"
+    "stfd  f11,  " STRINGIZE_VALUE_OF(PROBE_CPU_F11_OFFSET) "(r27)" "\n"
+    "stfd  f12,  " STRINGIZE_VALUE_OF(PROBE_CPU_F12_OFFSET) "(r27)" "\n"
+    "stfd  f13,  " STRINGIZE_VALUE_OF(PROBE_CPU_F13_OFFSET) "(r27)" "\n"
+    "stfd  f14,  " STRINGIZE_VALUE_OF(PROBE_CPU_F14_OFFSET) "(r27)" "\n"
+    "stfd  f15,  " STRINGIZE_VALUE_OF(PROBE_CPU_F15_OFFSET) "(r27)" "\n"
+    "stfd  f16,  " STRINGIZE_VALUE_OF(PROBE_CPU_F16_OFFSET) "(r27)" "\n"
+    "stfd  f17,  " STRINGIZE_VALUE_OF(PROBE_CPU_F17_OFFSET) "(r27)" "\n"
+    "stfd  f18,  " STRINGIZE_VALUE_OF(PROBE_CPU_F18_OFFSET) "(r27)" "\n"
+    "stfd  f19,  " STRINGIZE_VALUE_OF(PROBE_CPU_F19_OFFSET) "(r27)" "\n"
+    "stfd  f20,  " STRINGIZE_VALUE_OF(PROBE_CPU_F20_OFFSET) "(r27)" "\n"
+    "stfd  f21,  " STRINGIZE_VALUE_OF(PROBE_CPU_F21_OFFSET) "(r27)" "\n"
+    "stfd  f22,  " STRINGIZE_VALUE_OF(PROBE_CPU_F22_OFFSET) "(r27)" "\n"
+    "stfd  f23,  " STRINGIZE_VALUE_OF(PROBE_CPU_F23_OFFSET) "(r27)" "\n"
+    "stfd  f24,  " STRINGIZE_VALUE_OF(PROBE_CPU_F24_OFFSET) "(r27)" "\n"
+    "stfd  f25,  " STRINGIZE_VALUE_OF(PROBE_CPU_F25_OFFSET) "(r27)" "\n"
+    "stfd  f26,  " STRINGIZE_VALUE_OF(PROBE_CPU_F26_OFFSET) "(r27)" "\n"
+    "stfd  f27,  " STRINGIZE_VALUE_OF(PROBE_CPU_F27_OFFSET) "(r27)" "\n"
+    "stfd  f28,  " STRINGIZE_VALUE_OF(PROBE_CPU_F28_OFFSET) "(r27)" "\n"
+    "stfd  f29,  " STRINGIZE_VALUE_OF(PROBE_CPU_F29_OFFSET) "(r27)" "\n"
+    "stfd  f30,  " STRINGIZE_VALUE_OF(PROBE_CPU_F30_OFFSET) "(r27)" "\n"
+    "stfd  f31,  " STRINGIZE_VALUE_OF(PROBE_CPU_F31_OFFSET) "(r27)" "\n"
+
+    // executeJSCJITProbe(Probe::State*). r1 already has 32 free bytes at 0(r1)
+    // for the callee's LR and TOC saves.
+    "mr    r3, r27" "\n"
+    "std   r2, 40(r1)" "\n"
+    "bl    " SYMBOL_STRING(executeJSCJITProbe) "\n"
+    "ld    r2, 40(r1)" "\n"
+
+    // If the probe moved sp down to at or below where the Probe::State lives,
+    // move the state below the new sp first, so that filling in the stack
+    // cannot overwrite the register values still to be restored.
+    "ld    r4,  " STRINGIZE_VALUE_OF(PROBE_CPU_R1_OFFSET) "(r27)" "\n"
+    "addi  r5, r27,  " STRINGIZE_VALUE_OF(PROBE_ALIGNED_STACK_SIZE + OUT_SIZE) "\n"
+    "cmpld cr7, r4, r5" "\n"
+    "bge   cr7, " LOCAL_LABEL_STRING(ctiMasmProbeTrampolineProbeStateIsSafe) "\n"
+
+    "addi  r4, r4, -" STRINGIZE_VALUE_OF(PROBE_FRAME_SIZE) "\n"
+    "rldicr r4, r4, 0, 59" "\n"            // 16-byte align downwards
+    "mr    r6, r1" "\n"
+    "mr    r1, r4" "\n"                    // publish the new sp before copying
+    "std   r6, 0(r1)" "\n"                 // back chain
+    "addi  r6, r1,  " STRINGIZE_VALUE_OF(LINKAGE_AREA_SIZE) "\n"
+
+    // Copy low address to high: the destination is below the source.
+    "mr    r8, r27" "\n"
+    "mr    r10, r6" "\n"
+    "addi  r9, r27,  " STRINGIZE_VALUE_OF(PROBE_ALIGNED_STACK_SIZE) "\n"
+    LOCAL_LABEL_STRING(ctiMasmProbeTrampolineCopyLoop) ":" "\n"
+    "ld    r11, 0(r8)" "\n"
+    "std   r11, 0(r10)" "\n"
+    "addi  r8, r8, 8" "\n"
+    "addi  r10, r10, 8" "\n"
+    "cmpld cr7, r8, r9" "\n"
+    "blt   cr7, " LOCAL_LABEL_STRING(ctiMasmProbeTrampolineCopyLoop) "\n"
+    "mr    r27, r6" "\n"
+
+    LOCAL_LABEL_STRING(ctiMasmProbeTrampolineProbeStateIsSafe) ":" "\n"
+
+    // Call initializeStackFunction if the probe asked for one. r12 is the
+    // ELFv2 indirect-call target register, which is what a global entry
+    // point uses to compute its own TOC.
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_INITIALIZE_STACK_FUNCTION_OFFSET) "(r27)" "\n"
+    "cmpdi cr7, r12, 0" "\n"
+    "beq   cr7, " LOCAL_LABEL_STRING(ctiMasmProbeTrampolineRestoreRegisters) "\n"
+    "mr    r3, r27" "\n"
+    "mtctr r12" "\n"
+    "std   r2, 40(r1)" "\n"
+    "bctrl" "\n"
+    "ld    r2, 40(r1)" "\n"
+
+    LOCAL_LABEL_STRING(ctiMasmProbeTrampolineRestoreRegisters) ":" "\n"
+
+    // Stage the values that must outlive the register file, just below the
+    // sp the probe asked to resume with. r26 is the pointer because r0 cannot
+    // be a base register (RA = 0 means the literal zero).
+    "ld    r26,  " STRINGIZE_VALUE_OF(PROBE_CPU_R1_OFFSET) "(r27)" "\n"
+    "addi  r26, r26, -" STRINGIZE_VALUE_OF(OUT_SIZE) "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_CR_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_CR_OFFSET) "(r26)" "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_XER_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_XER_OFFSET) "(r26)" "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_PC_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_PC_OFFSET) "(r26)" "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_LR_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_LR_OFFSET) "(r26)" "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_R0_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_R0_OFFSET) "(r26)" "\n"
+    "ld    r12,  " STRINGIZE_VALUE_OF(PROBE_CPU_R27_OFFSET) "(r27)" "\n"
+    "std   r12,  " STRINGIZE_VALUE_OF(OUT_R27_OFFSET) "(r26)" "\n"
+    "mr    r1, r26" "\n"
+
+    "lfd   f0,  " STRINGIZE_VALUE_OF(PROBE_CPU_F0_OFFSET) "(r27)" "\n"
+    "lfd   f1,  " STRINGIZE_VALUE_OF(PROBE_CPU_F1_OFFSET) "(r27)" "\n"
+    "lfd   f2,  " STRINGIZE_VALUE_OF(PROBE_CPU_F2_OFFSET) "(r27)" "\n"
+    "lfd   f3,  " STRINGIZE_VALUE_OF(PROBE_CPU_F3_OFFSET) "(r27)" "\n"
+    "lfd   f4,  " STRINGIZE_VALUE_OF(PROBE_CPU_F4_OFFSET) "(r27)" "\n"
+    "lfd   f5,  " STRINGIZE_VALUE_OF(PROBE_CPU_F5_OFFSET) "(r27)" "\n"
+    "lfd   f6,  " STRINGIZE_VALUE_OF(PROBE_CPU_F6_OFFSET) "(r27)" "\n"
+    "lfd   f7,  " STRINGIZE_VALUE_OF(PROBE_CPU_F7_OFFSET) "(r27)" "\n"
+    "lfd   f8,  " STRINGIZE_VALUE_OF(PROBE_CPU_F8_OFFSET) "(r27)" "\n"
+    "lfd   f9,  " STRINGIZE_VALUE_OF(PROBE_CPU_F9_OFFSET) "(r27)" "\n"
+    "lfd   f10,  " STRINGIZE_VALUE_OF(PROBE_CPU_F10_OFFSET) "(r27)" "\n"
+    "lfd   f11,  " STRINGIZE_VALUE_OF(PROBE_CPU_F11_OFFSET) "(r27)" "\n"
+    "lfd   f12,  " STRINGIZE_VALUE_OF(PROBE_CPU_F12_OFFSET) "(r27)" "\n"
+    "lfd   f13,  " STRINGIZE_VALUE_OF(PROBE_CPU_F13_OFFSET) "(r27)" "\n"
+    "lfd   f14,  " STRINGIZE_VALUE_OF(PROBE_CPU_F14_OFFSET) "(r27)" "\n"
+    "lfd   f15,  " STRINGIZE_VALUE_OF(PROBE_CPU_F15_OFFSET) "(r27)" "\n"
+    "lfd   f16,  " STRINGIZE_VALUE_OF(PROBE_CPU_F16_OFFSET) "(r27)" "\n"
