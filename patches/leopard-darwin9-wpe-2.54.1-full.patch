+    void store32(RegisterID src, BaseIndex address) { storeImpl(StoreKind::S32, src, address); }
+    void store32(RegisterID src, const void* address) { storeImpl(StoreKind::S32, src, address); }
+    void store32(TrustedImm32 imm, Address address) { storeImmImpl(StoreKind::S32, imm, address); }
+    void store32(TrustedImm32 imm, BaseIndex address) { storeImmImpl(StoreKind::S32, imm, address); }
+    void store32(TrustedImm32 imm, const void* address) { storeImmImpl(StoreKind::S32, imm, address); }
