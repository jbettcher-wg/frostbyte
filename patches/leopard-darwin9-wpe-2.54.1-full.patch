+// Fold sqrt the way the generated code computes it. On ppc64 a negative
+// operand gives the default quiet NaN and a NaN comes back quieted, as fsqrt
+// does (the e6500 runs it through the kernel emulator for those operands);
+// Leopard's libm builds a NaN of a different sign for negatives, which made
+// folded and unfolded code disagree bit for bit.
+inline double sqrtLikeInstruction(double value)
+{
+#if CPU(PPC64)
+    if (std::isnan(value))
+        return std::bit_cast<double>(std::bit_cast<uint64_t>(value) | 0x0008000000000000ULL);
+    if (value < 0)
+        return std::bit_cast<double>(0x7ff8000000000000ULL);
+#endif
+    return sqrt(value);
+}
