+
+    void add64(TrustedImm32 imm, RegisterID dest) { addImmediate64(dest, static_cast<int64_t>(imm.m_value), dest); }
+    void add64(TrustedImm32 imm, RegisterID src, RegisterID dest) { addImmediate64(src, static_cast<int64_t>(imm.m_value), dest); }
