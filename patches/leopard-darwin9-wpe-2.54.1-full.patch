+// Swizzle: in-range indices in a scrambled order plus every kind of
+// out-of-range index -- 16 and 31 (which vpermr would route to its second
+// table), 32 and 128 (which wrap), 200 (the handbook's control: the unmasked
+// permute returns a[8]) and 255. Both ISA arms are run.
+void testPPC64VectorSwizzle()
+{
+    alignas(16) uint8_t a[16], out[16];
+    for (unsigned i = 0; i < 16; ++i)
+        a[i] = static_cast<uint8_t>(0x10 + i);
+    alignas(16) const uint8_t control[16] = { 0, 15, 1, 14, 2, 13, 16, 31, 32, 200, 255, 7, 8, 128, 3, 12 };
+    for (bool forcePOWER8 : { false, true }) {
+        PPC64Assembler::forcePOWER8Paths() = forcePOWER8;
+        ppc64RunVectorBinary(a, control, out, [](CCallHelpers& jit, FPRReg x, FPRReg c, FPRReg d) {
+            jit.vectorSwizzle(x, c, d);
+        });
+        for (unsigned i = 0; i < 16; ++i)
+            ppc64CheckLane<uint8_t>(out, i, control[i] < 16 ? a[control[i]] : 0);
+        PPC64Assembler::forcePOWER8Paths() = false;
+    }
+}
+
+// Shuffle over a||b. Indices from both halves in a scrambled order; a and b
+// are distinct and non-adjacent registers on purpose.
+void testPPC64VectorShuffle()
+{
+    alignas(16) uint8_t a[16], b[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        a[i] = static_cast<uint8_t>(0x10 + i);
+        b[i] = static_cast<uint8_t>(0x20 + i);
+    }
+    alignas(16) const uint8_t control[16] = { 0, 31, 16, 15, 1, 30, 17, 14, 8, 23, 24, 7, 2, 29, 18, 13 };
+    for (bool forcePOWER8 : { false, true }) {
+        PPC64Assembler::forcePOWER8Paths() = forcePOWER8;
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR4);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR3, 0), FPRInfo::argumentFPR2);
+            jit.vectorSwizzle2(FPRInfo::argumentFPR0, FPRInfo::argumentFPR4, FPRInfo::argumentFPR2, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0], &control[0]);
+        for (unsigned i = 0; i < 16; ++i)
+            ppc64CheckLane<uint8_t>(out, i, control[i] < 16 ? a[control[i]] : b[control[i] - 16]);
+        PPC64Assembler::forcePOWER8Paths() = false;
+    }
+}
+
+// Promote and demote. Four DISTINCT singles, because a uniform input is
+// exactly what hid xvcvspdp reading lanes 1 and 3
+// (jsc-ppc64-vector-conversions.md section 1.4); the signalling-NaN row is
+// the measured one from section 5 -- quieted, payload preserved.
+void testPPC64VectorPromoteDemote()
+{
+    alignas(16) const float in[4] = { 1.0f, 2.0f, 3.0f, 4.0f };
+    alignas(16) uint8_t out[16];
+    ppc64RunVectorUnary(in, out, [](CCallHelpers& jit, FPRReg x, FPRReg d) {
+        jit.vectorPromote(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, d);
+    });
+    ppc64CheckLane<double>(out, 0, 1.0);
+    ppc64CheckLane<double>(out, 1, 2.0);
+
+    alignas(16) const uint32_t snans[4] = { 0x7f800001u, 0x7fbfffffu, 0x3f800000u, 0x40000000u };
+    ppc64RunVectorUnary(snans, out, [](CCallHelpers& jit, FPRReg x, FPRReg d) {
+        jit.vectorPromote(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, d);
+    });
+    ppc64CheckLane<uint64_t>(out, 0, 0x7ff8000020000000ull);
+    ppc64CheckLane<uint64_t>(out, 1, 0x7fffffffe0000000ull);
+
+    alignas(16) const double wide[2] = { 1.5, -0.1 };
+    ppc64RunVectorUnary(wide, out, [](CCallHelpers& jit, FPRReg x, FPRReg d) {
+        jit.vectorDemote(SIMDInfo { SIMDLane::f64x2, SIMDSignMode::None }, x, d);
+    });
+    ppc64CheckLane<float>(out, 0, 1.5f);
+    ppc64CheckLane<float>(out, 1, static_cast<float>(-0.1));   // rounded, not truncated
+    ppc64CheckLane<uint32_t>(out, 2, 0u);
+    ppc64CheckLane<uint32_t>(out, 3, 0u);
+}
