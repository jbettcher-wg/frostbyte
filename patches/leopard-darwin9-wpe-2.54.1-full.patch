+// countTrailingZeros32/64 across the hasISA30() seam.
+//
+// cnttzw/cnttzd are ISA 3.0; the POWER8 arm is the identity
+// ctz(x) == popcount(~x & (x - 1)), which is also correct for zero. Both arms
+// are exercised, because on POWER9 silicon forcing the POWER8 path is the only
+// way that arm ever runs -- and until it did, the fallback had been compiled
+// but never executed.
+//
+// Zero and the all-ones word are the two cases the identity is easiest to get
+// wrong, and the single-bit sweep is what catches a popcntw that counts the
+// wrong word.
+static void testPPC64CountTrailingZerosOnce(bool forcePOWER8)
+{
+    PPC64Assembler::forcePOWER8Paths() = forcePOWER8;
+
+    auto test64 = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.countTrailingZeros64(GPRInfo::argumentGPR0, GPRInfo::returnValueGPR);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    auto test32 = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.countTrailingZeros32(GPRInfo::argumentGPR0, GPRInfo::returnValueGPR);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    CHECK_EQ(invoke<size_t>(test64, static_cast<uint64_t>(0)), 64u);
+    CHECK_EQ(invoke<size_t>(test64, ~static_cast<uint64_t>(0)), 0u);
+    for (size_t i = 0; i < 64; ++i)
+        CHECK_EQ(invoke<size_t>(test64, static_cast<uint64_t>(1) << i), i);
+
+    CHECK_EQ(invoke<size_t>(test32, static_cast<uint64_t>(0)), 32u);
+    CHECK_EQ(invoke<size_t>(test32, static_cast<uint64_t>(0xffffffffu)), 0u);
+    for (size_t i = 0; i < 32; ++i)
+        CHECK_EQ(invoke<size_t>(test32, static_cast<uint64_t>(1) << i), i);
+
+    // The high half must not leak into a 32-bit count: popcntw counts each
+    // word separately, so an unmasked result would add the high word's bits.
+    CHECK_EQ(invoke<size_t>(test32, static_cast<uint64_t>(0xffffffff00000000ull)), 32u);
+    CHECK_EQ(invoke<size_t>(test32, static_cast<uint64_t>(0xffffffff00010000ull)), 16u);
+
+    PPC64Assembler::forcePOWER8Paths() = false;
+}
+
+void testPPC64CountTrailingZeros()
+{
+    testPPC64CountTrailingZerosOnce(false);   // native (ISA 3.0 here)
+    testPPC64CountTrailingZerosOnce(true);    // the POWER8 fallback
+}
