+// (0x0102030405060708), so splatting the wrong element is detectable: each
+// lane width must pick a different, identifiable slice of it. A source with
+// repeated bytes would pass with any element index.
+void testPPC64VectorSplatInteger()
+{
+    for (bool forcePOWER8 : { false, true }) {
+        PPC64Assembler::forcePOWER8Paths() = forcePOWER8;
+        const uint64_t value = 0x0102030405060708ULL;
+
+        auto check = [&](SIMDLane lane, const uint8_t* expected) {
+            alignas(16) uint8_t out[16];
+            for (unsigned i = 0; i < 16; ++i)
+                out[i] = 0xa5;
+            auto test = compile([=] (CCallHelpers& jit) {
+                emitFunctionPrologue(jit);
+                jit.vectorSplat(lane, GPRInfo::argumentGPR0, FPRInfo::argumentFPR0);
+                jit.storeVector(FPRInfo::argumentFPR0, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+                emitFunctionEpilogue(jit);
+                jit.ret();
+            });
+            invoke<void>(test, value, &out[0]);
+            for (unsigned i = 0; i < 16; ++i)
+                CHECK_EQ(out[i], expected[i]);
+        };
