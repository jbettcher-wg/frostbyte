+    // Selecting an FPR has no isel equivalent, so it is a branch over a move.
+    // The condition is already in a CR field by the time we get here, so this
+    // is the one place a Jump is built from a CRTest without going through
+    // one of the branchXxx entry points.
+    void emitSelectDouble(CRTest test, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        // Seeding dest with the else value and branching over the then-move
+        // is only valid while dest is not itself the then value -- otherwise
+        // the seed destroys the operand the branch was going to keep. JSC
+        // calls this with dest == thenCase (testmasm has a case named for
+        // exactly that), so the direction of the branch has to follow the
+        // aliasing rather than being fixed.
+        if (dest == thenCase) {
+            // Already holding the then value: only the else case needs work.
+            Jump keepThen = makeBranch(test);
+            moveDouble(elseCase, dest);
+            keepThen.link(this);
+            return;
+        }
+        moveDouble(elseCase, dest);
+        Jump skip = makeBranch({ test.bit, !test.branchIfSet, test.field });
+        moveDouble(thenCase, dest);
+        skip.link(this);
+    }
