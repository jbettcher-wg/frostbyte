+            rasterizeBand(band);
+            Locker locker { lock };
+            if (!--remaining)
+                finished.notifyOne();
+        });
+    }
+    rasterizeBand(0);
+    Locker locker { lock };
+    finished.wait(lock, [&] { return !remaining; });
