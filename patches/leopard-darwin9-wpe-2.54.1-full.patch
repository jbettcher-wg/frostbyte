+        // divwu reads the low words directly, so the zero-extension invariant
+        // is all the preparation it needs.
+        auto temp = temps<Data, Memory>();
+        m_assembler.divwu(temp.data(), dividend, divisor);
+        m_assembler.li(temp.memory(), 0);
+        emitSelect(emitCompare32(Equal, divisor, TrustedImm32(0)), temp.memory(), temp.data(), dest);
+        maskLow32(dest);
+    }
+
+    void uDiv64(RegisterID dividend, RegisterID divisor, RegisterID dest)
