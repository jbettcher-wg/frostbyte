+    void lshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        RegisterID count = maskedShiftCount(shiftAmount, 31, shiftCountScratch(src, dest));
+        m_assembler.slw(dest, src, count);
+        maskLow32(dest);
+    }
