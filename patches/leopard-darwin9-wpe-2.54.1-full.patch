+// Typed-array element storage order. With USE(LE_TYPED_ARRAYS) on a big-endian host,
+// multi-byte typed-array elements are stored little-endian; this converts between the
+// stored form and a native value (the conversion is its own inverse). Identity otherwise.
+template<typename T>
+ALWAYS_INLINE T typedArrayStorageSwap(T value)
+{
+#if USE(LE_TYPED_ARRAYS)
+    if constexpr (sizeof(T) > 1)
+        return flipBytes(value);
+#endif
+    return value;
+}
+
+template<typename T>
+ALWAYS_INLINE void typedArrayStorageSwapInPlace(T* data, size_t count)
+{
+#if USE(LE_TYPED_ARRAYS)
+    if constexpr (sizeof(T) > 1) {
+        for (size_t i = 0; i < count; ++i)
+            data[i] = flipBytes(data[i]);
+    }
+#else
+    UNUSED_PARAM(data);
+    UNUSED_PARAM(count);
+#endif
+}
+
 } // namespace WTF
 
