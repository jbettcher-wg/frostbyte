+    // ==================================================================
+    // Conditional moves.
+    //
+    // Integer selects use isel (ISA 2.06), which is branchless: it picks
+    // between two GPRs on one CR bit. The one trap is that isel's RA field,
+    // like every other RA field, reads as the literal zero when it names r0
+    // -- so an operand that happened to be r0 would silently become 0. JSC
+    // never allocates r0 (GPRInfo::toIndex maps it to InvalidIndex), and the
+    // assertion below keeps that assumption honest rather than implicit.
+    //
+    // Floating-point selects use a branch instead of fsel. fsel tests
+    // "greater than or equal to zero" on a single operand and returns the
+    // WRONG argument for NaN -- the LuaJIT ppc64le port's correction ledger
+    // records exactly that -- so expressing JSC's twelve NaN-aware
+    // DoubleConditions through it would be a NaN bug generator.
+    // ==================================================================
+
+    void emitSelect(CRTest test, RegisterID thenCase, RegisterID elseCase, RegisterID dest)
+    {
+        RELEASE_ASSERT(thenCase != PPC64Registers::r0 && elseCase != PPC64Registers::r0);
+        unsigned bit = crBitIndex(test.field, test.bit);
+#if !LEOPARD_PPC64_ISA206
+        // PowerPC 970: no isel. A one-word guard (a plain bc over the next
+        // word, never a shortenable or linkable branch site) skips one `mr`;
+        // mr leaves the CR alone. The order follows dest's aliasing, as in
+        // emitSelectDouble. The condition holds when the bit equals
+        // branchIfSet, and BOTrue skips when the bit is set.
+        uint32_t skipIfHolds = test.branchIfSet ? Assembler::BOTrue : Assembler::BOFalse;
+        uint32_t skipUnlessHolds = test.branchIfSet ? Assembler::BOFalse : Assembler::BOTrue;
+        if (thenCase == elseCase) {
+            if (dest != thenCase)
+                m_assembler.mr(dest, thenCase);
+            return;
+        }
+        if (dest == thenCase) {
+            m_assembler.insn(Assembler::conditionalGuardInsn(skipIfHolds, bit));
+            m_assembler.mr(dest, elseCase);
+            return;
+        }
+        if (dest != elseCase)
+            m_assembler.mr(dest, elseCase);
+        m_assembler.insn(Assembler::conditionalGuardInsn(skipUnlessHolds, bit));
+        m_assembler.mr(dest, thenCase);
+        return;
+#endif
+        if (test.branchIfSet)
+            m_assembler.isel(dest, thenCase, elseCase, bit);
+        else
+            m_assembler.isel(dest, elseCase, thenCase, bit);
+    }
