+static void testPPC64AtomicStrongCAS32()
+{
+    uint64_t seen = 0;
+    auto cas = compilePPC64AtomicStrongCAS<32>(CCallHelpers::Success, &seen);
+
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242, 0x33333333 };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424242), static_cast<uint64_t>(0x99999999)), 1u);
+        CHECK_EQ(data[0], 0x11111111u);
+        CHECK_EQ(data[1], 0x99999999u);
+        CHECK_EQ(data[2], 0x33333333u);
+        CHECK_EQ(seen, static_cast<uint64_t>(0x42424242));
+    }
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242, 0x33333333 };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424243), static_cast<uint64_t>(0x99999999)), 0u);
+        CHECK_EQ(data[1], 0x42424242u);
+        CHECK_EQ(seen, static_cast<uint64_t>(0x42424242));
+    }
+    // Nothing is masked at this width: cmplw reads bits 32:63 and ignores
+    // the rest, so a top-bit-set element matches an expected value that
+    // arrived sign-extended.
+    {
+        uint32_t data[] = { 0x11111111, 0xffffffff, 0x33333333 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0xffffffff), static_cast<uint64_t>(0xfffffffe)), 1u);
+        CHECK_EQ(data[1], 0xfffffffeu);
+    }
+
+    // The Failure polarity of the same stub: the returned jumps are taken
+    // when the CAS FAILED. Nothing else about the sequence changes, so this
+    // is the one-variable check that cond reaches makeBranch.
+    uint64_t failureSeen = 0;
+    auto failureCas = compilePPC64AtomicStrongCAS<32>(CCallHelpers::Failure, &failureSeen);
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242, 0x33333333 };
+        CHECK_EQ(invoke<uint32_t>(failureCas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424242), static_cast<uint64_t>(0x99999999)), 0u);
+        CHECK_EQ(data[1], 0x99999999u);
+    }
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242, 0x33333333 };
+        CHECK_EQ(invoke<uint32_t>(failureCas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424243), static_cast<uint64_t>(0x99999999)), 1u);
+        CHECK_EQ(data[1], 0x42424242u);
+        CHECK_EQ(failureSeen, static_cast<uint64_t>(0x42424242));
+    }
+}
