+// Div and sqrt, with a different value in every lane so a cross-lane mix-up
+// changes an answer rather than preserving it.
+void testPPC64VectorFloatDivSqrt()
+{
+    alignas(16) uint8_t out[16];
+    {
+        alignas(16) float a[4] = { 12.0f, 20.0f, -9.0f, 7.0f };
+        alignas(16) float b[4] = {  4.0f,  8.0f,  3.0f, 2.0f };
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.vectorDiv(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got;
+            memcpy(&got, &out[i * 4], 4);
+            CHECK_EQ(got, a[i] / b[i]);
+        }
+    }
+    {
+        alignas(16) float a[4] = { 4.0f, 9.0f, 16.0f, 25.0f };
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorSqrt(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
