+// The sign-extension seam for the strong form, with its negative control.
+//
+// Same seam as the weak form's (jsc-ppc64-atomics-cas.md section 5.3): the
+// caller's Int8Array reload sign-extends, lbarx zero-extends, and the clrldi
+// is what makes the byte 0xff compare equal to the expected 0xffffffff.
+// What differs is the failure MODE, and the difference is the reason the
+// strong form's loop closes where it does. In the weak form a missing mask
+// costs a spurious Failure that the DFG's outer loop turns into an infinite
+// retry -- a hang. Here the mismatch path leaves the loop, so a missing mask
+// costs a spurious Failure and nothing more; the primitive still returns.
+//
+// Both halves are checked. First single-shot, which is the one-variable
+// control: the same sequence with only the clrldi removed must report
+// Failure and must not store. Then in the DFG's own loop shape -- sign-
+// extending reload, compute, CAS, retry -- under a fixed attempt budget,
+// where the unmasked arm must burn the whole budget without ever storing.
+// Exhausting the budget is what a hang looks like from inside a test.
+static void testPPC64AtomicStrongCASSignExtendSeam()
+{
+    constexpr int32_t budget = 16;
+
+    // The hand-emitted copy: branchAtomicStrongCAS8's body with the clrldi
+    // left out and nothing else changed. The shipping stub cannot be asked
+    // to be wrong, so the control has to be written out.
+    auto emitUnmaskedStrongCAS8 = [] (CCallHelpers& jit, CCallHelpers::RegisterID base, CCallHelpers::RegisterID expected, CCallHelpers::RegisterID newValue, CCallHelpers::RegisterID loaded) {
+        jit.memoryFence();
+        auto reload = jit.label();
+        TESTMASM_LBARX(jit, loaded, base);
+        jit.m_assembler.cmplw(CRField::CR0, loaded, expected);
+        auto mismatch = jit.makeBranch({ CRBit::EQ, false });
+        TESTMASM_STBCX(jit, newValue, base);
+        jit.makeBranch({ CRBit::EQ, false }).linkTo(reload, &jit);
+        mismatch.link(&jit);
+        jit.loadFence();
+        return jit.makeBranch({ CRBit::EQ, true });
+    };
+
+    // Single shot, both arms, no outer loop.
+    auto maskedOnce = compile([] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        auto stored = jit.branchAtomicStrongCAS8(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3,
+            CCallHelpers::Address(GPRInfo::argumentGPR0));
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    auto unmaskedOnce = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        auto stored = emitUnmaskedStrongCAS8(jit, GPRInfo::argumentGPR0, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, GPRInfo::argumentGPR1);
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // -1, reaching the CAS sign-extended as the caller's Int8Array load
+    // leaves it.
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(maskedOnce, static_cast<void*>(data), static_cast<uint64_t>(0), static_cast<uint64_t>(0xffffffff), static_cast<uint64_t>(0xfe)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xfeu);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x5au);
+    }
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmaskedOnce, static_cast<void*>(data), static_cast<uint64_t>(0), static_cast<uint64_t>(0xffffffff), static_cast<uint64_t>(0xfe)), 0u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xffu);
+    }
+    // A positive element, where the seam does not exist: both arms store.
+    // This is what keeps the control honest -- it must fail for the sign,
+    // not because the hand-emitted sequence is broken in some other way.
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(maskedOnce, static_cast<void*>(data), static_cast<uint64_t>(0), static_cast<uint64_t>(0x10), static_cast<uint64_t>(0x0f)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmaskedOnce, static_cast<void*>(data), static_cast<uint64_t>(0), static_cast<uint64_t>(0x10), static_cast<uint64_t>(0x0f)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+
+    // The same two arms inside the DFG's loop shape, bounded. Atomics.sub
+    // on an Int8Array element: reload sign-extended, subtract, CAS, retry.
+    auto maskedInLoop = compile([] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto expected = GPRInfo::argumentGPR2;
+        const auto newValue = GPRInfo::argumentGPR3;
+        const auto counter = GPRInfo::nonArgGPR0;
+
+        jit.move(CCallHelpers::TrustedImm32(budget), counter);
+        auto loop = jit.label();
+        jit.load8SignedExtendTo32(CCallHelpers::Address(GPRInfo::argumentGPR0), expected);
+        jit.move(expected, newValue);
+        jit.sub32(CCallHelpers::TrustedImm32(1), newValue);
+        auto stored = jit.branchAtomicStrongCAS8(CCallHelpers::Success, expected, newValue, CCallHelpers::Address(GPRInfo::argumentGPR0));
+        jit.sub32(CCallHelpers::TrustedImm32(1), counter);
+        jit.branchTest32(CCallHelpers::NonZero, counter).linkTo(loop, &jit);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    auto unmaskedInLoop = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto expected = GPRInfo::argumentGPR2;
+        const auto newValue = GPRInfo::argumentGPR3;
+        const auto loaded = GPRInfo::argumentGPR1;
+        const auto counter = GPRInfo::nonArgGPR0;
+
+        jit.move(CCallHelpers::TrustedImm32(budget), counter);
+        auto loop = jit.label();
+        jit.load8SignedExtendTo32(CCallHelpers::Address(GPRInfo::argumentGPR0), expected);
+        jit.move(expected, newValue);
+        jit.sub32(CCallHelpers::TrustedImm32(1), newValue);
+        auto stored = emitUnmaskedStrongCAS8(jit, GPRInfo::argumentGPR0, expected, newValue, loaded);
+        jit.sub32(CCallHelpers::TrustedImm32(1), counter);
+        jit.branchTest32(CCallHelpers::NonZero, counter).linkTo(loop, &jit);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        stored.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(maskedInLoop, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xfeu);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x5au);
+    }
+    {
+        uint8_t data[] = { 0xff, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmaskedInLoop, static_cast<void*>(data), static_cast<uint64_t>(0)), 0u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0xffu);
+    }
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(maskedInLoop, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+    {
+        uint8_t data[] = { 0x10, 0x5a };
+        CHECK_EQ(invoke<uint32_t>(unmaskedInLoop, static_cast<void*>(data), static_cast<uint64_t>(0)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x0fu);
+    }
+}
+
+// The case that is not blind to the inner loop.
+//
+// Everything above passes with or without the retry, because a reservation
+// is only lost when something else stores into the 128-byte granule. So the
+// test stores into it: one thread writes a neighbouring word 64 bytes away
+// -- a different variable, never the CAS target -- while the main thread
+// CASes a value that always matches.
+//
+// The strong form must never report failure: a matching value plus a lost
+// reservation is exactly the case its loop exists to retry. The WEAK form is
+// the control, and it must report failure at least once; if it never does,
+// the hammer never landed inside anybody's reservation window, the axis
+// being tested is shut, and the strong form's clean result means nothing
+// (verification-discipline.md, "Controls must fire"). The rate varies by
+// orders of magnitude with scheduling -- testmasm itself runs one test per
+// hardware thread -- so the verdict is the count being nonzero, never the
+// count itself.
+static void testPPC64AtomicStrongCASSurvivesContention()
+{
+#if CPU(PPC64_E6500)
+    // The e6500's reservation granule is its 64-byte cache line, not
+    // POWER's 128 bytes, so the neighbour has to sit inside the first line.
+    struct alignas(128) Granule {
+        std::atomic<uint32_t> target;
+        uint32_t padding[7];
+        std::atomic<uint32_t> neighbour;
+        uint32_t morePadding[23];
+    };
+#else
+    struct alignas(128) Granule {
+        std::atomic<uint32_t> target;
+        uint32_t padding[15];
+        std::atomic<uint32_t> neighbour;
+        uint32_t morePadding[15];
+    };
+#endif
+    static_assert(sizeof(Granule) == 128, "the target and the neighbour must share one reservation granule");
+
+    auto casStub = [] (bool strong) {
+        return compile([strong] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            CCallHelpers::BaseIndex address(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, CCallHelpers::TimesFour);
+            CCallHelpers::JumpList stored;
+            if (strong)
+                stored = jit.branchAtomicStrongCAS32(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+            else
+                stored = jit.branchAtomicWeakCAS32(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+            jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+            auto done = jit.jump();
+            stored.link(&jit);
+            jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+            done.link(&jit);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+    };
+    auto strongCAS = casStub(true);
+    auto weakCAS = casStub(false);
+
+    Granule granule;
+    granule.target.store(0, std::memory_order_relaxed);
+    granule.neighbour.store(0, std::memory_order_relaxed);
+
+    std::atomic<bool> stop { false };
+    auto hammer = Thread::create("testmasm CAS granule hammer"_s, [&] {
+        uint32_t counter = 0;
+        while (!stop.load(std::memory_order_relaxed))
+            granule.neighbour.store(++counter, std::memory_order_relaxed);
+    });
+
+    // The strong arm: every attempt must store, however many reservations
+    // the neighbour costs it.
+    constexpr unsigned strongRounds = 20000;
+    unsigned strongFailures = 0;
+    for (unsigned i = 0; i < strongRounds; ++i) {
+        uint32_t before = 0x10000 + i;
+        uint32_t after = 0x20000 + i;
+        granule.target.store(before, std::memory_order_relaxed);
+        if (!invoke<uint32_t>(strongCAS, static_cast<void*>(&granule.target), static_cast<uint64_t>(0), static_cast<uint64_t>(before), static_cast<uint64_t>(after)))
+            ++strongFailures;
+        else
+            CHECK_EQ(granule.target.load(std::memory_order_relaxed), after);
+    }
+
+    // The control arm: the same matching value through the weak form, which
+    // is allowed to fail for a lost reservation and, under this hammer, must.
+    constexpr unsigned weakRoundsMax = 400000;
+    unsigned weakFailures = 0;
+    unsigned weakRounds = 0;
+    for (; weakRounds < weakRoundsMax && !weakFailures; ++weakRounds) {
+        uint32_t before = 0x30000 + weakRounds;
+        uint32_t after = 0x40000 + weakRounds;
+        granule.target.store(before, std::memory_order_relaxed);
+        if (!invoke<uint32_t>(weakCAS, static_cast<void*>(&granule.target), static_cast<uint64_t>(0), static_cast<uint64_t>(before), static_cast<uint64_t>(after)))
+            ++weakFailures;
+    }
+
+    stop.store(true, std::memory_order_relaxed);
+    hammer->waitForCompletion();
+
+    CHECK_EQ(strongFailures, 0u);
+    // Nonzero, not a rate: see the comment above.
+    CHECK_NOT_EQ(weakFailures, 0u);
+}
+
+// ---- The immediate forms of the overflow and carry helpers --------------
+//
+// These entry points stage their immediate into memoryTempRegister and then
+// pass that register as a source operand to a helper that claims the same
+// temp. temps<>() tracks nothing and cannot warn, so the only defence is the
+// helper reading every operand before overwriting the register it may live
+// in. Two of them did not, and neither had a caller that could reach it,
+// which is why nothing noticed: branchAdd32 with Carry has no callers at all
+// in Source/, and the immediate form of branchAdd64 is unreachable from B3
+// because Air::Arg::isValidImmForm returns false on this target.
+//
+// RANDOM OPERANDS CANNOT FIND THIS. With a 32-bit immediate, a 64-bit add
+// can only overflow when the register operand is within 2^31 of a boundary;
+// 20 million uniformly random pairs contain no overflows at all, so a random
+// test agrees with the oracle perfectly while the predicate is wrong. Every
+// value below is therefore chosen against the immediate: the boundary where
+// the operation changes answer, and its two neighbours.
+//
+// Each case runs twice: once through the immediate entry point, where the
+// operand is memoryTempRegister, and once through the register entry point
+// with the same value in an ordinary register. The register arm is the
+// control -- it shares the oracle, the stub shape and the operand values, and
+// differs only in where the operand sits, so if it ever fails the harness is
+// wrong rather than the aliasing.
+
+enum class PPC64ArithForm : uint8_t { Add32Carry, Add64Overflow, Sub32Carry, Sub64Overflow, Mul64Overflow };
+
+static const char* ppc64ArithFormName(PPC64ArithForm form)
+{
+    switch (form) {
+    case PPC64ArithForm::Add32Carry: return "branchAdd32(Carry)";
+    case PPC64ArithForm::Add64Overflow: return "branchAdd64(Overflow)";
+    case PPC64ArithForm::Sub32Carry: return "branchSub32(Carry)";
+    case PPC64ArithForm::Sub64Overflow: return "branchSub64(Overflow)";
+    case PPC64ArithForm::Mul64Overflow: return "branchMul64(Overflow)";
+    }
+    return "?";
+}
+
+// The stub returns the status jump's answer as 0/1 and writes the computed
+// value to a slot, so that a wrong VALUE cannot hide behind a right flag --
+// which is how the emitAdd32Carry defect presented: src + zext32(src).
+static MacroAssemblerCodeRef<JSEntryPtrTag> compilePPC64ArithImmediateForm(PPC64ArithForm form, int32_t imm, uint64_t* valueOut)
+{
+    return compile([form, imm, valueOut] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto source = GPRInfo::argumentGPR0;
+        const auto result = GPRInfo::argumentGPR2;
+        CCallHelpers::TrustedImm32 immediate(imm);
+
+        CCallHelpers::Jump taken;
+        switch (form) {
+        case PPC64ArithForm::Add32Carry:
+            taken = jit.branchAdd32(CCallHelpers::Carry, source, immediate, result);
+            break;
+        case PPC64ArithForm::Add64Overflow:
+            taken = jit.branchAdd64(CCallHelpers::Overflow, source, immediate, result);
+            break;
+        case PPC64ArithForm::Sub32Carry:
+            taken = jit.branchSub32(CCallHelpers::Carry, source, immediate, result);
+            break;
+        case PPC64ArithForm::Sub64Overflow:
+            taken = jit.branchSub64(CCallHelpers::Overflow, source, immediate, result);
+            break;
+        case PPC64ArithForm::Mul64Overflow:
+            taken = jit.branchMul64(CCallHelpers::Overflow, source, immediate, result);
+            break;
+        }
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        taken.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+
+        jit.move(CCallHelpers::TrustedImmPtr(valueOut), GPRInfo::argumentGPR3);
+        jit.store64(result, CCallHelpers::Address(GPRInfo::argumentGPR3));
+
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+}
+
+// The control: the same operation with the second operand in an ordinary
+// argument register, which no helper ever writes.
+static MacroAssemblerCodeRef<JSEntryPtrTag> compilePPC64ArithRegisterForm(PPC64ArithForm form, uint64_t* valueOut)
+{
+    return compile([form, valueOut] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        const auto source = GPRInfo::argumentGPR0;
+        const auto operand = GPRInfo::argumentGPR1;
+        const auto result = GPRInfo::argumentGPR2;
+
+        CCallHelpers::Jump taken;
+        switch (form) {
+        case PPC64ArithForm::Add32Carry:
+            taken = jit.branchAdd32(CCallHelpers::Carry, source, operand, result);
+            break;
+        case PPC64ArithForm::Add64Overflow:
+            taken = jit.branchAdd64(CCallHelpers::Overflow, source, operand, result);
+            break;
+        case PPC64ArithForm::Sub32Carry:
+            taken = jit.branchSub32(CCallHelpers::Carry, source, operand, result);
+            break;
+        case PPC64ArithForm::Sub64Overflow:
+            taken = jit.branchSub64(CCallHelpers::Overflow, source, operand, result);
+            break;
+        case PPC64ArithForm::Mul64Overflow:
+            taken = jit.branchMul64(CCallHelpers::Overflow, source, operand, result);
+            break;
+        }
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        taken.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+
+        jit.move(CCallHelpers::TrustedImmPtr(valueOut), GPRInfo::argumentGPR3);
+        jit.store64(result, CCallHelpers::Address(GPRInfo::argumentGPR3));
+
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+}
