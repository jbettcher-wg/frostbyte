+    // nearCall and nearTailCall target generated code by construction --
+    // they take no tag and JSC only links them to thunks and JIT code -- so
+    // they never carry a linkage area.
+    Call nearCall()
+    {
+        auto label = m_assembler.label();
+        m_assembler.insn(Assembler::nopInsn());
+        m_assembler.insn(Assembler::unlinkedBranchInsn(true));
+        return Call(label, Call::LinkableNear);
+    }
+
+    Call nearTailCall()
+    {
+        auto label = m_assembler.label();
+        m_assembler.insn(Assembler::nopInsn());
+        m_assembler.insn(Assembler::unlinkedBranchInsn(false));
+        return Call(label, Call::LinkableNearTail);
+    }
+
+    Call threadSafePatchableNearCall()
+    {
+        // Relinking rewrites only the second word, and a single aligned
+        // 32-bit store is atomic with respect to a concurrently executing
+        // thread, so this needs no separate padding or fence discipline
+        // beyond the icache flush relinkCall already does.
