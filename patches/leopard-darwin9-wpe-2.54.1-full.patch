 #endif
 
+#if OS(DARWIN)
+#include <pthread.h>
+#include <errno.h>
+#include <sys/event.h>
+#include <unistd.h>
+
+// Mac OS X 10.5 has no SOCK_SEQPACKET, so IPC runs over connected SOCK_DGRAM socket pairs, and
+// those report nothing (no EOF, no HUP) when the peer goes away. A helper would then outlive a UI
+// process that quit or crashed; watch the parent instead and leave with it.
+static void* watchParentProcess(void* context)
+{
+    pid_t parent = static_cast<pid_t>(reinterpret_cast<intptr_t>(context));
+    int queue = kqueue();
+    if (queue >= 0) {
+        struct kevent change;
+        struct kevent event;
+        EV_SET(&change, parent, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, nullptr);
+        while (getppid() == parent) {
+            int n = kevent(queue, &change, 1, &event, 1, nullptr);
+            if (n > 0 && !(event.flags & EV_ERROR))
+                break; // NOTE_EXIT
+            if (n < 0 && errno == EINTR)
+                continue;
+            // Registration failed (or the parent is already gone): fall back to polling.
+            while (getppid() == parent)
+                sleep(1);
+        }
+    } else {
+        while (getppid() == parent)
+            sleep(1);
+    }
+    _exit(0);
+    return nullptr;
+}
+
+static void startParentProcessWatchdog()
+{
+    pthread_attr_t attributes;
+    pthread_t thread;
+    pthread_attr_init(&attributes);
+    pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+    pthread_attr_setstacksize(&attributes, 64 * 1024);
+    pthread_create(&thread, &attributes, watchParentProcess, reinterpret_cast<void*>(static_cast<intptr_t>(getppid())));
+    pthread_attr_destroy(&attributes);
+}
+#endif
