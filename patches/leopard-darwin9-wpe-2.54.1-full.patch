+    // A sequentially consistent load, the same strength RISCV64 gives it and
+    // at least the acquire ARM64 gives it with ldar. PowerPC has no
+    // ordered-load instruction, so the ordering is spelled out: sync ahead of
+    // the load to keep it behind everything before it, lwsync after to keep
+    // subsequent loads and stores behind it. lwsync is enough for the
+    // trailing half because the operation it has to order against is a load.
+    //
+    // Not reachable only from Atomics.*: AssemblyHelpers::loadTypedArray-
+    // ByteLengthImpl reads a GrowableSharedArrayBuffer's size this way, so a
+    // plain `array.length` on a SharedArrayBuffer view comes through here and
+    // an UNREACHABLE_FOR_PLATFORM stub aborted the InlineCacheCompiler.
+    void atomicLoad32(Address address, RegisterID dest)
+    {
+        memoryFence();
+        load32(address, dest);
+        loadFence();
+    }
