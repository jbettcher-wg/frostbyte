+    // ------------------------------------------------------------------
+    // 64-bit immediate materialisation. The ladder is the standard five-word
+    // one (lis/ori/rldicr/oris/ori), shortened whenever the value permits.
+    // Any shorter path must produce EXACTLY the same register contents; the
+    // sign extension of addi/addis is what the compensations below are for.
+    // ------------------------------------------------------------------
+
+    static unsigned sizeOfLoadImmediate64(int64_t value)
+    {
+        if (PPC64Assembler::isValidSigned16(value))
+            return 1;
+        if (PPC64Assembler::isValidSigned32(value))
+            return (value & 0xffff) ? 2 : 1;
+        if (!(value >> 32) || (value >> 32) == -1)
+            return 2;
+        unsigned count = 1; // lis for bits 48:63
+        if ((value >> 32) & 0xffff)
+            count++; // ori
+        count++; // rldicr
+        if ((value >> 16) & 0xffff)
+            count++; // oris
+        if (value & 0xffff)
+            count++; // ori
+        return count;
+    }
+
+    void loadImmediate64(RegisterID rd, int64_t value)
+    {
+        if (isValidSigned16(value)) {
+            li(rd, int32_t(value));
+            return;
+        }
+
+        if (isValidSigned32(value)) {
+            // addis sign-extends its 16-bit field into bits 32:47 and beyond,
+            // which is exactly right for a signed 32-bit value.
+            lis(rd, int32_t(int16_t(value >> 16)));
+            if (value & 0xffff)
+                ori(rd, rd, uint32_t(value) & 0xffff);
+            return;
+        }
+
+        int32_t hi32 = int32_t(value >> 32);
+        uint32_t lo32 = uint32_t(uint64_t(value) & 0xffffffff);
+
+        if (isValidSigned16(hi32)) {
+            // li sign-extends, which is the whole high word here; the shift then
+            // leaves it in bits 0:31. A zero high word needs no shift at all,
+            // since oris/ori below zero-extend.
+            li(rd, hi32);
+            if (hi32)
+                rldicr(rd, rd, 32, 31);
+        } else {
+            lis(rd, int16_t(hi32 >> 16));
+            if (uint32_t(hi32) & 0xffff)
+                ori(rd, rd, uint32_t(hi32) & 0xffff);
+            rldicr(rd, rd, 32, 31);
+        }
+        if (lo32 >> 16)
+            oris(rd, rd, lo32 >> 16);
+        if (lo32 & 0xffff)
+            ori(rd, rd, lo32 & 0xffff);
+    }
+
+    // Write a 64-bit constant into an already-emitted fixed-width ladder.
+    // The ladder written here is always five words, so that a repatch never
+    // has to move anything: unused slots become `nop`. `patchLoadImmediate64`
+    // and `readLoadImmediate64` are the only two functions that may assume
+    // this layout.
+    static constexpr unsigned fixedLoadImmediate64Size = 5;
+
+    static void writeFixedLoadImmediate64(uint32_t* where, RegisterID rd, int64_t value)
+    {
+        uint32_t hi32 = uint32_t(uint64_t(value) >> 32);
+        uint32_t lo32 = uint32_t(uint64_t(value) & 0xffffffff);
+        where[0] = formD(15, rd, 0, int32_t(int16_t(hi32 >> 16)));                // lis rd, hi16
+        where[1] = formD(24, rd, rd, int32_t(hi32 & 0xffff));                     // ori rd, rd, hi lo16
+        where[2] = formMD(rd, rd, 32, 31, 1, false);                              // rldicr rd, rd, 32, 31
+        where[3] = formD(25, rd, rd, int32_t(lo32 >> 16));                        // oris rd, rd, lo hi16
+        where[4] = formD(24, rd, rd, int32_t(lo32 & 0xffff));                     // ori rd, rd, lo lo16
+    }
+
+    // The destination register of a fixed ladder, read back out of it.
+    //
+    // Every word of the ladder -- and of the placeholder that stands in for
+    // one before linking -- is a D-form instruction whose RT field is the
+    // destination, so bits 21:25 of word 0 identify it in both states. A
+    // patcher MUST recover the register this way instead of assuming one:
+    // moveWithPatch() emits the ladder into whatever register its caller
+    // asked for, and only the call-site placeholder uses r12.
+    static RegisterID readFixedLoadImmediate64Register(const uint32_t* where)
+    {
+        return static_cast<RegisterID>((where[0] >> 21) & 0x1f);
+    }
+
+    static int64_t readFixedLoadImmediate64(const uint32_t* where)
+    {
+        uint64_t hi = uint64_t(uint16_t(where[0] & 0xffff)) << 16;
+        hi |= uint16_t(where[1] & 0xffff);
+        uint64_t lo = uint64_t(uint16_t(where[3] & 0xffff)) << 16;
+        lo |= uint16_t(where[4] & 0xffff);
+        return int64_t((hi << 32) | lo);
+    }
+
+    void emitFixedLoadImmediate64(RegisterID rd, int64_t value)
+    {
+        uint32_t words[fixedLoadImmediate64Size];
+        writeFixedLoadImmediate64(words, rd, value);
+        for (unsigned i = 0; i < fixedLoadImmediate64Size; ++i)
+            insn(words[i]);
+    }
