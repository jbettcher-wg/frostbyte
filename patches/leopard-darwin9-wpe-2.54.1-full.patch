+// trunc_sat_f64x2_*_zero: the f32x4 edge set of testPPC64VectorTruncSat,
+// two lanes at a time, with lanes 2 and 3 required to be zero.
+void testPPC64VectorTruncSatF64()
+{
+    alignas(16) uint8_t out[16];
+    auto run = [&](double a, double b, SIMDSignMode mode, uint32_t e0, uint32_t e1) {
+        alignas(16) const double in[2] = { a, b };
+        ppc64RunVectorUnary(in, out, [=](CCallHelpers& jit, FPRReg x, FPRReg d) {
+            jit.vectorTruncSat(SIMDInfo { SIMDLane::f64x2, mode }, x, d);
+        });
+        ppc64CheckLane<uint32_t>(out, 0, e0);
+        ppc64CheckLane<uint32_t>(out, 1, e1);
+        ppc64CheckLane<uint32_t>(out, 2, 0u);
+        ppc64CheckLane<uint32_t>(out, 3, 0u);
+    };
+    const double qnan = std::numeric_limits<double>::quiet_NaN();
+    const double inf = std::numeric_limits<double>::infinity();
+    run(qnan, inf, SIMDSignMode::Signed, 0, 0x7fffffffu);
+    run(qnan, inf, SIMDSignMode::Unsigned, 0, 0xffffffffu);
+    run(-inf, 2.5, SIMDSignMode::Signed, 0x80000000u, 2);
+    run(-inf, 2.5, SIMDSignMode::Unsigned, 0, 2);
+    run(2147483648.0, -1.5, SIMDSignMode::Signed, 0x7fffffffu, 0xffffffffu);
+    run(2147483648.0, -1.5, SIMDSignMode::Unsigned, 2147483648u, 0);
+    run(4294967296.0, -0.0, SIMDSignMode::Signed, 0x7fffffffu, 0);
+    run(4294967296.0, -0.0, SIMDSignMode::Unsigned, 0xffffffffu, 0);
+}
+
+// Fused multiply-add. Three things are asserted: the arithmetic; that the
+// result is FUSED (lane 3 is (1+e)(1-e) - 1, which is -e^2 with one rounding
+// and exactly 0 with two); and the sign of an exact-zero nmadd result (lane
+// 0 of the second set: -(1*1) + 1 must be +0, which xvnmsuba* would get
+// wrong). Every aliasing of dest with an operand is run.
+void testPPC64VectorFusedMultiplyAdd()
+{
+    const float e = 0x1p-23f;
+    alignas(16) const float a[4] = { 1.5f, -2.0f, 3.0f, 1.0f + e };
+    alignas(16) const float b[4] = { 2.0f, 4.0f, -1.0f, 1.0f - e };
+    alignas(16) const float c[4] = { 1.0f, 1.0f, 1.0f, -1.0f };
+    alignas(16) uint8_t out[16];
+    const FPRReg regs[4] = { FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2, FPRInfo::argumentFPR3 };
+
+    auto run = [&](const void* x, const void* y, const void* z, SIMDLane lane, bool negate, unsigned destIndex) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), regs[0]);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), regs[1]);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR3, 0), regs[2]);
+            if (negate)
+                jit.vectorFusedNegMulAdd(SIMDInfo { lane, SIMDSignMode::None }, regs[0], regs[1], regs[2], regs[destIndex], FPRInfo::argumentFPR5);
+            else
+                jit.vectorFusedMulAdd(SIMDInfo { lane, SIMDSignMode::None }, regs[0], regs[1], regs[2], regs[destIndex], FPRInfo::argumentFPR5);
+            jit.storeVector(regs[destIndex], CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, x, &out[0], y, z);
+    };
+
+    for (unsigned destIndex = 0; destIndex < 4; ++destIndex) {
+        run(a, b, c, SIMDLane::f32x4, false, destIndex);
+        ppc64CheckLane<float>(out, 0, 4.0f);
+        ppc64CheckLane<float>(out, 1, -7.0f);
+        ppc64CheckLane<float>(out, 2, -2.0f);
+        ppc64CheckLane<float>(out, 3, -(e * e));                 // fused: the unfused answer is 0
+        run(a, b, c, SIMDLane::f32x4, true, destIndex);
+        ppc64CheckLane<float>(out, 0, -2.0f);
+        ppc64CheckLane<float>(out, 1, 9.0f);
+        ppc64CheckLane<float>(out, 2, 4.0f);
+        ppc64CheckLane<float>(out, 3, -2.0f + e * e);
+
+        alignas(16) const float ones[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+        run(ones, ones, ones, SIMDLane::f32x4, true, destIndex);
+        ppc64CheckLane<uint32_t>(out, 0, 0u);                    // +0, not -0
+        ppc64CheckLane<uint32_t>(out, 1, 0u);
+
+        alignas(16) const double da[2] = { 1.5, -2.0 };
+        alignas(16) const double db[2] = { 2.0, 4.0 };
+        alignas(16) const double dc[2] = { 1.0, 1.0 };
+        run(da, db, dc, SIMDLane::f64x2, false, destIndex);
+        ppc64CheckLane<double>(out, 0, 4.0);
+        ppc64CheckLane<double>(out, 1, -7.0);
+        run(da, db, dc, SIMDLane::f64x2, true, destIndex);
+        ppc64CheckLane<double>(out, 0, -2.0);
+        ppc64CheckLane<double>(out, 1, 9.0);
+        alignas(16) const double dones[2] = { 1.0, 1.0 };
+        run(dones, dones, dones, SIMDLane::f64x2, true, destIndex);
+        ppc64CheckLane<uint64_t>(out, 0, 0ull);
+        ppc64CheckLane<uint64_t>(out, 1, 0ull);
+    }
+}
+
+// The relaxed min/max are the one-instruction forms the specification allows,
+// and this pins THAT choice: a NaN operand yields the other operand (minNum).
+// If the lowering is ever changed to the strict NaN-propagating form these
+// rows fire, on purpose.
+void testPPC64VectorRelaxedMinMax()
+{
+    alignas(16) const float a[4] = { std::numeric_limits<float>::quiet_NaN(), 2.0f, 1.0f, -4.25f };
+    alignas(16) const float b[4] = { 2.0f, std::numeric_limits<float>::quiet_NaN(), -1.0f, 4.25f };
+    alignas(16) uint8_t out[16];
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMin(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<float>(out, 0, 2.0f);
+    ppc64CheckLane<float>(out, 1, 2.0f);
+    ppc64CheckLane<float>(out, 2, -1.0f);
+    ppc64CheckLane<float>(out, 3, -4.25f);
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMax(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<float>(out, 0, 2.0f);
+    ppc64CheckLane<float>(out, 1, 2.0f);
+    ppc64CheckLane<float>(out, 2, 1.0f);
+    ppc64CheckLane<float>(out, 3, 4.25f);
+
+    alignas(16) const double da[2] = { 1.0, -3.5 };
+    alignas(16) const double db[2] = { -1.0, 3.5 };
+    ppc64RunVectorBinary(da, db, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMin(SIMDInfo { SIMDLane::f64x2, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<double>(out, 0, -1.0);
+    ppc64CheckLane<double>(out, 1, -3.5);
+    ppc64RunVectorBinary(da, db, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMax(SIMDInfo { SIMDLane::f64x2, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<double>(out, 0, 1.0);
+    ppc64CheckLane<double>(out, 1, 3.5);
+}
