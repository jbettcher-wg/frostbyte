+    // ---- the link register ----
+    //
+    // There is deliberately no `linkRegister` GPR constant: on PowerPC the
+    // link register is an SPR reached through mflr/mtlr, and inventing a
+    // GPRReg for it would let generic ARM64/RISCV64-shaped code compile into
+    // something that reads the wrong register. Anything that needs the
+    // return address goes through one of these instead, and the call sites
+    // in AssemblyHelpers and CCallHelpers name PPC64 explicitly.
+
+    void moveFromLinkRegister(RegisterID dest) { m_assembler.mflr(dest); }
+    void moveToLinkRegister(RegisterID src) { m_assembler.mtlr(src); }
+
+    void loadToLinkRegister(Address address)
+    {
+        auto temp = temps<Data>();
+        load64(address, temp.data());
+        m_assembler.mtlr(temp.data());
+    }
+
+    // The JS frame prologue/epilogue pair. This must produce exactly the
+    // frame the LLInt builds, because the two call each other:
+    //   [cfr + 0] CallerFrame (the caller's cfr)
+    //   [cfr + 8] ReturnPC
+    // which is what offlineasm's `push cfr, lr` lowers to. r0 is the shuttle
+    // for the link register -- not a pooled temporary, because the very
+    // first instruction of a prologue runs before anything has been saved
+    // and must not destroy a caller's register. That was defect 1 of the
+    // LLInt bring-up.
+    void pushFramePointerAndLinkRegister()
+    {
+        m_assembler.mflr(PPC64Registers::r0);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, -16);
+        m_assembler.std(framePointerRegister, PPC64Registers::r1, 0);
+        m_assembler.std(PPC64Registers::r0, PPC64Registers::r1, 8);
+    }
+
+    void popFramePointerAndLinkRegister()
+    {
+        m_assembler.ld(PPC64Registers::r0, PPC64Registers::r1, 8);
+        m_assembler.ld(framePointerRegister, PPC64Registers::r1, 0);
+        m_assembler.mtlr(PPC64Registers::r0);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, 16);
+    }
+    // ==================================================================
+    // Comparisons.
+    //
+    // On PowerPC the signedness of a comparison is a property of the COMPARE
+    // instruction, not of the branch: cmpw/cmpd are signed, cmplw/cmpld
+    // unsigned, and both set the same LT/GT/EQ bits. So every one of these
+    // returns a CRTest saying which CR0 bit the caller should look at and in
+    // which sense, and the caller turns that into either a branch or a 0/1
+    // value. Nothing may be emitted between the compare and its use, because
+    // CR0 is scratch.
+    //
+    // The 32-bit compares need no extension of their operands: cmpw and
+    // cmplw read only bits 32:63.
+    // ==================================================================
+
+    static bool isUnsigned(RelationalCondition cond)
+    {
+        return Assembler::isUnsignedCondition(static_cast<Assembler::Condition>(cond));
+    }
+
+    CRTest emitCompare32(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        if (isUnsigned(cond))
+            m_assembler.cmplw(CRField::CR0, left, right);
+        else
+            m_assembler.cmpw(CRField::CR0, left, right);
+        return crTestFor(cond);
+    }
+
+    CRTest emitCompare32(RelationalCondition cond, RegisterID left, TrustedImm32 imm)
+    {
+        if (isUnsigned(cond)) {
+            uint32_t value = static_cast<uint32_t>(imm.m_value);
+            if (value <= 0xffff) {
+                m_assembler.cmplwi(CRField::CR0, left, value);
+                return crTestFor(cond);
+            }
+        } else if (Assembler::isValidSigned16(imm.m_value)) {
+            m_assembler.cmpwi(CRField::CR0, left, imm.m_value);
+            return crTestFor(cond);
+        }
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        return emitCompare32(cond, left, temp.data());
+    }
+
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        if (isUnsigned(cond))
+            m_assembler.cmpld(CRField::CR0, left, right);
+        else
+            m_assembler.cmpd(CRField::CR0, left, right);
+        return crTestFor(cond);
+    }
+
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, int64_t value)
+    {
+        if (isUnsigned(cond)) {
+            if (value >= 0 && value <= 0xffff) {
+                m_assembler.cmpldi(CRField::CR0, left, static_cast<uint32_t>(value));
+                return crTestFor(cond);
+            }
+        } else if (Assembler::isValidSigned16(value)) {
+            m_assembler.cmpdi(CRField::CR0, left, static_cast<int32_t>(value));
+            return crTestFor(cond);
+        }
+        auto temp = temps<Data>();
+        m_assembler.loadImmediate64(temp.data(), value);
+        return emitCompare64(cond, left, temp.data());
+    }
+
+    // A TrustedImm32 compared against a 64-bit register means the
+    // sign-extended value.
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, TrustedImm32 imm)
+    {
+        return emitCompare64(cond, left, static_cast<int64_t>(imm.m_value));
+    }
+
+    // ---- ResultCondition: the state of a value that an operation produced ----
+
+    static CRTest crTestForResult(ResultCondition cond)
+    {
+        switch (cond) {
+        case Zero:           return { CRBit::EQ, true };
+        case NonZero:        return { CRBit::EQ, false };
+        case Signed:         return { CRBit::LT, true };
+        case PositiveOrZero: return { CRBit::LT, false };
+        case Overflow:
+        case Carry:
+            // These do not come from comparing a result against zero; the
+            // arithmetic helpers below produce their own CRTest. Reaching
+            // here means a caller asked for one on an operation that cannot
+            // produce it.
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return { CRBit::EQ, true };
+    }
+
+    CRTest emitTestResult32(ResultCondition cond, RegisterID value)
+    {
+        m_assembler.cmpwi(CRField::CR0, value, 0);
+        return crTestForResult(cond);
+    }
+
+    CRTest emitTestResult64(ResultCondition cond, RegisterID value)
+    {
+        m_assembler.cmpdi(CRField::CR0, value, 0);
+        return crTestForResult(cond);
+    }
+
+    // reg & mask, compared against zero. A mask of -1 means "the value
+    // itself", which is the default JSC passes for a plain "is it zero".
+    CRTest emitTest32(ResultCondition cond, RegisterID reg, TrustedImm32 mask)
+    {
+        if (mask.m_value == -1)
+            return emitTestResult32(cond, reg);
+        if (auto test = emitTestRecordForm(cond, reg, static_cast<uint32_t>(mask.m_value)))
+            return *test;
+        auto temp = temps<Data>();
+        and32(mask, reg, temp.data());
+        return emitTestResult32(cond, temp.data());
+    }
+
+    CRTest emitTest32(ResultCondition cond, RegisterID reg, RegisterID mask)
+    {
+        if (reg == mask)
+            return emitTestResult32(cond, reg);
+        auto temp = temps<Data>();
+        m_assembler.and_(temp.data(), reg, mask);
+        return emitTestResult32(cond, temp.data());
+    }
+
+    CRTest emitTest64(ResultCondition cond, RegisterID reg, TrustedImm32 mask)
+    {
+        if (mask.m_value == -1)
+            return emitTestResult64(cond, reg);
+        if (mask.m_value >= 0) {
+            if (auto test = emitTestRecordForm(cond, reg, static_cast<uint32_t>(mask.m_value)))
+                return *test;
+        }
+        auto temp = temps<Data>();
+        and64(mask, reg, temp.data());
+        return emitTestResult64(cond, temp.data());
+    }
+
+    CRTest emitTest64(ResultCondition cond, RegisterID reg, TrustedImm64 mask)
+    {
+        if (mask.m_value == -1)
+            return emitTestResult64(cond, reg);
+        if (mask.m_value >= 0 && mask.m_value <= 0xffffffff) {
+            if (auto test = emitTestRecordForm(cond, reg, static_cast<uint32_t>(mask.m_value)))
+                return *test;
+        }
+        auto temp = temps<Data>();
+        and64(mask, reg, temp.data());
+        return emitTestResult64(cond, temp.data());
+    }
+
+    CRTest emitTest64(ResultCondition cond, RegisterID reg, RegisterID mask)
+    {
+        if (reg == mask)
+            return emitTestResult64(cond, reg);
+        auto temp = temps<Data>();
+        // and. compares the full 64-bit result with zero: exactly the 64-bit test.
+        m_assembler.and__(temp.data(), reg, mask);
+        return crTestForResult(cond);
+    }
+
+    // reg & mask for a mask with no bits above 31, done with andi./andis. when the mask
+    // fits one of them. Returns nothing when it does not.
+    std::optional<CRTest> emitTestRecordForm(ResultCondition cond, RegisterID reg, uint32_t mask)
+    {
+        if (cond != Zero && cond != NonZero && cond != Signed && cond != PositiveOrZero)
+            return std::nullopt;
+        if (mask <= 0xffff) {
+            auto temp = temps<Data>();
+            m_assembler.andi_(temp.data(), reg, mask);
+            return crTestForResult(cond);
+        }
+        if (!(mask & 0xffff) && (cond == Zero || cond == NonZero)) {
+            auto temp = temps<Data>();
+            m_assembler.andis_(temp.data(), reg, mask >> 16);
+            return crTestForResult(cond);
+        }
+        return std::nullopt;
+    }
