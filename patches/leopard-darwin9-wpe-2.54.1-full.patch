+// Group 0 of the VSX MacroAssembler work: the 128-bit move/load/store seam.
+//
+// The pattern is deliberately LANE-DISTINCT (bytes 0x00..0x0f). A uniform or
+// doubleword-symmetric pattern cannot detect a permutation, and the POWER8
+// fallback here is exactly a permutation risk: lxvd2x/stxvd2x swap the two
+// doublewords on little-endian, so a missing xxswapd returns the halves
+// exchanged while every byte value is still "present".
+//
+// Both arms of the hasISA30() seam are run. Forcing the POWER8 path on POWER9
+// silicon is the only way that arm is ever executed here.
+static void testPPC64VectorLoadStoreRoundTripOnce(bool forcePOWER8)
+{
+    PPC64Assembler::forcePOWER8Paths() = forcePOWER8;
+
+    alignas(16) uint8_t src[16];
+    alignas(16) uint8_t dst[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        src[i] = static_cast<uint8_t>(i);
+        dst[i] = 0xa5;
+    }
+
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        // argumentGPR0 = src, argumentGPR1 = dst.
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        // moveVector must carry all 16 bytes, not the scalar doubleword.
+        jit.moveVector(FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+        jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    invoke<void>(test, &src[0], &dst[0]);
+    for (unsigned i = 0; i < 16; ++i)
+        CHECK_EQ(dst[i], static_cast<uint8_t>(i));
+
+    PPC64Assembler::forcePOWER8Paths() = false;
+}
