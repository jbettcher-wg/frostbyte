+    // ==================================================================
+    // Patchable constants.
+    //
+    // Every patchable constant is the FIXED five-word ladder
+    // (lis/ori/rldicr/oris/ori), never the shortened one that
+    // loadImmediate64 would pick, so that repatching a small value with a
+    // large one does not need to move anything. writeFixedLoadImmediate64
+    // and readFixedLoadImmediate64 are the only two functions allowed to
+    // assume that layout.
+    // ==================================================================
+
+    DataLabelPtr moveWithPatch(TrustedImmPtr imm, RegisterID dest)
+    {
+        DataLabelPtr label(this);
+        m_assembler.emitFixedLoadImmediate64(dest, reinterpret_cast<int64_t>(imm.m_value));
+        return label;
+    }
+
+    DataLabel32 moveWithPatch(TrustedImm32 imm, RegisterID dest)
+    {
+        DataLabel32 label(this);
+        m_assembler.emitFixedLoadImmediate64(dest, static_cast<int64_t>(imm.m_value));
+        return label;
+    }
+
+    DataLabelPtr storePtrWithPatch(TrustedImmPtr imm, Address address)
+    {
+        auto temp = temps<Data>();
+        DataLabelPtr label = moveWithPatch(imm, temp.data());
+        store64(temp.data(), address);
+        return label;
+    }
+
+    DataLabelPtr storePtrWithPatch(Address address) { return storePtrWithPatch(TrustedImmPtr(nullptr), address); }
+
+    Jump branchPtrWithPatch(RelationalCondition cond, RegisterID left, DataLabelPtr& dataLabel, TrustedImmPtr initialRightValue = TrustedImmPtr(nullptr))
+    {
+        auto temp = temps<Data>();
+        dataLabel = moveWithPatch(initialRightValue, temp.data());
+        return makeBranch(emitCompare64(cond, left, temp.data()));
+    }
+
+    Jump branchPtrWithPatch(RelationalCondition cond, Address address, DataLabelPtr& dataLabel, TrustedImmPtr initialRightValue = TrustedImmPtr(nullptr))
+    {
+        auto temp = temps<Data, Memory>();
+        load64(address, temp.memory());
+        dataLabel = moveWithPatch(initialRightValue, temp.data());
+        return makeBranch(emitCompare64(cond, temp.memory(), temp.data()));
+    }
+
+    Jump branch32WithPatch(RelationalCondition cond, Address address, DataLabel32& dataLabel, TrustedImm32 initialRightValue = TrustedImm32(0))
+    {
+        auto temp = temps<Data, Memory>();
+        load32(address, temp.memory());
+        dataLabel = moveWithPatch(initialRightValue, temp.data());
+        return makeBranch(emitCompare32(cond, temp.memory(), temp.data()));
+    }
+
+    PatchableJump patchableBranch64(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        return PatchableJump(branch64(cond, left, right));
+    }
+    // ---- floating-point conditions ----
+    //
+    // fcmpu sets exactly one of LT, GT, EQ, SO in its target field: SO means
+    // "unordered", i.e. at least one operand is NaN, and in that case LT, GT
+    // and EQ are all clear. Six of JSC's twelve DoubleConditions are single
+    // bits of that; the other six are disjunctions of two, which need a
+    // cror. The result of that cror MUST land in a different field from its
+    // inputs, which is what cr7 is reserved for -- cr2 to cr4 are
+    // callee-saved and are never written by this port.
+    CRTest emitDoubleConditionFromCR0(DoubleCondition cond)
+    {
+        constexpr CRField source = CRField::CR0;
+        constexpr CRField composed = CRField::CR7;
+        auto composeInto = [&](CRBit first, CRBit second) -> CRTest {
+            m_assembler.cror(crBitIndex(composed, CRBit::LT),
+                crBitIndex(source, first), crBitIndex(source, second));
+            return { CRBit::LT, true, composed };
+        };
+
+        switch (cond) {
+        // Single-bit tests.
+        case DoubleEqualAndOrdered:                return { CRBit::EQ, true };
+        case DoubleGreaterThanAndOrdered:          return { CRBit::GT, true };
+        case DoubleLessThanAndOrdered:             return { CRBit::LT, true };
+        // "or unordered" complements of the above: NaN clears the tested bit,
+        // so testing it as FALSE already includes the unordered case.
+        case DoubleNotEqualOrUnordered:            return { CRBit::EQ, false };
+        case DoubleGreaterThanOrEqualOrUnordered:  return { CRBit::LT, false };
+        case DoubleLessThanOrEqualOrUnordered:     return { CRBit::GT, false };
+        // Two-bit disjunctions.
+        case DoubleNotEqualAndOrdered:             return composeInto(CRBit::LT, CRBit::GT);
+        case DoubleGreaterThanOrEqualAndOrdered:   return composeInto(CRBit::GT, CRBit::EQ);
+        case DoubleLessThanOrEqualAndOrdered:      return composeInto(CRBit::LT, CRBit::EQ);
+        case DoubleEqualOrUnordered:               return composeInto(CRBit::EQ, CRBit::SO);
+        case DoubleGreaterThanOrUnordered:         return composeInto(CRBit::GT, CRBit::SO);
+        case DoubleLessThanOrUnordered:            return composeInto(CRBit::LT, CRBit::SO);
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return { CRBit::EQ, true };
+    }
+
+    CRTest emitDoubleCompare(DoubleCondition cond, FPRegisterID a, FPRegisterID b)
+    {
+        // fcmpu, not fcmpo: JSC compares values that may legitimately be
+        // NaN and must not raise an invalid-operation exception for it.
+        m_assembler.fcmpu(CRField::CR0, a, b);
+        return emitDoubleConditionFromCR0(cond);
+    }
+
+    CRTest emitDoubleCompareWithZero(DoubleCondition cond, FPRegisterID reg)
+    {
+        moveZeroToDouble(fpTempRegister);
+        return emitDoubleCompare(cond, reg, fpTempRegister);
+    }
+
+    // fcmpu is a scalar double compare and there is no single-precision
+    // equivalent that yields CR bits -- xvcmp*sp produces lane masks -- so a
+    // float compare widens both operands into the double model first. The
+    // widening is exact and order-preserving, so the twelve DoubleConditions
+    // mean the same thing on the result, NaN included.
+    CRTest emitFloatCompare(DoubleCondition cond, FPRegisterID a, FPRegisterID b)
+    {
+#if CPU(PPC64_E6500)
+        // Floats are already in double format here.
+        return emitDoubleCompare(cond, a, b);
+#endif
+        convertFloatToDouble(a, fpTempRegister);
+        convertFloatToDouble(b, fpTempRegister2);
+        return emitDoubleCompare(cond, fpTempRegister, fpTempRegister2);
+    }
+
+    CRTest emitFloatCompareWithZero(DoubleCondition cond, FPRegisterID reg)
+    {
+#if CPU(PPC64_E6500)
+        return emitDoubleCompareWithZero(cond, reg);
+#endif
+        convertFloatToDouble(reg, fpTempRegister);
+        m_assembler.xxlxor(fpTempRegister2, fpTempRegister2, fpTempRegister2);
+        return emitDoubleCompare(cond, fpTempRegister, fpTempRegister2);
+    }
+
+    Jump branchDouble(DoubleCondition cond, FPRegisterID a, FPRegisterID b) { return makeBranch(emitDoubleCompare(cond, a, b)); }
+    Jump branchFloat(DoubleCondition cond, FPRegisterID a, FPRegisterID b) { return makeBranch(emitFloatCompare(cond, a, b)); }
+    Jump branchDoubleWithZero(DoubleCondition cond, FPRegisterID reg) { return makeBranch(emitDoubleCompareWithZero(cond, reg)); }
+    Jump branchFloatWithZero(DoubleCondition cond, FPRegisterID reg) { return makeBranch(emitFloatCompareWithZero(cond, reg)); }
+
+    Jump branchDoubleNonZero(FPRegisterID reg, FPRegisterID) { return branchDoubleWithZero(DoubleNotEqualAndOrdered, reg); }
+    Jump branchDoubleZeroOrNaN(FPRegisterID reg, FPRegisterID) { return branchDoubleWithZero(DoubleEqualOrUnordered, reg); }
+
+    void compareDouble(DoubleCondition cond, FPRegisterID a, FPRegisterID b, RegisterID dest) { emitSetFromCR0(emitDoubleCompare(cond, a, b), dest); }
+    void compareFloat(DoubleCondition cond, FPRegisterID a, FPRegisterID b, RegisterID dest) { emitSetFromCR0(emitFloatCompare(cond, a, b), dest); }
+    void compareDoubleWithZero(DoubleCondition cond, FPRegisterID reg, RegisterID dest) { emitSetFromCR0(emitDoubleCompareWithZero(cond, reg), dest); }
+    void compareFloatWithZero(DoubleCondition cond, FPRegisterID reg, RegisterID dest) { emitSetFromCR0(emitFloatCompareWithZero(cond, reg), dest); }
+
+    // Truncate toward zero into an int32, and report whether the value was
+    // representable. The test is a round trip against friz(src), which is
+    // exact: it succeeds precisely when trunc(src) fits in an int32 and src
+    // is not NaN. Checking the saturated result against INT32_MIN/MAX
+    // instead would misreport the values that legitimately truncate to those.
+    Jump branchTruncateDoubleToInt32(FPRegisterID src, RegisterID dest, BranchTruncateType branchType = BranchIfTruncateFailed)
+    {
+#if CPU(PPC64_E6500)
+        // No friz. Truncate to int64 instead -- saturating, NaN to INT64_MIN
+        // -- and ask whether that fits in an int32: the same question as the
+        // round trip against trunc(src), with no double compare at all.
+        // r0 carries the 64-bit result; cmpd reads it as RA, which is a
+        // register there, not the literal zero.
+        m_assembler.fctidz(fpTempRegister, src);
+        m_assembler.stfd(fpTempRegister, PPC64Registers::r1, e6500Slot0);
+        m_assembler.ld(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0);
+        m_assembler.extsw(dest, PPC64Registers::r0);
+        m_assembler.cmpd(CRField::CR0, PPC64Registers::r0, dest);
+        m_assembler.clrldi(dest, dest, 32); // the 32-bit invariant; does not touch CR0
+        return makeBranch({ CRBit::EQ, branchType == BranchIfTruncateSuccessful });
+#endif
+        m_assembler.friz(fpTempRegister2, src);      // trunc(src), still a double
+        m_assembler.fctiwz(fpTempRegister, src);     // saturating 32-bit convert
+        m_assembler.mfvsrwz(dest, fpTempRegister);
+        m_assembler.mtvsrwa(fpTempRegister, dest);
+        m_assembler.fcfid(fpTempRegister, fpTempRegister);
+        m_assembler.fcmpu(CRField::CR0, fpTempRegister, fpTempRegister2);
+        return makeBranch(emitDoubleConditionFromCR0(
+            branchType == BranchIfTruncateSuccessful ? DoubleEqualAndOrdered : DoubleNotEqualOrUnordered));
+    }
+
+    // Convert to an int32, and fail unless the double was EXACTLY that
+    // int32. This is not branchTruncateDoubleToInt32 with a different name:
+    // that one asks whether trunc(src) fits, and answers yes for 5.25. This
+    // one asks whether src is an integer at all, so the round trip has to be
+    // compared against `src` itself and never against trunc(src) -- the same
+    // thing ARM64 does with fcvtns/scvtf. Delegating to the truncating form
+    // made JITDivGenerator decide that 21/4 "is actually an integer" and
+    // hand JavaScript back the number 5.
+    void branchConvertDoubleToInt32(FPRegisterID src, RegisterID dest, JumpList& failureCases, FPRegisterID, bool negZeroCheck = true)
+    {
+        m_assembler.fctiwz(fpTempRegister, src);     // saturating 32-bit convert
+#if CPU(PPC64_E6500)
+        // fctiwz leaves the word in the low half of the FPR, which stfd puts
+        // at +4 on this big-endian target. lwz gives the zero-extended result,
+        // lwa the sign-extended one fcfid needs for the round trip.
+        m_assembler.stfd(fpTempRegister, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lwz(dest, PPC64Registers::r1, e6500Slot0 + 4);
+        m_assembler.lwa(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0 + 4);
+        m_assembler.std(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfd(fpTempRegister, PPC64Registers::r1, e6500Slot0);
+#else
+        m_assembler.mfvsrwz(dest, fpTempRegister);
+        m_assembler.mtvsrwa(fpTempRegister, dest);
+#endif
+        m_assembler.fcfid(fpTempRegister, fpTempRegister);
+        // Unordered covers NaN; saturation covers out-of-range, because a
+        // saturated result cannot compare equal to the value that saturated
+        // it. A fractional value fails here and only here.
+        failureCases.append(makeBranch(emitDoubleCompare(DoubleNotEqualOrUnordered, fpTempRegister, src)));
+        if (!negZeroCheck)
+            return;
+        // A result of zero is ambiguous between +0.0 and -0.0, and JSC needs
+        // -0.0 to fail so it stays a double. The sign bit of the ORIGINAL
+        // value is the only place that survives the conversion.
+        Jump notZero = branchTest32(NonZero, dest);
+        auto temp = temps<Data>();
+        moveDoubleTo64(src, temp.data());
+        failureCases.append(makeBranch(emitCompare64(LessThan, temp.data(), static_cast<int64_t>(0))));
+        notZero.link(this);
+    }
+    // Indirect call through `target`. For a C callee, ELFv2 wants the entry
+    // address in r12 as well as in CTR, because the callee's global entry
+    // point computes its own TOC from r12. For generated code r12 must be
+    // left alone: it is regT9, which is also GPRInfo::handlerGPR, and an
+    // inline-cache handler is passed to its callee in exactly that register.
+    void emitIndirectCall(RegisterID target, bool isNativeCallee)
+    {
+        if (!isNativeCallee) {
+            m_assembler.mtctr(target);
+            m_assembler.bctrl();
+            return;
+        }
+        if (target != PPC64Registers::r12)
+            m_assembler.mr(PPC64Registers::r12, target);
+        m_assembler.mtctr(PPC64Registers::r12);
+        emitCCallLinkageAreaSetup();
+        m_assembler.bctrl();
+    }
+
+    // A patchable call to an address not known until link time. The target
+    // is a C function outside the executable pool, so this is the seven-word
+    // pointer site: five words of constant ladder that linkPointer() fills
+    // in, then mtctr/bctrl.
+    Call call(PtrTag tag)
+    {
+        bool isNative = callTargetIsNativeCode(tag);
+        if (isNative)
+            emitCCallLinkageAreaSetup();
+        auto label = m_assembler.label();
+        m_assembler.emitPointerCallSitePlaceholder();
+        Call result(label, Call::Linkable);
+        if (isNative)
+            emitCCallLinkageAreaTeardown();
+        return result;
+    }
+
+    Call call(RegisterID target, PtrTag tag)
+    {
+        bool isNative = callTargetIsNativeCode(tag);
+        emitIndirectCall(target, isNative);
+        // The label is the return address, taken before the teardown so it
+        // is the address the callee will actually return to.
+        Call result(m_assembler.labelIgnoringWatchpoints(), Call::None);
+        if (isNative)
+            emitCCallLinkageAreaTeardown();
+        return result;
+    }
+
+    Call call(Address address, PtrTag tag)
+    {
+        bool isNative = callTargetIsNativeCode(tag);
+        RegisterID target = isNative ? PPC64Registers::r12 : static_cast<RegisterID>(dataTempRegister);
+        load64(address, target);
+        return call(target, tag);
+    }
+
+    // The dynamic-tag overloads (ARM64E pointer authentication). Nothing in
+    // this port can tell a C target from a JIT one at run time, and choosing
+    // wrongly corrupts a stack either way, so these refuse rather than pick.
+    Call call(RegisterID) { UNREACHABLE_FOR_PLATFORM(); return { }; }
+    Call call(RegisterID, RegisterID) { UNREACHABLE_FOR_PLATFORM(); return { }; }
+    Call call(Address, RegisterID) { UNREACHABLE_FOR_PLATFORM(); return { }; }
+
+    // Routed through call(RegisterID, PtrTag) on purpose: implementing this
+    // as a bare bctrl -- which is what MacroAssemblerRISCV64 and
+    // MacroAssemblerX86_64 do -- would bypass the linkage-area logic, and
+    // callOperation is the hottest C++ call in the Baseline tier
+    // (jit/SlowPathCall.cpp).
+    template<PtrTag tag>
+    void callOperation(const CodePtr<tag> operation)
+    {
+        auto temp = temps<Data>();
+        move(TrustedImmPtr(operation.taggedPtr()), temp.data());
+        call(temp.data(), tag);
+    }
+
+    // ExceptionOperationResult<T> is `{ T value; Exception* exception; }`.
+    // Spelled structurally rather than by name so this header does not have
+    // to include jit/OperationResult.h.
+    template<typename T>
+    static constexpr bool isFloatingPointExceptionOperationResult()
+    {
+        if constexpr (requires (T t) { t.value; t.exception; })
+            return std::is_floating_point_v<std::remove_cvref_t<decltype(std::declval<T>().value)>>;
+        else
+            return false;
+    }
+
+    // The one seam between ELFv2's float convention and this port's float
+    // register model. ELFv2 returns a bare float in f1 in DOUBLE format; the
+    // model wants the raw single in the low word. Hooking it here means a
+    // float-returning operation added upstream needs no site: WTF::CodePtr
+    // converts implicitly from Out(*)(In...), so a
+    // callOperation<tag>(someOperation) that would otherwise land on the
+    // CodePtr overload above lands here instead and gets the conversion.
+    //
+    // Float FPR *arguments* cannot occur: CCallHelpers::setupArgumentsImpl
+    // static_asserts that an FPR argument is a double.
+    //
+    // The hazard this does NOT cover is a float-returning operation reached
+    // some other way -- move(TrustedImmPtr(fn)) then call(reg), or an
+    // offlineasm cCall. That is silent, and the grep for it is
+    // `grep -rn 'JIT_OPERATION(.*, float,' Source/JavaScriptCore` at every
+    // rebase. See jsc-ppc64le-yarr-wasm.md section 7.7.
+    template<PtrTag tag, typename Out, typename... In>
+    void callOperation(Out (*operation)(In...))
+    {
+        static_assert(!isFloatingPointExceptionOperationResult<Out>(),
+            "A floating-point operation result must not be wrapped in ExceptionOperationResult on this "
+            "target: ELFv2 returns the {float, Exception*} aggregate in r3:r4, not f1. Restore the "
+            "CPU(PPC64) arm of canMakeExceptionOperationResult in jit/OperationResult.h.");
+        callOperation<tag>(CodePtr<tag>(operation));
+        if constexpr (std::is_same_v<Out, float>) {
+            // Exact: the value is already single-valued, this only moves it
+            // from double format into the low word.
+            convertDoubleToFloat(PPC64Registers::f1, PPC64Registers::f1);
+        }
+    }
+
+    void getEffectiveAddress(BaseIndex address, RegisterID dest)
+    {
+        auto resolution = resolveAddress(address, dest, false);
+        if (resolution.offset)
+            addImmediate64(resolution.base, resolution.offset, dest);
+        else
+            move(resolution.base, dest);
+    }
+    // ==================================================================
+    // Floating point.
+    //
+    // THE e6500 FLOAT REGISTER MODEL (CPU(PPC64_E6500)). The e6500 has no
+    // VSX, so the model below cannot be implemented. A float lives in an FPR
+    // in DOUBLE format holding a single-representable value, which is the
+    // classic PowerPC convention and the ABI's: lfs/stfs widen and narrow
+    // exactly, fadds/fsubs/fmuls/fdivs round to single, frsp narrows, and
+    // widening is a no-op. Code that moves a float's raw bits goes through
+    // memory (move32ToFloat/moveFloatTo32). The places upstream relies on raw
+    // bits in a register are wasm's (IPInt slots, globals, packed fields);
+    // WebAssembly is off on this port.
+    //
+    // THE FLOAT REGISTER MODEL. A "float" lives in an FPR as its raw 32-bit
+    // IEEE single pattern in the low word of doubleword 0 -- ISA word 1, the
+    // word mfvsrwz reads and stfd puts at byte offset 0 -- and the other 96
+    // bits of the register are don't-care. That is the invariant ARM64
+    // (fmov<32>), X86_64 (the low xmm lane) and RISCV64 (fmv.x.w) all
+    // provide, and shared code depends on it in places that have no type
+    // information at all: IPInt's 16-byte value slots, wasm globals, packed
+    // struct and array fields, f32.reinterpret_i32. See
+    // jsc-ppc64le-yarr-wasm.md section 7.
+    //
+    // It is NOT ELFv2's model, which keeps a float in an FPR in double
+    // format -- so this port carries two conventions for one register class
+    // and converts at the seam. The seam is exactly one shape: a
+    // float-returning JIT operation, hooked once in callOperation below.
+    // Float FPR *arguments* cannot occur (CCallHelpers static_asserts them
+    // away) and every other crossing to C is through memory, where ELFv2's
+    // format for a float is the raw single -- this model's own.
+    //
+    // Mechanically: the xv*sp vector family computes each 32-bit lane
+    // independently, so f32 arithmetic is one instruction on a register
+    // whose other lanes hold garbage; lxsiwzx/stxsiwx and mtvsrwz/mfvsrwz
+    // move the word; and the two conversions to and from the double model
+    // are a splat plus xscvspdpn / xscvdpsp plus a splat.
+    // ==================================================================
+
+#if CPU(PPC64_E6500)
+    // ==================================================================
+    // e6500 helpers.
+    //
+    // Values cross between the GPR and FPR files through the red zone below
+    // r1 (288 bytes in the Darwin ppc64 ABI; the kernel's signal delivery
+    // skips it). Measured 25 ns per FPR->GPR crossing on the e6500, which is
+    // the e6500's load-hit-store penalty and the price of having no direct
+    // moves. r0 is the GPR these sequences use when they need one that is
+    // not an operand: no allocator hands it out and nothing keeps a value in
+    // it across MacroAssembler operations. Remember that r0 in the RA field
+    // of addi/addis and of every load and store reads as the literal zero;
+    // it is only ever an RS/RT/RB operand below.
+    // ==================================================================
+    static constexpr int e6500Slot0 = -8;
+    static constexpr int e6500Slot1 = -16;
+    static constexpr int e6500Slot2 = -24;
+    static constexpr int e6500Slot3 = -32;
+
+    void e6500GPRToFPR(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.std(src, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfd(dest, PPC64Registers::r1, e6500Slot0);
+    }
+
+    // WebAssembly's float-in-FPR convention on this port is IPInt's: the raw
+    // 32-bit single in the LOW word of the register image (the word stfd puts
+    // at +4), where this MacroAssembler keeps a float in double format. BBQ
+    // converts at the boundaries where a float crosses in an FPR -- incoming
+    // arguments, outgoing arguments, return values, call results, OSR -- and
+    // computes in the double format in between. Both conversions are exact,
+    // NaN payloads included (lfs/stfs do not quiet).
+    void convertWasmRawFloatToFloat(FPRegisterID reg)
+    {
+        m_assembler.stfd(reg, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfs(reg, PPC64Registers::r1, e6500Slot0 + 4);
+    }
+
+    void convertFloatToWasmRawFloat(FPRegisterID reg)
+    {
+        m_assembler.stfs(reg, PPC64Registers::r1, e6500Slot0 + 4);
+        m_assembler.li(PPC64Registers::r0, 0);
+        m_assembler.stw(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfd(reg, PPC64Registers::r1, e6500Slot0);
+    }
+
+    void e6500FPRToGPR(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.stfd(src, PPC64Registers::r1, e6500Slot0);
+        m_assembler.ld(dest, PPC64Registers::r1, e6500Slot0);
+    }
+
+    // Darwin's PPC commpage (osfmk/ppc/cpu_capabilities.h) keeps the double 2^52 at
+    // _COMM_PAGE_2_TO_52, 0x40 bytes into the page at -32768; 64-bit processes see it at
+    // 0xffffffffffff8040. With RA = 0, `lfd f, d(0)` addresses the sign-extended d, so
+    // that constant is one load away with no base register and no store before it.
+    static constexpr int32_t commpage2To52Displacement = -0x8000 + 0x40;
+    // Whether that word really holds 2^52 (checked once; false off Darwin) and
+    // JSC_usePPC64CommpageConstants is on.
+    static bool canUseCommpage2To52();
+
+    // +0.0 needs no GPR operand and no scratch register, which matters
+    // because Air asks for it with the macro scratch forbidden.
+    //
+    // The e6500 does not forward a GPR store to an FPR load: `std; lfd` of the same
+    // slot waits ~12 cycles for the store to leave the store queue, and later loads
+    // queue behind it (tests/jsc-perf/probes/xprobe.c). Zero is the most common FP
+    // constant (every `x < 0`, `x == 0`), so it comes from the commpage instead:
+    // 2^52 - 2^52 is exactly +0.0 in the default round-to-nearest mode, which JS never
+    // changes. Two instructions, no store, no GPR.
+    void e6500MoveZero(FPRegisterID dest)
+    {
+        if (canUseCommpage2To52()) {
+            m_assembler.lfd(dest, PPC64Registers::r0, commpage2To52Displacement);
+            m_assembler.fsub(dest, dest, dest);
+            return;
+        }
+        m_assembler.li(PPC64Registers::r0, 0);
+        m_assembler.std(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfd(dest, PPC64Registers::r1, e6500Slot0);
+    }
+
+    // Stores the double whose bit pattern is hi16 << 48 at offset(r1). Every
+    // constant the sequences below need has that shape (2^52, 1.0, 0.5, 2^63).
+    void e6500StoreHighConstant(uint16_t hi16, int offset)
+    {
+        m_assembler.lis(PPC64Registers::r0, static_cast<int16_t>(hi16));
+        m_assembler.sldi(PPC64Registers::r0, PPC64Registers::r0, 32);
+        m_assembler.std(PPC64Registers::r0, PPC64Registers::r1, offset);
+    }
+
+    void e6500LoadHighConstant(uint16_t hi16, FPRegisterID dest, int offset = e6500Slot0)
+    {
+        e6500StoreHighConstant(hi16, offset);
+        m_assembler.lfd(dest, PPC64Registers::r1, offset);
+    }
+
+    // Two FPRs that are neither operand nor one of the macro temps, for the
+    // sqrt sequence to borrow. They are saved to and restored from the red
+    // zone around their use.
+    static std::pair<FPRegisterID, FPRegisterID> e6500BorrowableFPRs(FPRegisterID a, FPRegisterID b)
+    {
+        FPRegisterID found[2];
+        unsigned count = 0;
+        for (unsigned i = 1; i <= 12 && count < 2; ++i) {
+            auto reg = static_cast<FPRegisterID>(static_cast<unsigned>(PPC64Registers::f0) + i);
+            if (reg != a && reg != b)
+                found[count++] = reg;
+        }
+        return { found[0], found[1] };
+    }
+
+    // sqrt without fsqrt, for classic (non-VSX) PowerPC cores that lack it; a core
+    // with hardware fsqrt gets the instruction (cpuHasHardwareSqrt, below). The e6500
+    // traps fsqrt to the kernel's emulator
+    // (about 2.4 us, and the emulator's instruction fetch from a JIT page above
+    // 4 GiB is where the Book-E "TLB fill that does not stick" panic was seen);
+    // frsqrte is native. Two Newton steps on g ~ sqrt(x) and h ~ 1/(2 sqrt(x))
+    // take the 12-bit estimate past 48 bits and a final fused correction rounds
+    // correctly: bit-identical to libm's correctly rounded sqrt on 50,000,012
+    // inputs, 35.5 ns against libm's 79.8 ns (probes/fastsqrt.c, README 13.1).
+    // The core needs a normal positive x in [2^-960, 2^1024). Nothing here
+    // emits fsqrt any more:
+    //   +-0 and +inf     -> x itself (IEEE sqrt(-0) is -0)
+    //   NaN, x < 0, -inf -> the canonical quiet NaN (JSC's PNaN)
+    //   0 < x < 2^-960   -> sqrt(x * 2^1022) * 2^-511; both scalings are exact
+    //                       powers of two and the result is a normal number.
+    void e6500SqrtCore(FPRegisterID src, FPRegisterID dest)
+    {
+        // x is in dest; src is not read.
+        auto [p, q] = e6500BorrowableFPRs(src, dest);
+        FPRegisterID g = fpTempRegister;
+        FPRegisterID h = fpTempRegister2;
+        e6500StoreHighConstant(0x3fe0, e6500Slot1); // 0.5
+        m_assembler.stfd(p, PPC64Registers::r1, e6500Slot2);
+        m_assembler.stfd(q, PPC64Registers::r1, e6500Slot3);
+
+        m_assembler.frsqrte(h, dest);                    // y
+        m_assembler.fmul(g, dest, h);                    // g = x * y
+        m_assembler.lfd(p, PPC64Registers::r1, e6500Slot1);
+        m_assembler.fmul(h, h, p);                       // h = y / 2
+        for (unsigned step = 0; step < 2; ++step) {
+            m_assembler.lfd(p, PPC64Registers::r1, e6500Slot1);
+            m_assembler.fnmsub(p, h, g, p);              // e = 1/2 - h g
+            m_assembler.fnmsub(q, g, g, dest);           // d = x - g g
+            m_assembler.fmadd(g, q, h, g);               // g += d h
+            m_assembler.fmadd(h, p, h, h);               // h += e h
+        }
+        m_assembler.fnmsub(q, g, g, dest);               // d = x - g g
+        m_assembler.fmadd(dest, q, h, g);                // g + d h, correctly rounded
+
+        m_assembler.lfd(p, PPC64Registers::r1, e6500Slot2);
+        m_assembler.lfd(q, PPC64Registers::r1, e6500Slot3);
+    }
+
+    // Whether this CPU executes fsqrt in hardware (G5/970 do; e500/e6500 do not and
+    // trap to the kernel's emulator). Asked once, at run time, of Darwin's
+    // hw.optional.fsqrt (the commpage's kHasFsqrt). Anything unknown answers false,
+    // which selects the trap-free sequence below; JSC_usePPC64HardwareSqrt=0 forces it.
+    static bool cpuHasHardwareSqrt();
+
+    void e6500SqrtDouble(FPRegisterID src, FPRegisterID dest)
+    {
+        ASSERT(dest != fpTempRegister && dest != fpTempRegister2);
+        ASSERT(src != fpTempRegister && src != fpTempRegister2);
+        if (cpuHasHardwareSqrt() && Options::usePPC64HardwareSqrt()) {
+            m_assembler.fsqrt(dest, src);
+            return;
+        }
+        FPRegisterID g = fpTempRegister;
+        // Sign and biased exponent: 63 (2^-960) through 2046 is the fast range.
+        m_assembler.stfd(src, PPC64Registers::r1, e6500Slot0);
+        m_assembler.ld(PPC64Registers::r0, PPC64Registers::r1, e6500Slot0);
+        m_assembler.rldicl(PPC64Registers::r0, PPC64Registers::r0, 12, 52);
+        m_assembler.cmpldi(CRField::CR0, PPC64Registers::r0, 2046);
+        Jump special = makeBranch({ CRBit::GT, true });
+        m_assembler.cmpldi(CRField::CR0, PPC64Registers::r0, 63);
+        Jump tiny = makeBranch({ CRBit::LT, true });
+
+        moveDouble(src, dest);
+        e6500SqrtCore(src, dest);
+        JumpList done;
+        done.append(jump());
+
+        // Positive and below 2^-960: +0, a denormal, or a tiny normal.
+        tiny.link(this);
+        e6500MoveZero(g);
+        m_assembler.fcmpu(CRField::CR0, src, g);
+        Jump notZero = makeBranch({ CRBit::EQ, false });
+        moveDouble(src, dest);                           // sqrt(+0) = +0
+        done.append(jump());
+        notZero.link(this);
+        e6500LoadHighConstant(0x7fd0, g);                // 2^1022
+        m_assembler.fmul(dest, src, g);
+        e6500SqrtCore(src, dest);
+        e6500LoadHighConstant(0x2000, g);                // 2^-511
+        m_assembler.fmul(dest, dest, g);
+        done.append(jump());
+
+        // Sign bit set, or exponent all ones: -0, negatives, +-inf, NaN.
+        special.link(this);
+        e6500MoveZero(g);
+        m_assembler.fcmpu(CRField::CR0, src, g);
+        Jump isNaN = makeBranch({ CRBit::SO, true });    // unordered
+        Jump isNegative = makeBranch({ CRBit::LT, true });
+        moveDouble(src, dest);                           // -0 (equal) or +inf (greater)
+        done.append(jump());
+        isNaN.link(this);
+        isNegative.link(this);
+        e6500LoadHighConstant(0x7ff8, dest);             // PNaN
+        done.link(this);
+    }
+
+    // ceil/floor/trunc/rint without friz/frip/frim. For |x| <= 2^52,
+    // (|x| + 2^52) - 2^52 is rint(|x|) in the default round-to-nearest-even
+    // mode; the sign goes back on with fsel, floor steps down by one where
+    // that overshot, ceil(x) is -floor(-x) and trunc(x) is sign(x) *
+    // floor(|x|). Larger magnitudes, infinities and NaN are already
+    // integral (or NaN) and are returned unchanged, as are both zeros,
+    // which keeps every signed zero JavaScript and wasm require. Uses the
+    // two FP temps, dest, and four red-zone slots, and reads src only before
+    // dest is first written, so src == dest is fine.
+    enum class E6500Rounding : uint8_t { Nearest, Floor, Ceil, Trunc };
+    void e6500RoundDouble(FPRegisterID src, FPRegisterID dest, E6500Rounding mode)
+    {
+        ASSERT(dest != fpTempRegister && dest != fpTempRegister2);
+        FPRegisterID a = fpTempRegister;
+        FPRegisterID b = fpTempRegister2;
+        auto r1 = PPC64Registers::r1;
+        const int magic = e6500Slot0, one = e6500Slot1, operand = e6500Slot2, original = e6500Slot3;
+
+        e6500StoreHighConstant(0x4330, magic); // 2^52
+        if (mode != E6500Rounding::Nearest)
+            e6500StoreHighConstant(0x3ff0, one);
+        m_assembler.stfd(src, r1, original);
+        switch (mode) {
+        case E6500Rounding::Ceil:
+            m_assembler.fneg(a, src);
+            m_assembler.stfd(a, r1, operand);
+            break;
+        case E6500Rounding::Trunc:
+            m_assembler.fabs_(a, src);
+            m_assembler.stfd(a, r1, operand);
+            break;
+        default:
+            m_assembler.stfd(src, r1, operand);
+            break;
+        }
+        m_assembler.lfd(dest, r1, operand);              // x'
+
+        m_assembler.lfd(a, r1, magic);
+        m_assembler.fabs_(b, dest);
+        m_assembler.fadd(b, b, a);
+        m_assembler.fsub(b, b, a);                       // r = rint(|x'|)
+        m_assembler.fneg(a, b);
+        m_assembler.fsel(dest, dest, b, a);              // s = x' >= 0 ? r : -r
+
+        if (mode != E6500Rounding::Nearest) {
+            m_assembler.lfd(a, r1, operand);
+            m_assembler.fsub(a, a, dest);                // x' - s
+            m_assembler.lfd(b, r1, one);
+            m_assembler.fsub(b, dest, b);                // s - 1
+            m_assembler.fsel(dest, a, dest, b);          // floor(x')
+        }
+
+        // |x'| > 2^52, infinity or NaN: x' itself.
+        m_assembler.lfd(a, r1, operand);
+        m_assembler.fabs_(a, a);
+        m_assembler.lfd(b, r1, magic);
+        m_assembler.fsub(b, b, a);
+        m_assembler.lfd(a, r1, operand);
+        m_assembler.fsel(dest, b, dest, a);
+        // x' == +-0: x' itself.
+        m_assembler.fnabs(b, a);
+        m_assembler.fsel(dest, b, a, dest);
+
+        if (mode == E6500Rounding::Ceil)
+            m_assembler.fneg(dest, dest);
+        if (mode == E6500Rounding::Trunc) {
+            m_assembler.lfd(a, r1, original);
+            m_assembler.fneg(b, dest);
+            m_assembler.fsel(dest, a, dest, b);          // sign of x
+            m_assembler.fnabs(b, a);
+            m_assembler.fsel(dest, b, a, dest);          // x == +-0: x
+        }
+        // NaN and +-infinity come back as x itself (a NaN quieted, below):
+        // the steps above can flip a NaN's sign (fsel takes the "negative"
+        // arm for an unordered operand), and B3/wasm compare NaNs
+        // bit-identically. x - x is +0 for every finite x and NaN otherwise.
+        m_assembler.lfd(a, r1, original);
+        m_assembler.fsub(b, a, a);
+        // x + x is x for an infinity and x QUIETED for a NaN: wasm requires an
+        // arithmetic NaN out of floor/ceil/trunc/nearest, and JS only ever
+        // sees NaN as NaN.
+        m_assembler.fadd(a, a, a);
+        m_assembler.fsel(dest, b, dest, a);
+    }
+
+    void e6500BitwiseDouble(FPRegisterID a, FPRegisterID b, FPRegisterID dest, bool isAnd)
+    {
+        auto temp = temps<Data, Memory>();
+        m_assembler.stfd(a, PPC64Registers::r1, e6500Slot0);
+        m_assembler.stfd(b, PPC64Registers::r1, e6500Slot1);
+        m_assembler.ld(temp.data(), PPC64Registers::r1, e6500Slot0);
+        m_assembler.ld(temp.memory(), PPC64Registers::r1, e6500Slot1);
+        if (isAnd)
+            m_assembler.and_(temp.data(), temp.data(), temp.memory());
+        else
+            m_assembler.or_(temp.data(), temp.data(), temp.memory());
+        e6500GPRToFPR(temp.data(), dest);
+    }
+
+    // Bitwise on the single-precision pattern, which is what a float's bits
+    // mean to the code asking for this.
+    void e6500BitwiseFloat(FPRegisterID a, FPRegisterID b, FPRegisterID dest, bool isAnd)
+    {
+        auto temp = temps<Data, Memory>();
+        m_assembler.stfs(a, PPC64Registers::r1, e6500Slot0);
+        m_assembler.stfs(b, PPC64Registers::r1, e6500Slot1);
+        m_assembler.lwz(temp.data(), PPC64Registers::r1, e6500Slot0);
+        m_assembler.lwz(temp.memory(), PPC64Registers::r1, e6500Slot1);
+        if (isAnd)
+            m_assembler.and_(temp.data(), temp.data(), temp.memory());
+        else
+            m_assembler.or_(temp.data(), temp.data(), temp.memory());
+        m_assembler.stw(temp.data(), PPC64Registers::r1, e6500Slot0);
+        m_assembler.lfs(dest, PPC64Registers::r1, e6500Slot0);
+    }
