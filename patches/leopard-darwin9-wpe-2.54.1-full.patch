+static void testPPC64AtomicStrongCAS64()
+{
+    uint64_t seen = 0;
+    auto cas = compilePPC64AtomicStrongCAS<64>(CCallHelpers::Success, &seen);
+
+    {
+        uint64_t data[] = { 0x1111111111111111ull, 0x4242424242424242ull, 0x3333333333333333ull };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), 0x4242424242424242ull, 0x9999999999999999ull), 1u);
+        CHECK_EQ(data[0], 0x1111111111111111ull);
+        CHECK_EQ(data[1], 0x9999999999999999ull);
+        CHECK_EQ(data[2], 0x3333333333333333ull);
+        CHECK_EQ(seen, 0x4242424242424242ull);
+    }
+    {
+        uint64_t data[] = { 0x1111111111111111ull, 0x4242424242424242ull, 0x3333333333333333ull };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), 0x4242424242424243ull, 0x9999999999999999ull), 0u);
+        CHECK_EQ(data[1], 0x4242424242424242ull);
+        CHECK_EQ(seen, 0x4242424242424242ull);
+    }
+    // cmpld compares the whole register, so a value differing only above
+    // bit 32 must not match.
+    {
+        uint64_t data[] = { 0x1111111111111111ull, 0x00000000deadbeefull, 0x3333333333333333ull };
+        seen = 0xccccccccccccccccull;
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), 0xffffffffdeadbeefull, 0x9999999999999999ull), 0u);
+        CHECK_EQ(data[1], 0x00000000deadbeefull);
+        CHECK_EQ(seen, 0x00000000deadbeefull);
+    }
