+        0, 1, static_cast<uint64_t>(-1), 0x7fffffff, 0x80000000, 0xffffffff, 0x100000000ULL,
+        (1ULL << 53) - 1, 1ULL << 53, (1ULL << 53) + 1, (1ULL << 53) + 3, (1ULL << 54) + 1,
+        0x7fffffffffffffffULL, 0x8000000000000000ULL, 0x8000000000000001ULL, 0xffffffffffffffffULL,
+        0xfffffffffffff800ULL, 0xfffffffffffffc00ULL, 0x7ffffffffffffc00ULL, 0x0020000000000001ULL,
+        static_cast<uint64_t>(-(1LL << 53)), static_cast<uint64_t>(-(1LL << 53) - 1),
+        static_cast<uint64_t>(-(1LL << 53) - 3), 16777217, 16777219, 0xffffff7fULL, 0xffffff80ULL,
