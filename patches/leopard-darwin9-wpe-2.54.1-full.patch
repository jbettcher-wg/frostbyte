+    // ---- the carry-propagating pairs, for 128-bit add and subtract ----
+    //
+    // wasm's i64.add128 / i64.sub128 need a two-instruction chain that carries
+    // a bit from the low half to the high half. POWER keeps that bit in
+    // XER[CA], which addc/adde/subfc/subfe all read or write, so THE TWO CALLS
+    // MUST STAY ADJACENT: anything emitted between them that touches CA
+    // destroys the result. BBQ emits them back to back and resolves the
+    // register aliasing that would otherwise need an intervening move before
+    // its architecture fork, which is what makes sharing ARM64's two-line
+    // sequence correct here.
+    //
+    // The borrow convention also matches ARM64's rather than needing an
+    // inversion: subfc/subfe compute rB + ~rA + CA, so CA is the COMPLEMENT of
+    // a borrow, exactly as ARM64's SUBS/SBCS treat it.
+    //
+    // subf-family operands are reversed (subf rt, ra, rb is rb - ra), the same
+    // way sub64 above passes them, so dest = a - b.
+    void add64AndSetFlags(RegisterID a, RegisterID b, RegisterID dest) { m_assembler.addc(dest, a, b); }
+    void addCarry64(RegisterID a, RegisterID b, RegisterID dest) { m_assembler.adde(dest, a, b); }
+    void sub64AndSetFlags(RegisterID a, RegisterID b, RegisterID dest) { m_assembler.subfc(dest, b, a); }
+    void subBorrow64(RegisterID a, RegisterID b, RegisterID dest) { m_assembler.subfe(dest, b, a); }
+
+    void sub64(TrustedImm32 imm, RegisterID dest) { addImmediate64(dest, -static_cast<int64_t>(imm.m_value), dest); }
+    void sub64(RegisterID src, TrustedImm32 imm, RegisterID dest) { addImmediate64(src, -static_cast<int64_t>(imm.m_value), dest); }
+
+    void sub64(TrustedImm64 imm, RegisterID dest) { sub64(dest, imm, dest); }
+
+    void sub64(RegisterID src, TrustedImm64 imm, RegisterID dest)
+    {
+        // -INT64_MIN is not representable, so that one value cannot be turned
+        // into an addition and goes through a register instead.
+        if (imm.m_value != std::numeric_limits<int64_t>::min()) {
+            addImmediate64(src, -imm.m_value, dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        m_assembler.loadImmediate64(temp.data(), imm.m_value);
+        m_assembler.subf(dest, temp.data(), src);
+    }
+    // ---- multiply / divide ----
+
+    void mul32(RegisterID src, RegisterID dest) { mul32(src, dest, dest); }
+
+    void mul32(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // mullw takes the low words of its operands and produces the low 32
+        // bits of the product, so the 32-bit invariant on the inputs is
+        // irrelevant here and only the result needs re-masking.
+        m_assembler.mullw(dest, a, b);
+        maskLow32(dest);
+    }
+
+    void mul32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        if (Assembler::isValidSigned16(imm.m_value)) {
+            m_assembler.mulli(dest, src, imm.m_value);
+            maskLow32(dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        mul32(temp.data(), src, dest);
+    }
+
+    // dest = minuend - mulLeft * mulRight
+    void multiplySub32(RegisterID mulLeft, RegisterID mulRight, RegisterID minuend, RegisterID dest)
+    {
+        auto temp = temps<Data>();
+        m_assembler.mullw(temp.data(), mulLeft, mulRight);
+        m_assembler.subf(dest, temp.data(), minuend);
+        maskLow32(dest);
+    }
+
+    // ---- integer division ----
+    //
+    // The POWER ISA leaves the divide instructions UNDEFINED for two inputs:
+    // a divisor of zero, and (for the signed forms) the most negative number
+    // divided by -1. ARM64 defines both -- sdiv/udiv return 0 for a zero
+    // divisor and INT_MIN for INT_MIN/-1 -- and JSC's shared code is written
+    // against the ARM64 guarantees, so these four reproduce them.
+    //
+    // What POWER9 actually returns, measured rather than assumed, by
+    // `divprobe.c` next to this port's notes `[MEASURED]`:
+    //
+    //     divd  INT64_MIN / -1 -> 0          ARM64: INT64_MIN
+    //     divw  INT32_MIN / -1 -> 0          ARM64: INT32_MIN
+    //     divd / divw / divdu / divwu  x / 0 -> 0    ARM64: 0
+    //
+    // So the zero-divisor case happens to agree on this machine and the
+    // INT_MIN case does not. Both are still architecturally undefined, and
+    // relying on a measured-but-undefined result is precisely the class of
+    // mistake this port keeps finding, so both are made explicit. None of
+    // this is on a path where three extra fixed-point instructions matter
+    // next to a divide.
+    //
+    // The INT_MIN/-1 correction is exact rather than a patch-up: x / -1 is
+    // -x for every x, INT_MIN included, because `neg` wraps INT_MIN to
+    // itself. So when the divisor is -1 the undefined quotient is simply
+    // discarded in favour of `neg dividend`. The selects are `isel`, so
+    // there is no branch, and the undefined divide is harmless to execute --
+    // PowerPC integer division never traps, it only leaves RT undefined (and
+    // sets OV, which nothing here reads).
+    //
+    // dest may alias either operand: it is written only by the final isel,
+    // after every read of dividend and divisor.
+
+    void div32(RegisterID dividend, RegisterID divisor, RegisterID dest)
+    {
+        // 32-bit signed divide done at 64 bits on sign-extended operands.
+        // -2^31 / -1 is then an ordinary 64-bit 2^31 whose low word is
+        // 0x80000000, bit for bit ARM64's answer, so the INT_MIN case needs
+        // no correction here -- only the zero divisor does. The operands must
+        // be sign-extended because this port keeps 32-bit values
+        // zero-extended (see the invariant above).
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), dividend);
+        m_assembler.extsw(temp.memory(), divisor);
+        m_assembler.divd(temp.data(), temp.data(), temp.memory());
+        m_assembler.li(temp.memory(), 0);
+        // cmpwi reads only the low word, which is the whole of a 32-bit
+        // divisor whichever way its upper half is extended.
+        emitSelect(emitCompare32(Equal, divisor, TrustedImm32(0)), temp.memory(), temp.data(), dest);
+        maskLow32(dest);
+    }
+
+    void div64(RegisterID dividend, RegisterID divisor, RegisterID dest)
+    {
+        // At 64 bits there is no wider type to escape into, so INT64_MIN / -1
+        // has to be answered directly. `neg` is that answer.
+        auto temp = temps<Data, Memory>();
+        m_assembler.divd(temp.data(), dividend, divisor);
+        m_assembler.neg(temp.memory(), dividend);
+        emitSelect(emitCompare64(Equal, divisor, static_cast<int64_t>(-1)), temp.memory(), temp.data(), temp.data());
+        m_assembler.li(temp.memory(), 0);
+        emitSelect(emitCompare64(Equal, divisor, static_cast<int64_t>(0)), temp.memory(), temp.data(), dest);
+    }
+
+    void uDiv32(RegisterID dividend, RegisterID divisor, RegisterID dest)
+    {
