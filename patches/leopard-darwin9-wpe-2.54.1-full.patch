+// The f32x4 lane model, asserted directly rather than inferred from the
+// scalar one: four packed singles in memory order. The scalar f32 position
+// (ISA word 1) is wasm LANE 2, and splat-then-extract must agree with that.
+void testPPC64VectorFloat32LaneModel()
+{
+    alignas(16) float in[4] = { 1.0f, 2.0f, 4.0f, 8.0f };
+    alignas(16) uint8_t out[16];
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        // Square each lane via div: 1/(1/x) is not exact, so use sqrt of x*x
+        // indirectly -- simply round-trip through trunc, which is exact here.
+        jit.vectorTrunc(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+        jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, &in[0], &out[0]);
+    // Memory order is lane order: lane i is at byte offset 4i, unchanged.
+    for (unsigned i = 0; i < 4; ++i) {
+        float got;
+        memcpy(&got, &out[i * 4], 4);
+        CHECK_EQ(got, in[i]);
+    }
+    // And the scalar position: extracting lane 2 must land the value where a
+    // scalar f32 lives, so a scalar op sees it.
+    auto test2 = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        jit.vectorExtractLane(SIMDLane::f32x4, CCallHelpers::TrustedImm32(2), FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+        jit.convertFloatToDouble(FPRInfo::argumentFPR1, FPRInfo::returnValueFPR);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    CHECK_EQ(invoke<double>(test2, &in[0]), 4.0);
+}
+
+// Group A: saturating conversions, min/max, pmin/pmax.
+//
+// Values are taken from jsc-ppc64-vector-conversions.md section 4: each one
+// separates two lowerings that agree everywhere else, and every lane differs
+// so a broadcast or wrong-lane bug cannot hide behind a uniform answer.
+static bool isNaNBits32(uint32_t b) { return ((b & 0x7f800000u) == 0x7f800000u) && (b & 0x007fffffu); }
+
+void testPPC64VectorTruncSat()
+{
+    const uint32_t qnan = 0x7fc00000, snan = 0x7f800001;
+    const uint32_t pinf = 0x7f800000, ninf = 0xff800000;
+    alignas(16) uint32_t out[4];
+
+    auto run = [&](const uint32_t (&in)[4], SIMDSignMode mode, const uint32_t (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorTruncSat(SIMDInfo { SIMDLane::f32x4, mode }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in[0], &out[0]);
+        for (unsigned i = 0; i < 4; ++i)
+            CHECK_EQ(out[i], expected[i]);
+    };
+
+    // NaN is the ONE row where the hardware and the spec differ on the signed
+    // form: xvcvspsxws gives INT_MIN, wasm wants 0. Both a quiet and a
+    // signalling NaN, because the mask must treat them alike.
+    const uint32_t nans[4]     = { qnan, snan, pinf, ninf };
+    const uint32_t nansS[4]    = { 0, 0, 0x7fffffff, 0x80000000 };
+    const uint32_t nansU[4]    = { 0, 0, 0xffffffff, 0 };
+    run(nans, SIMDSignMode::Signed, nansS);
+    run(nans, SIMDSignMode::Unsigned, nansU);
+
+    // 0x4f000000 is 2^31 exactly, the first value OUTSIDE signed range;
+    // 0x4effffff is 2147483520, the last one inside. An off-by-one in the
+    // clamp separates them and nothing else does.
+    const uint32_t edges[4]    = { 0x4f000000, 0x4effffff, 0x80000000 /*-0.0*/, 0xbfc00000 /*-1.5*/ };
+    const uint32_t edgesS[4]   = { 0x7fffffff, 2147483520u, 0, 0xffffffff /*-1*/ };
+    const uint32_t edgesU[4]   = { 2147483648u, 2147483520u, 0, 0 };
+    run(edges, SIMDSignMode::Signed, edgesS);
+    run(edges, SIMDSignMode::Unsigned, edgesU);
+}
+
+void testPPC64VectorConvertIntToFloat()
+{
+    alignas(16) uint32_t out[4];
+    auto run = [&](const uint32_t (&in)[4], SIMDSignMode mode, const float (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorConvert(SIMDInfo { SIMDLane::i32x4, mode }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in[0], &out[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got; memcpy(&got, &out[i], 4);
+            CHECK_EQ(got, expected[i]);
+        }
+    };
+    // -1 is the value that separates signed from unsigned: 0xffffffff is -1.0f
+    // read one way and 4294967296.0f read the other.
+    const uint32_t in[4] = { 1, 0xffffffff, 0x7fffffff, 0x80000000 };
+    const float sE[4] = { 1.0f, -1.0f, 2147483648.0f, -2147483648.0f };
+    const float uE[4] = { 1.0f, 4294967296.0f, 2147483648.0f, 2147483648.0f };
+    run(in, SIMDSignMode::Signed, sE);
+    run(in, SIMDSignMode::Unsigned, uE);
+}
+
+// NaN must be in the LEFT operand in one lane and the RIGHT in another: the
+// hardware returns the other operand in both cases, so a one-sided test would
+// pass a one-sided fix. The signed-zero pair is present in both orders because
+// the hardware is already right there and a compare-and-select "fix" would
+// break it.
+void testPPC64VectorMinMaxNaN()
+{
+    const uint32_t qnan = 0x7fc00000;
+    alignas(16) uint32_t a[4] = { qnan, 0x40000000 /*2.0*/, 0x00000000 /*+0*/, 0x80000000 /*-0*/ };
+    alignas(16) uint32_t b[4] = { 0x40000000, qnan, 0x80000000, 0x00000000 };
+    alignas(16) uint32_t out[4];
+
+    auto run = [&](bool isMin) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { SIMDLane::f32x4, SIMDSignMode::None };
+            if (isMin)
+                jit.vectorMin(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            else
+                jit.vectorMax(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        // Lanes 0 and 1: a NaN in either operand must give a NaN, not 2.0.
+        CHECK_EQ(isNaNBits32(out[0]), true);
+        CHECK_EQ(isNaNBits32(out[1]), true);
+        // Lanes 2 and 3: signed zeros, both orders. min -> -0, max -> +0.
+        CHECK_EQ(out[2], isMin ? 0x80000000u : 0x00000000u);
+        CHECK_EQ(out[3], isMin ? 0x80000000u : 0x00000000u);
+    };
+    run(true); run(false);
+
+    // Ordinary distinct values, so a lowering that returns a constant or the
+    // wrong operand is caught rather than merely the NaN handling.
+    alignas(16) float p[4] = { 1.0f, -2.0f, 3.5f, -4.25f };
+    alignas(16) float q[4] = { -1.0f, 2.0f, -3.5f, 4.25f };
+    auto runOrdinary = [&](bool isMin, const float (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { SIMDLane::f32x4, SIMDSignMode::None };
+            if (isMin)
+                jit.vectorMin(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            else
+                jit.vectorMax(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &p[0], &out[0], &q[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got; memcpy(&got, &out[i], 4);
+            CHECK_EQ(got, expected[i]);
+        }
+    };
+    const float minE[4] = { -1.0f, -2.0f, -3.5f, -4.25f };
+    const float maxE[4] = {  1.0f,  2.0f,  3.5f,  4.25f };
+    runOrdinary(true, minE); runOrdinary(false, maxE);
+}
+
+// pmin/pmax are `b < a ? b : a` with NO NaN case, so they must NOT agree with
+// min/max on a NaN lane -- that difference is the whole point of their
+// existence and a lowering that shares min's code would pass every other test.
+void testPPC64VectorPminPmax()
+{
+    alignas(16) float p[4] = { 1.0f, -2.0f, 3.5f, -4.25f };
+    alignas(16) float q[4] = { -1.0f, 2.0f, -3.5f, 4.25f };
+    alignas(16) uint32_t out[4];
+
+    auto run = [&](bool isPmin, const float (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { SIMDLane::f32x4, SIMDSignMode::None };
+            if (isPmin)
+                jit.vectorPmin(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2, FPRInfo::argumentFPR3);
+            else
+                jit.vectorPmax(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2, FPRInfo::argumentFPR3);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &p[0], &out[0], &q[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got; memcpy(&got, &out[i], 4);
+            CHECK_EQ(got, expected[i]);
+        }
+    };
+    const float pminE[4] = { -1.0f, -2.0f, -3.5f, -4.25f };
+    const float pmaxE[4] = {  1.0f,  2.0f,  3.5f,  4.25f };
+    run(true, pminE); run(false, pmaxE);
+
+    // The NaN divergence from min/max, asserted directly: with a NaN in the
+    // right operand, `b < a` is false, so pmin returns a -- NOT a NaN.
+    const uint32_t qnan = 0x7fc00000;
+    alignas(16) uint32_t a[4] = { 0x40000000, 0x40000000, 0x40000000, 0x40000000 };
+    alignas(16) uint32_t b[4] = { qnan, qnan, qnan, qnan };
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+        jit.vectorPmin(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None },
+            FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2, FPRInfo::argumentFPR3);
+        jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, &a[0], &out[0], &b[0]);
+    for (unsigned i = 0; i < 4; ++i)
+        CHECK_EQ(out[i], 0x40000000u);   // 2.0, not NaN: pmin is not min
+}
+
+// Group 5: vector arithmetic, integer and float arms together.
+//
+// Operands differ in every lane, so a cross-lane mix-up changes a value
+// rather than preserving it -- equal lanes make every lane-order bug
+// invisible. Expected values are computed in C with the same wrapping
+// semantics, which shares no code with the JIT path.
+template<typename T, typename Op>
+static void ppc64CheckIntLanes(SIMDLane lane, const uint8_t* aBytes, const uint8_t* bBytes,
+    const uint8_t* got, Op op)
+{
+    constexpr unsigned lanes = 16 / sizeof(T);
+    for (unsigned i = 0; i < lanes; ++i) {
+        T x, y, g;
+        memcpy(&x, aBytes + i * sizeof(T), sizeof(T));
+        memcpy(&y, bBytes + i * sizeof(T), sizeof(T));
+        memcpy(&g, got + i * sizeof(T), sizeof(T));
+        CHECK_EQ(g, static_cast<T>(op(x, y)));
+    }
+    UNUSED_PARAM(lane);
+}
+
+void testPPC64VectorIntAddSub()
+{
+    alignas(16) uint8_t a[16], b[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        a[i] = static_cast<uint8_t>(0x80 + i * 7);   // crosses the sign boundary
+        b[i] = static_cast<uint8_t>(0x03 + i * 11);  // and forces carries between lanes
+    }
+
+    auto run = [&](SIMDLane lane, bool isAdd) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { lane, SIMDSignMode::None };
+            if (isAdd)
+                jit.vectorAdd(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            else
+                jit.vectorSub(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        // Wrapping is the wasm semantic: a carry must NOT reach the next lane.
+        auto add = [](auto x, auto y) { return x + y; };
+        auto sub = [](auto x, auto y) { return x - y; };
+        switch (lane) {
+        case SIMDLane::i8x16:
+            if (isAdd) ppc64CheckIntLanes<uint8_t>(lane, a, b, out, add);
+            else ppc64CheckIntLanes<uint8_t>(lane, a, b, out, sub);
+            break;
+        case SIMDLane::i16x8:
+            if (isAdd) ppc64CheckIntLanes<uint16_t>(lane, a, b, out, add);
+            else ppc64CheckIntLanes<uint16_t>(lane, a, b, out, sub);
+            break;
+        case SIMDLane::i32x4:
+            if (isAdd) ppc64CheckIntLanes<uint32_t>(lane, a, b, out, add);
+            else ppc64CheckIntLanes<uint32_t>(lane, a, b, out, sub);
+            break;
+        default:
+            if (isAdd) ppc64CheckIntLanes<uint64_t>(lane, a, b, out, add);
+            else ppc64CheckIntLanes<uint64_t>(lane, a, b, out, sub);
+            break;
+        }
+    };
+    for (auto lane : { SIMDLane::i8x16, SIMDLane::i16x8, SIMDLane::i32x4, SIMDLane::i64x2 }) {
+        run(lane, true);
+        run(lane, false);
+    }
+}
+
+void testPPC64VectorIntMul()
+{
+    alignas(16) uint8_t a[16], b[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        a[i] = static_cast<uint8_t>(0x31 + i * 5);
+        b[i] = static_cast<uint8_t>(0x07 + i * 13);
+    }
+    auto run = [&](SIMDLane lane) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.vectorMul(SIMDInfo { lane, SIMDSignMode::None },
+                FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        auto mul = [](auto x, auto y) { return x * y; };
+        if (lane == SIMDLane::i16x8)
+            ppc64CheckIntLanes<uint16_t>(lane, a, b, out, mul);
+        else
+            ppc64CheckIntLanes<uint32_t>(lane, a, b, out, mul);
+    };
+    run(SIMDLane::i16x8);   // vmladduhm with a zero addend
+    run(SIMDLane::i32x4);   // vmuluwm
+}
+
+// neg and abs, with the value that separates a correct wrapping lowering from
+// a plausible one: the most negative lane. wasm says abs(INT_MIN) is INT_MIN.
+void testPPC64VectorIntNegAbs()
+{
+    alignas(16) uint8_t in[16], out[16];
+    auto run = [&](SIMDLane lane, bool isNeg) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            SIMDInfo info { lane, SIMDSignMode::None };
+            if (isNeg)
+                jit.vectorNeg(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            else
+                jit.vectorAbs(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in[0], &out[0]);
+    };
+
+    // i8x16: lane 0 is 0x80 (INT8_MIN), the rest are distinct.
+    for (unsigned i = 0; i < 16; ++i)
+        in[i] = i ? static_cast<uint8_t>(0x10 + i * 9) : 0x80;
+    run(SIMDLane::i8x16, true);
+    for (unsigned i = 0; i < 16; ++i)
+        CHECK_EQ(out[i], static_cast<uint8_t>(0u - in[i]));
+    run(SIMDLane::i8x16, false);
+    for (unsigned i = 0; i < 16; ++i) {
+        int8_t v = static_cast<int8_t>(in[i]);
+        uint8_t expected = v < 0 ? static_cast<uint8_t>(0u - in[i]) : in[i];
+        CHECK_EQ(out[i], expected);   // abs(-128) == -128, by wrapping
+    }
+
+    // i32x4: same shape one lane wider, with INT32_MIN in lane 0.
+    alignas(16) uint32_t w[4] = { 0x80000000u, 0x00001234u, 0xfffffff0u, 0x7fffffffu };
+    memcpy(in, w, 16);
+    run(SIMDLane::i32x4, true);
+    for (unsigned i = 0; i < 4; ++i) {
+        uint32_t g; memcpy(&g, out + i * 4, 4);
+        CHECK_EQ(g, static_cast<uint32_t>(0u - w[i]));
+    }
+    run(SIMDLane::i32x4, false);
+    for (unsigned i = 0; i < 4; ++i) {
+        uint32_t g; memcpy(&g, out + i * 4, 4);
+        uint32_t expected = static_cast<int32_t>(w[i]) < 0 ? static_cast<uint32_t>(0u - w[i]) : w[i];
+        CHECK_EQ(g, expected);
+    }
+}
